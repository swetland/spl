compile () {
	local src="$1"
	local bin="$2"
	local asm="${bin%.bin}.s32"
	local ast="${bin%.bin}.ast"
	local xir="${bin%.bin}.xir"

	rm -f ${bin} ${asm} ${ast}
	out/emu out/compiler3a.bin -ir0 -ir1 -ast ${ast} -out ${bin} -xir ${xir} build/testlib.spl ${src} >/dev/null || return 1;
	#out/asm -o ${bin} build/testlib-abi0.s32 ${asm} || return 1;
	return 0
}

run () {
	local bin="$1"
	local xir="${bin%.bin}.xir"
	if [ -f "$2" ]; then
		out/iremu -check "${xir}" <$2 || return 1;
	else
		out/iremu "${xir}" || return 1;
	fi
	return 0
}

. build/runtest
