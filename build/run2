#!/bin/bash -e

if [ "$#" -ne 1 ]; then
	echo "ERROR: usage: $0 file.spl"
	exit 1
fi

src=$1
base=${src%.spl}
base=${base##*/}
out=out/run2/${base}

srcdir=$(dirname $src)
mapfile -t libs < <(cat ${src} | grep '//:lib:.*spl')
len=${#libs[@]}
for ((i = 0; i < len; i++)); do
	spllib[i]=${srcdir}/${libs[i]##*:}
done
mapfile -t libs < <(cat ${src} | grep '//:lib:.*s32')
len=${#libs[@]}
for ((i = 0; i < len; i++)); do
	asmlib[i]=${srcdir}/${libs[i]##*:}
done

stdspllib=(build/stdlib-abi0.spl compiler/stdlib.spl compiler/io.spl)
stdasmlib=(build/stdlib-abi0.s32 build/syscall-abi0.s32)

rm -f ${out}.ast ${out}.s32 ${out}.bin
mkdir -p out/run2
out/emu -hgp -q out/compiler2a.bin -ast ${out}.ast -out ${out}.s32 ${stdspllib[*]} ${spllib[*]} ${src}
out/asm -o ${out}.bin ${stdasmlib[*]} ${asmlib[*]} ${out}.s32
out/emu -hgp -q ${out}.bin

