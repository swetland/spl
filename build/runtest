if [ "$#" -ne 2 ]; then
	echo 'ERROR: usage: runtest <source> <result>'
	exit 1
fi

src="$1"
txt="$2"
base="${txt%.txt}"
bin="${txt%.txt}.bin"
lst="${txt%.txt}.lst"
log="${txt%.txt}.log"
msg="${txt%.txt}.msg"
chk="${src%.spl}.chk"
gold="${src%.spl}.log"

RED='\033[0;7;31m'
GRN='\033[0;32m'
OFF='\033[0m'
PASS=${GRN}PASS${OFF}
FAIL=${RED}FAIL${OFF}

#echo "TEST: $src: compiling..."
if compile "$src" "$bin" 2> "$msg"; then
	# success!
	if [[ "$txt" == *"-err"* ]]; then
		# but this was an error test, so...
		echo -e "${FAIL}: $src: compiler did not detect error"
		echo "FAIL: $src" > "$txt"
	else
		#echo "TEST: $src: running..."
		if run "$bin" "$chk" > "$log"; then
			if diff "$log" "$gold" >/dev/null ; then
				echo -e "${PASS}: $src"
				echo "PASS: $src" > "$txt"
			else
				echo -e "${FAIL}: $src: output differs from expected"
				diff "$log" "$gold" | head
				echo "FAIL: $src" > "$txt"
			fi
		else
			echo -e "${FAIL}: $src: emulator crashed"
			echo "FAIL: $src" > "$txt"
		fi
	fi
else
	# failure
	if [[ $? > 127 ]]; then
		echo -e "${FAIL}: $src: compiler crashed"
		echo "FAIL: $src" > "$txt"
		cat "$msg" | grep -v '^$'
	elif [[ "$txt" == *"-err"* ]]; then
		# but this was an error test, so...
		echo -e "${PASS}: $src"
		echo "PASS: $src" > "$txt"
	else
		echo -e "${FAIL}: $src: compiler error"
		echo "FAIL: $src" > "$txt"
		cat "$msg" | grep -v '^$'
	fi
fi

