compile () {
	local src="$1"
	local bin="$2"
	local asm="${bin%.bin}.s32"
	local ast="${bin%.bin}.ast"

	rm -f ${bin} ${asm} ${ast}
	out/compiler1 -ast ${ast} -out ${asm} build/stdlib-abi0.spl ${src} >/dev/null || return 1;
	out/asm -o ${bin} build/stdlib-abi0.s32 ${asm} || return 1;
	return 0
}

run () {
	out/emu "$1" || return 1;
	return 0
}

. build/runtest
