enum SoftRisc32 {
	VF_PHYS  =   0x10000000,
	VF_UNDEF =   0x20000000,
	VF_INVAL =   0x40000000,
	VF_MASK =    0x0FFFFFFF,

	REG_ERROR =  0x11111111,
	REG_ZERO =   0x10000000,
	REG_RA =     0x10000001,
	REG_SP =     0x10000002,
	REG_GP =     0x10000003,
	REG_TP =     0x10000004,
	REG_RV =     0x10000005,
	REG_RW =     0x10000006,
	REG_FP =     0x10000007,
	REG_COUNT =  32,
	REG_VIRT_0 = 0,
};

var reg_names []str = {
	"zero", "ra", "sp", "gp", "tp", "rv", "rw", "fp",
	"x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15",
	"x16", "x17", "x18", "x19", "x20", "x21", "x22", "x23",
	"x24", "x25", "x26", "x27", "x28", "x29", "x30", "x31",
};

