enum IRflag {
	// arg c is immediate, for ALU and CMP ops
	INF_C_IMM =     0x0100,

	// size flags for LD/ST ops
	INF_SZ_U8 =     0x0000,
	INF_SZ_U16 =    0x0040,
	INF_SZ_U32 =    0x0080,
	INF_SZ_MASK =   0x00C0,
	INF_SZ_SHIFT =  6,

	// property bits
	INF_IS_B_U =    0x0200, // is unconditional branch
	INF_IS_B_C =    0x0400, // is conditional branch
	INF_IS_B =      0x0600, // is any kind of branch
	INF_IS_RET =    0x0800, // is a return op
	INF_IS_EOBB =   0x0E00, // is an end of a bb (a branch or return)
	INF_IS_LABEL =  0x1000, // is a label (start of a bb)
	INF_IS_ALU =    0x2000, // is an ALU op
	INF_IS_MEM =    0x4000, // load or store
	INF_IS_PHI =    0x8000,
};

enum IRop {
	// binary ALU ops
	INS_ADD,     // ADD Ra, Rb, Rc       Ra = Rb + Rc
	INS_SUB,     // SUBI Ra, Rb, IMMc    Ra = Rb - IMMc
	INS_MUL,
	INS_UDIV,
	INS_SDIV,
	INS_UREM,
	INS_SREM,

	INS_LSL,
	INS_LSR,
	INS_ASR,
	INS_AND,
	INS_OR,
	INS_XOR,

	INS_CMP_EQ,  // CEQ Ra, Rb, RC      Ra = (Rb == Rc) ? 0 : ~0
	INS_CMP_NE,
	INS_CMP_LT,
	INS_CMP_LE,
	INS_CMP_GT,
	INS_CMP_GE,

	// unary ALU ops
	INS_NOT,
	INS_NEG,

	INS_MOV,     // MOV Ra, Rc           Ra = Rc

	INS_LOAD,    // LDW Ra, Rb, Rc       Ra = MEM[Rb + Rc]
	INS_STORE,   // STBI Ra, Rb, IMMc    MEM[Rb + IMMc] = Ra

	INS_PHI,     // PHI Ta, Rb, Rc

	INS_LABEL,   // La: b=Placed c=EdgeCount

	INS_JUMP,    // JUMP La
	INS_BRANCH,  // BRANCH Ca, Lb, Lc    if Ca != 0 then ->Lb else ->Lc
	INS_CALL,    // CALL La
	INS_RET,     // RET Ra

	INS_COUNT, // total unique opcodes (30)

	INS_OP_MASK = 0x3f,
};

var iop_name [INS_COUNT]str = {
	"add", "sub", "mul", "udiv", "sdiv",
	"urem", "srem", "lsl", "lsr", "asr",
	"and", "or", "xor",
	"cmpeq", "cmpne", "cmplt", "cmple", "cmpgt", "cmpge",
	"not", "neg",
	"mv", "ld", "st",
	"phi", "label", "jump", "branch", "call", "ret",
};

var iop_props [INS_COUNT]u32 = {
	INF_IS_ALU, INF_IS_ALU, INF_IS_ALU, INF_IS_ALU, INF_IS_ALU,
	INF_IS_ALU, INF_IS_ALU, INF_IS_ALU, INF_IS_ALU, INF_IS_ALU,
	INF_IS_ALU, INF_IS_ALU, INF_IS_ALU,
	INF_IS_ALU, INF_IS_ALU, INF_IS_ALU, INF_IS_ALU, INF_IS_ALU, INF_IS_ALU,
	INF_IS_ALU, INF_IS_ALU,
	0, INF_IS_MEM, INF_IS_MEM,
	INF_IS_PHI, INF_IS_LABEL, INF_IS_B_U, INF_IS_B_C, 0, INF_IS_RET,
};

var isz_name [4]str = { "b", "h", "w", "d" };

struct Inst {
	next *Inst,
	prev *Inst,
	op u32,
	a i32,
	b i32,
	c i32,
};

var reg_next i32 = REG_VIRT_0;

fn reg_get() i32 {
	var r i32 = reg_next;
	reg_next++;
	return r;
}

struct Phi {
	next *Phi,
	sym *Symbol,

};

struct BlockList {
	next *BlockList,
	bb *BasicBlock,
};

enum BBFlags {
	// Filled blocks contain all their instructions
	// Filled blocks may provide defs for successors
	// Successors may only be added to Filled blocks
	BB_FILLED = 0x001,

	// Sealed blocks will have no additional successors added
	// Sealed blocks may look up defs in predecessors since
	// they are all known (they must be Filled blocks).
	BB_SEALED = 0x002,

	// no path into this block
	// it is SEALED and has no predecessors
	BB_DEAD =   0x004,

	// first and last blocks in a function
	BB_ENTRY =  0x010,
	BB_EXIT =   0x020,

	// general purpose flag
	BB_MARK =   0x800,

};

struct BasicBlock {
	first *Inst,
	last *Inst,
	phy *Phi,
	flags u32,
	// List of predecessor blocks
	prev *BlockList,
	// up to two succesor blocks
	next0 *BasicBlock,
	next1 *BasicBlock,
	id u32,
	//pcount u32,
	tag str,
};

var bb_next_id i32 = 0;
var bb_idx [1024]*BasicBlock;

// target for new instructions
var bb_active BasicBlock = nil;

// reset all global state
// used at the start of a new function
fn bb_reset() {
	reg_next = REG_VIRT_0;
	bb_next_id = 0;
	bb_active = nil;
}

fn bb_make(tag str) BasicBlock {
	var bb BasicBlock = new(BasicBlock);
	bb.id = bb_next_id;
	bb.tag = tag;
	bb_next_id++;
	bb_idx[bb.id] = bb;
	Warn("make bb.@: @").n(bb.id).s(tag);
	return bb;
}

fn (os OutStream) ins(i Inst) OutStream;

fn (bb BasicBlock) link_to(target BasicBlock) {
	if target.flags & BB_SEALED {
		Warn("cannot link bb.@ to sealed bb.@").n(bb.id).n(target.id);
	}
	if bb.next0 == nil {
		bb.next0 = target;
	} else {
		bb.next1 = target;
	}
	var bl BlockList = new(BlockList);
	bl.bb = bb;
	bl.next = target.prev;
	target.prev = bl;
}

fn (bb BasicBlock) append(ins Inst) {
	if bb.flags & BB_FILLED {
		//Warn("cannot add instructions to filled bb.@").n(bb.id);
		//Warn("discarding: @").ins(ins);
		return;
	}
	if bb.last == nil {
		ins.prev = nil;
		bb.first = ins;
	} else {
		ins.prev = bb.last;
		bb.last.next = ins;
	}
	bb.last = ins;
	ins.next = nil;
	if ins.op & INF_IS_EOBB {
		bb.flags |= BB_FILLED;
		if ins.op & INF_IS_B_U {
			bb.link_to(bb_idx[ins.a]);
		}
		if ins.op & INF_IS_B_C {
			bb.link_to(bb_idx[ins.b]);
			bb.link_to(bb_idx[ins.c]);
		}
	}
}

fn inst_jump(bb BasicBlock);

fn (bb BasicBlock) seal() {
	if bb.flags & BB_SEALED {
		Error("bb.@ sealed twice").n(bb.id);
	}
	bb.flags |= BB_SEALED;
	if bb.prev == nil {
		if !(bb.flags & BB_ENTRY) {
			bb.flags |= BB_DEAD;
			Warn("bb.@ is dead").n(bb.id);
		}
	}
}

// terminate the current bb with a jump to this
// one and make it active for accumulating instructions
fn (bb BasicBlock) _activate(seal_prev bool) {
	if bb_active != nil {
		if !(bb_active.flags & BB_FILLED) {
			if !(bb_active.flags & BB_DEAD) {
				inst_jump(bb);
				Warn("bb.@ chained to bb.@").n(bb_active.id).n(bb.id);
			}
		}
		if seal_prev {
			if !(bb_active.flags & BB_SEALED) {
				bb_active.seal();
			}
		}
	}
	bb_active = bb;
	// housekeeping
}

fn (bb BasicBlock) activate() {
	bb._activate(false);
}

fn (bb BasicBlock) activate_and_seal_prev() {
	bb._activate(true);
}

var global_next i32 = 1;
var global_names [1024]*String;

// obtain a global identifier for call instruction use
fn get_global_id(name String) i32 {
	var n i32 = 0;
	while n < global_next {
		if global_names[n] == name {
			return n;
		}
		n++;
	}
	global_next = n + 1;
	global_names[n] = name;
	return n;
}

var label_next i32 = 0;
var label_idx [1024]*Inst;

fn _inst_make(op u32, a i32, b i32, c i32) Inst {
	// add opcode-specific property bitflags to allow
	// for quick property testing
	op |= iop_props[op & INS_OP_MASK];

	var ins Inst = new(Inst);
	ins.next = nil;
	ins.prev = nil;
	ins.op = op;
	ins.a = a;
	ins.b = b;
	ins.c = c;
	return ins;
}

// allocate an instruction and add it to the graph
fn inst_make(op u32, a i32, b i32, c i32) i32 {
	var ins Inst = _inst_make(op, a, b, c);
	bb_active.append(ins);
	return a;
}

fn inst_target_bb(bb BasicBlock) i32 {
	// do other housekeeping
	return bb.id;
}

// declare a function entrypoint
fn inst_label_global(name String) i32 {
	return inst_make(INS_LABEL, get_global_id(name), 1, 0);
}

// ALU instructions
// Default variant allocates a register for the target
// and returns that register.
// X variant is passed the target register and uses that.
// I variant treats second argument as an immediate
fn inst_alu(op u32, b i32, c i32) i32 {
	if op >= INS_MOV { Error("inst_alu invalid alu op"); }
	return inst_make(op, reg_get(), b, c);
}
fn inst_alui(op u32, b i32, imm i32) i32 {
	if op >= INS_MOV { Error("inst_alui invalid alu op"); }
	return inst_make(op | INF_C_IMM, reg_get(), b, imm);
}
fn inst_aluix(op u32, a i32, b i32, imm i32) {
	if op >= INS_MOV { Error("inst_alui invalid alu op"); }
	inst_make(op | INF_C_IMM, a, b, imm);
}
fn inst_movi(imm i32) i32 {
	return inst_make(INS_MOV | INF_C_IMM, reg_get(), 0, imm);
}
fn inst_mov(c i32) i32 {
	return inst_make(INS_MOV, reg_get(), 0, c);
}
fn inst_movx(a i32, c i32) i32 {
	return inst_make(INS_MOV, a, 0, c);
}

// load/store instructions
// Load instructions allocate and return a target register.
fn inst_ldb(b i32, c i32) i32 {
	return inst_make(INS_LOAD | INF_SZ_U8, reg_get(), b, c);
}
fn inst_ldw(b i32, c i32) i32 {
	return inst_make(INS_LOAD | INF_SZ_U32, reg_get(), b, c);
}
fn inst_ldbi(b i32, imm i32) i32 {
	return inst_make(INS_LOAD | INF_SZ_U8 | INF_C_IMM, reg_get(), b, imm);
}
fn inst_ldwi(b i32, imm i32) i32 {
	return inst_make(INS_LOAD | INF_SZ_U32 | INF_C_IMM, reg_get(), b, imm);
}
fn inst_ldwix(a i32, b i32, imm i32) {
	inst_make(INS_LOAD | INF_SZ_U32 | INF_C_IMM, a, b, imm);
}
fn inst_stb(a i32, b i32, c i32) {
	inst_make(INS_STORE | INF_SZ_U8, a, b, c);
}
fn inst_stw(a i32, b i32, c i32) {
	inst_make(INS_STORE | INF_SZ_U32, a, b, c);
}
fn inst_stbi(a i32, b i32, imm i32) {
	inst_make(INS_STORE | INF_SZ_U8 | INF_C_IMM, a, b, imm);
}
fn inst_stwi(a i32, b i32, imm i32) {
	inst_make(INS_STORE | INF_SZ_U32 | INF_C_IMM, a, b, imm);
}

// flow control
fn inst_jump(bb BasicBlock) {
	inst_make(INS_JUMP, inst_target_bb(bb), 0, 0);
}
fn inst_branch(cond i32, ttrue BasicBlock, tfalse BasicBlock) {
	inst_make(INS_BRANCH, cond, inst_target_bb(ttrue), inst_target_bb(tfalse));
}
fn inst_call(name String) {
	inst_make(INS_CALL, get_global_id(name), 0, 0);
}
fn inst_ret(a i32) {
	inst_make(INS_RET, a, 0, 0);
}

// predicates
fn inst_is_label(ins Inst) bool {
	return ins.op & INF_IS_LABEL;
}
fn inst_is_uncond_branch(ins Inst) bool {
	return ins.op & INF_IS_B_U;
}
fn inst_is_cond_branch(ins Inst) bool {
	return ins.op & INF_IS_B_C;
}
fn inst_is_branch(ins Inst) bool {
	return ins.op & INF_IS_B;
}
fn inst_is_return(ins Inst) bool {
	return ins.op & INF_IS_RET;
}


// helpers for printing instructions
fn (os OutStream) reg(id i32) OutStream {
	var n i32 = id & VF_MASK;
	if id & VF_PHYS {
		if n >= REG_COUNT {
			writes(os.fd, "$BOGUS");
		} else {
			writec(os.fd, '$');
			writes(os.fd, reg_names[n]);
		}
	} else if id & VF_UNDEF {
		writes(os.fd, "$UNDEF");
	} else if id & VF_INVAL {
		writes(os.fd, "$ERROR");
	} else {
		// virtual register
		writec(os.fd, '%');
		writei(os.fd, n);
	}
	os_advance(os);
	return os;
}

fn (os OutStream) arg(n i32, op i32) OutStream {
	if op & INF_C_IMM {
		writei(os.fd, n);
	} else {
		return os.reg(n);
	}
	os_advance(os);
	return os;
}

fn (os OutStream) label(n i32) OutStream {
	writes(os.fd, "bb.");
	writei(os.fd, n);
	os_advance(os);
	return os;
}

fn inst_disasm(os OutStream, ins Inst) {
	var op u32 = ins.op & INS_OP_MASK;

	if op == INS_NOT {
		os.fmt("    not @, @").reg(ins.a).reg(ins.b);
	} else if op == INS_NEG {
		os.fmt("    neg @, @").reg(ins.a).reg(ins.b);
	} else if op < INS_MOV {
		// ALU and CMP instructions
		os.fmt("    @ @, @, @").s(iop_name[op]).reg(ins.a).reg(ins.b).arg(ins.c,ins.op);
	} else if op == INS_MOV {
		os.fmt("    mov @, @").reg(ins.a).arg(ins.c,ins.op);
	} else if (op == INS_LOAD) | (op == INS_STORE) {
		var sz str = isz_name[(ins.op & INF_SZ_MASK) >> INF_SZ_SHIFT];
		os.fmt("    @@ @, [@, @]").s(iop_name[op]).s(sz).reg(ins.a).reg(ins.b).arg(ins.c,ins.op);
	} else if op <= INS_PHI {
		os.fmt("    phi @, @, @").reg(ins.a).reg(ins.b).reg(ins.c);
	} else if op == INS_LABEL {
		os.fmt("    func @").s(global_names[ins.a]);
	} else if op == INS_JUMP {
		os.fmt("    jump @").label(ins.a);
	} else if op == INS_BRANCH {
		os.fmt("    @ @, @, @").s(iop_name[op]).reg(ins.a).label(ins.b).label(ins.c);
	} else if op == INS_CALL {
		os.fmt("    call @").s(global_names[ins.a]);
	} else if op == INS_RET {
		os.fmt("    ret @").reg(ins.a);
	} else {
		os.fmt("    inval 0x@").x(ins.op);
	}
}

fn (os OutStream) ins(i Inst) OutStream {
	inst_disasm(os, i);
	return os;
}

