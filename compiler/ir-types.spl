enum IRtag {
	TAG_IR_XIR0 = 0x00524958, // XIR0
	TAG_IR_FUNC = 0x434e5546, // FUNC <count> <id> <maxvr> Inst * count
	TAG_IR_DATA = 0x41544144, // DATA <count> Word * count
	TAG_IR_GLBL = 0x4c424c47, // GLBL <count> <len> * count stringdata
};

enum IRflag {
	// arg c is immediate, for ALU and CMP ops
	INF_C_IMM =     0x0100,

	// size flags for LD/ST ops
	INF_SZ_U8 =     0x0000,
	INF_SZ_U16 =    0x0040,
	INF_SZ_U32 =    0x0080,
	INF_SZ_MASK =   0x00C0,
	INF_SZ_SHIFT =  6,

	// property bits
	INF_IS_B_U =    0x0200, // is unconditional branch
	INF_IS_B_C =    0x0400, // is conditional branch
	INF_IS_B =      0x0600, // is any kind of branch
	INF_IS_RET =    0x0800, // is a return op
	INF_IS_EOBB =   0x0E00, // is an end of a bb (a branch or return)
	INF_IS_LABEL =  0x1000, // is a label (start of a bb)
	INF_IS_ALU =    0x2000, // is an ALU op
	INF_IS_MEM =    0x4000, // load or store
};

enum IRop {
	// binary ALU ops
	INS_ADD,     // ADD Ra, Rb, Rc       Ra = Rb + Rc
	INS_SUB,     // SUBI Ra, Rb, IMMc    Ra = Rb - IMMc
	INS_MUL,
	INS_UDIV,
	INS_SDIV,
	INS_UREM,
	INS_SREM,

	INS_LSL,
	INS_LSR,
	INS_ASR,
	INS_AND,
	INS_OR,
	INS_XOR,

	INS_CMP_EQ,  // CEQ Ra, Rb, RC      Ra = (Rb == Rc) ? 0 : ~0
	INS_CMP_NE,
	INS_CMP_LT,
	INS_CMP_LE,
	INS_CMP_GT,
	INS_CMP_GE,

	// unary ALU ops
	INS_NOT,     // NOT Ra, Rc           Ra = ~Rc
	INS_NEG,     // NEG Ra, Rc           Ra = -Rc

	INS_MOV,     // MOV Ra, Rc           Ra = Rc

	INS_LOAD,    // LDW Ra, Rb, Rc       Ra = MEM[Rb + Rc]
	INS_STORE,   // STBI Ra, Rb, IMMc    MEM[Rb + IMMc] = Ra

	INS_LABEL,   // LABEL BBa (, Gb)

	INS_JUMP,    // JUMP La
	INS_BRANCH,  // BRANCH Ca, Lb, Lc    if Ca != 0 then ->Lb else ->Lc
	INS_CALL,    // CALL La
	INS_RET,     // RET Ra

	INS_SET,     // SET Sa, Rb  (aka upsilon)
	INS_GET,     // GET Ra, Sb  (aka phi)

	INS_COUNT,   // total unique opcodes (31)

	INS_OP_MASK = 0x3f,
};

var iop_name [INS_COUNT]str = {
	"add", "sub", "mul", "udiv", "sdiv",
	"urem", "srem", "lsl", "lsr", "asr",
	"and", "or", "xor",
	"cmpeq", "cmpne", "cmplt", "cmple", "cmpgt", "cmpge",
	"not", "neg",
	"mv", "ld", "st",
	"label", "jump", "branch", "call", "ret",
	"set", "get",
};

var iop_props [INS_COUNT]u32 = {
	INF_IS_ALU, INF_IS_ALU, INF_IS_ALU, INF_IS_ALU, INF_IS_ALU,
	INF_IS_ALU, INF_IS_ALU, INF_IS_ALU, INF_IS_ALU, INF_IS_ALU,
	INF_IS_ALU, INF_IS_ALU, INF_IS_ALU,
	INF_IS_ALU, INF_IS_ALU, INF_IS_ALU, INF_IS_ALU, INF_IS_ALU, INF_IS_ALU,
	INF_IS_ALU, INF_IS_ALU,
	0, INF_IS_MEM, INF_IS_MEM,
	INF_IS_LABEL, INF_IS_B_U, INF_IS_B_C, 0, INF_IS_RET,
	0, 0,
};

var isz_name [4]str = { "b", "h", "w", "d" };

struct Inst {
	next *Inst,
	prev *Inst,
	op u32,
	a i32,
	b i32,
	c i32,
};

var reg_next i32 = REG_VIRT_0;

fn reg_get() i32 {
	var r i32 = reg_next;
	reg_next++;
	return r;
}

struct Phi {
	next *Phi,
	sym *Symbol,
	// initial vid
	vini i32,
	// most recent vid
	vcur i32,
	// vids from predecessor blocks
	args []i32,
	count i32,
};

struct BlockList {
	next *BlockList,
	bb *BasicBlock,
};

enum BBFlags {
	// Filled blocks contain all their instructions
	// Filled blocks may provide defs for successors
	// Successors may only be added to Filled blocks
	BB_FILLED = 0x001,

	// Sealed blocks will have no additional successors added
	// Sealed blocks may look up defs in predecessors since
	// they are all known (they must be Filled blocks).
	BB_SEALED = 0x002,

	// no path into this block
	// it is SEALED and has no predecessors
	BB_DEAD =   0x004,

	// block has been placed into the linear instruction stream
	BB_PLACED = 0x008,

	// first and last blocks in a function
	BB_ENTRY =  0x010,
	BB_EXIT =   0x020,

	// general purpose flag
	BB_MARK =   0x800,

};

struct BasicBlock {
	first *Inst,
	last *Inst,
	phi *Phi,
	flags u32,
	// List of predecessor blocks
	prev *BlockList,
	count i32,
	// up to two succesor blocks
	next0 *BasicBlock,
	next1 *BasicBlock,
	id u32,
	//pcount u32,
	tag str,
};

// TODO alloc at runtime, reduce program size, allow for growth
var bb_next_id i32 = 0;
var bb_idx []*BasicBlock;

var bb_order_first BlockList;
var bb_order_last BlockList;

// target for new instructions
var bb_active BasicBlock = nil;

fn (bb BasicBlock) add_set(shadow i32, reg i32);
fn (bb BasicBlock) add_get(reg i32, shadow i32);

fn (os OutStream) ins(i Inst) OutStream;
fn (os OutStream) reg(id i32) OutStream;

fn phi_lookup(bb BasicBlock, sym Symbol) Phi;

// search a sealed block's predecessors
// for the value(s) for a phi node
fn phi_resolve(bb BasicBlock, phi Phi) {
	Warn("phi_resolve(@,@)").n(bb.id).s(phi.sym.name.text);
	if bb.count == 0 {
		Error("phi_resolve(@) no predecessors?!").n(bb.id);
	}

	var n i32 = 0;
	var args []i32 = __new(4 * bb.count);
	var bl BlockList = bb.prev;
	while bl != nil {
		var p Phi = phi_lookup(bl.bb, phi.sym);
		args[n] = p.vcur;
		n++;
		bl.bb.add_set(phi.vini, p.vcur);
		bl = bl.next;
	}
	phi.args = args;
	phi.count = bb.count;

	// simplify node if trivial
}

// search any block for a phi node for a symbol,
// creating one if necessary, and recursing if sealed
fn phi_lookup(bb BasicBlock, sym Symbol) Phi {
	// first check for an existing phi node
	var phi Phi = bb.phi;
	while phi != nil {
		if phi.sym == sym {
			Warn("phi_lookup(@,@) cached").n(bb.id).s(sym.name.text);
			return phi;
		}
		phi = phi.next;
	}

	// otherwise create a new phi node
	phi = new(Phi);
	phi.sym = sym;
	phi.next = bb.phi;
	bb.phi = phi;
	phi.args = nil;
	phi.count = 0;

	if bb.flags & BB_ENTRY {
		// special case for the function entry block
		Warn("phi_lookup(@,@) entry").n(bb.id).s(sym.name.text);
		phi.vini = sym.vid;
		phi.vcur = sym.vid;
		return phi;
	}

	phi.vini = reg_get();
	phi.vcur = phi.vini;

	bb.add_get(phi.vini, phi.vini);

	if bb.flags & BB_SEALED {
		// sealed block so we can search our predecessors
		Warn("phi_lookup(@,@) recurse").n(bb.id).s(sym.name.text);
		phi_resolve(bb, phi);
	} else {
		// unsealed block, so we install a placeholder
		Warn("phi_lookup(@,@) defer").n(bb.id).s(sym.name.text);
	}
	return phi;
}

fn sym_to_vid_load(sym Symbol) i32 {
	Warn("sym_to_vid(@) ?").s(sym.name.text);
	var phi Phi = phi_lookup(bb_active, sym);
	Warn("sym_load(@) @, @").s(sym.name.text).reg(phi.vini).reg(phi.vcur);
	return phi.vcur;
}

fn sym_to_vid_store(sym Symbol) i32 {
	Warn("sym_to_vid(@) ?").s(sym.name.text);
	var phi Phi = phi_lookup(bb_active, sym);
	var old i32 = phi.vcur;
	phi.vcur = reg_get();
	Warn("sym_store(@) @, @ > @").s(sym.name.text).reg(phi.vini).reg(old).reg(phi.vcur);
	return phi.vcur;
}

// reset all global state
// used at the start of a new function
fn bb_reset() {
	reg_next = REG_VIRT_0;
	bb_next_id = 0;
	bb_active = nil;
	bb_order_first = nil;
	bb_order_last = nil;
}

fn (bb BasicBlock) append(ins Inst);
fn _inst_make(op u32, a i32, b i32, c i32) Inst;

fn bb_make(tag str) BasicBlock {
	var bb BasicBlock = new(BasicBlock);
	bb.id = bb_next_id;
	bb.tag = tag;
	bb_next_id++;
	bb_idx[bb.id] = bb;
	Warn("make bb.@: @ @").n(bb.id).s(tag).x(bb);
	bb.append(_inst_make(INS_LABEL, bb.id, 0, 0));
	return bb;
}

fn (bb BasicBlock) add_set(shadow i32, reg i32) {
	var inst Inst = _inst_make(INS_SET, shadow, reg, 0);
	inst.prev = bb.last.prev;
	inst.next = bb.last;
	inst.prev.next = inst;
	inst.next.prev = inst;
}

fn (bb BasicBlock) add_get(reg i32, shadow i32) {
	var inst Inst = _inst_make(INS_GET, reg, shadow, 0);
	inst.prev = bb.first;
	inst.next = bb.first.next;
	inst.prev.next = inst;
	if inst.next {
		inst.next.prev = inst;
	} else {
		bb.last = inst;
	}
}

fn (bb BasicBlock) place() {
	if bb.flags & BB_PLACED {
		Error("bb.@ placed twice").n(bb.id);
	}
	bb.flags |= BB_PLACED;
	var bl BlockList = new(BlockList);
	bl.bb = bb;
	if bb_order_last == nil {
		bb_order_first = bl;
	} else {
		bb_order_last.next = bl;
	}
	bb_order_last = bl;
}

fn (bb BasicBlock) link_to(target BasicBlock) {
	if target.flags & BB_SEALED {
		Warn("cannot link bb.@ to sealed bb.@").n(bb.id).n(target.id);
	}
	if bb.next0 == nil {
		bb.next0 = target;
	} else {
		bb.next1 = target;
	}
	var bl BlockList = new(BlockList);
	bl.bb = bb;
	bl.next = target.prev;
	target.prev = bl;
	target.count++;
}

fn (bb BasicBlock) append(ins Inst) {
	if bb.flags & BB_FILLED {
		//Warn("cannot add instructions to filled bb.@").n(bb.id);
		//Warn("discarding: @").ins(ins);
		return;
	}
	if bb.last == nil {
		ins.prev = nil;
		bb.first = ins;
	} else {
		ins.prev = bb.last;
		bb.last.next = ins;
	}
	bb.last = ins;
	ins.next = nil;
	if ins.op & INF_IS_EOBB {
		bb.flags |= BB_FILLED;
		if ins.op & INF_IS_B_U {
			bb.link_to(bb_idx[ins.a]);
		}
		if ins.op & INF_IS_B_C {
			bb.link_to(bb_idx[ins.b]);
			bb.link_to(bb_idx[ins.c]);
		}
	}
}

fn inst_jump(bb BasicBlock);

fn (bb BasicBlock) seal() {
	if bb.flags & BB_SEALED {
		Error("bb.@ sealed twice").n(bb.id);
	}
	bb.flags |= BB_SEALED;
	if bb.prev == nil {
		if !(bb.flags & BB_ENTRY) {
			bb.flags |= BB_DEAD;
			Warn("bb.@ is dead").n(bb.id);
		}
	}
	var bl BlockList = bb.prev;
	while bl != nil {
		if !(bl.bb.flags & BB_FILLED) {
			Error("bb.@ sealed, but pred bb.@ is not filled").n(bb.id).n(bl.bb.id);
		}
		bl = bl.next;
	}
	var phi Phi = bb.phi;
	while phi != nil {
		if phi.count == 0 {
			Warn("phi_lookup(@) post-seal").n(bb.id);
			phi_resolve(bb, phi);
		}
		phi = phi.next;
	}
}

// terminate the current bb with a jump to this
// one and make it active for accumulating instructions
fn (bb BasicBlock) _activate(seal_prev bool) {
	if bb_active != nil {
		if !(bb_active.flags & BB_FILLED) {
			if !(bb_active.flags & BB_DEAD) {
				inst_jump(bb);
				Warn("bb.@ chained to bb.@").n(bb_active.id).n(bb.id);
			}
		}
		if seal_prev {
			if !(bb_active.flags & BB_SEALED) {
				bb_active.seal();
			}
		}
	}
	bb_active = bb;
	// housekeeping
}

fn (bb BasicBlock) activate() {
	bb._activate(false);
}

fn (bb BasicBlock) activate_and_seal_prev() {
	bb._activate(true);
}

fn dump_phis(os OutStream, bb BasicBlock, graph bool) {
	var tag str = "    phi @";
	if bb.flags & BB_ENTRY {
		tag = "    ini @";
	}
	var phi Phi = bb.phi;
	while phi != nil {
		if graph {
			os.fmt("<TR><TD ALIGN=\"left\">");
		}
		os.fmt(tag).reg(phi.vini);
		var n i32 = 0;
		while n < phi.count {
			os.fmt(", @").reg(phi.args[n]);
			n++;
		}
		os.fmt(" // @\n").s(phi.sym.name.text);
		if graph {
			os.fmt("</TD></TR>\n");
		}
		phi = phi.next;
	}
}

fn inst_disasm(os OutStream, ins Inst);

fn dump_bb(os OutStream, bb BasicBlock, graph bool) {
	if !(bb.flags & BB_FILLED) {
		Warn("bb.@ is not filled").n(bb.id);
	}
	if !(bb.flags & BB_SEALED) {
		Warn("bb.@ is not sealed").n(bb.id);
	}
	if bb.flags & BB_DEAD {
		if graph {
			os.fmt("\"bb.@\" [ style=invis ];\n").n(bb.id);
		}
		return;
	}
	if graph {
		if false {
		var bl BlockList = bb.prev;
		while bl != nil {
			os.fmt("\"bb.@\":sw -> \"bb.@\":ne [ constraint=false; ];\n").n(bl.bb.id).n(bb.id);
			bl = bl.next;
		}
		}
		os.fmt("\"bb.@\" [ label=<<TABLE BORDER=\"0\" CELLBORDER=\"1\" CELLSPACING=\"0\">\n").n(bb.id);
		os.fmt("<TR><TD BGCOLOR=\"gray\" ALIGN=\"left\">bb.@: @</TD></TR>\n").n(bb.id).s(bb.tag);
	} else {
		os.fmt("bb.@: // @").n(bb.id).s(bb.tag);
		if bb.prev != nil {
			os.fmt(" << ");
			var bl BlockList = bb.prev;
			while bl != nil {
				os.fmt("bb.@").n(bl.bb.id);
				bl = bl.next;
				if bl != nil {
					os.fmt(", ");
				}
			}
		}
		os.fmt("\n");
	}
	dump_phis(os, bb, graph);
	var ins Inst = bb.first;
	while ins != nil {
		if graph {
			os.fmt("<TR><TD ALIGN=\"left\">");
		}
		inst_disasm(os, ins);
		if graph {
			os.fmt("</TD></TR>\n");
		}
		ins = ins.next;
	}
	if graph {
		os.fmt("</TABLE>>; ];\n");
		if bb.next0 {
			os.fmt("\"bb.@\":sw -> \"bb.@\":nw [ constraint=false; ];\n").n(bb.id).n(bb.next0.id);
		}
		if bb.next1 {
			os.fmt("\"bb.@\":se -> \"bb.@\":ne [ constraint=false; ];\n").n(bb.id).n(bb.next1.id);
		}
	}
}

fn dump_bb_list(os OutStream, bl BlockList, graph bool) {
	if graph {
		os.fmt("digraph g {\n");
		os.fmt("node [ shape=plain; ];\n");
	}
	while bl != nil {
		if graph && (bl.next != nil) {
			os.fmt("\"bb.@\" -> \"bb.@\" [ style=invis ];\n").n(bl.bb.id).n(bl.next.bb.id);
		}
		dump_bb(os, bl.bb, graph);
		bl = bl.next;
	}
	if graph {
		os.fmt("}\n");
	}
}

var global_ic i32 = 0;

// TODO: make this nondestructive so we can do it
// at multiple stages of optimization, etc
fn serialize_fn(fd i32, blist BlockList) {
	var bl BlockList = blist;
	// count the fn header as an instruction, since it'll be
	// transformed into one on load, but don't include it
	// in the count
	global_ic++;
	var n i32 = global_ic;
	while bl != nil {
		// record the instruction number in each block's label
		bl.bb.first.c = global_ic;
		var inst Inst = bl.bb.first;
		while inst != nil {
			global_ic++;
			inst = inst.next;
		}
		bl = bl.next;
	}

	bl = blist;
	writeu32(fd, TAG_IR_FUNC);
	writeu32(fd, global_ic - n); // ins count
	writeu32(fd, bl.bb.first.b); // global name id
	writeu32(fd, reg_next);      // max virtual reg used
	while bl != nil {
		var inst Inst = bl.bb.first;
		while inst != nil {
			var op u32 = inst.op & INS_OP_MASK;
			// translate bb.ids to instruction numbers via labels
			if op == INS_JUMP {
				inst.a = bb_idx[inst.a].first.c;
			}
			if op == INS_BRANCH {
				inst.b = bb_idx[inst.b].first.c;
				inst.c = bb_idx[inst.c].first.c;
			}
			writeu32(fd, inst.op);
			writeu32(fd, inst.a);
			writeu32(fd, inst.b);
			writeu32(fd, inst.c);
			inst = inst.next;
		}
		bl = bl.next;
	}
}

var global_next i32 = 0;
var global_names []*String;

// obtain a global identifier for call instruction use
fn get_global_id(name String) i32 {
	var n i32 = 0;
	while n < global_next {
		if global_names[n] == name {
			return n;
		}
		n++;
	}
	global_next = n + 1;
	global_names[n] = name;
	return n;
}

fn serialize_header(fd i32) {
	writeu32(fd, TAG_IR_XIR0);
	writeu32(fd, 0);
	writeu32(fd, 0);
	writeu32(fd, 0);
}

fn serialize_globals(fd i32) {
	var i i32 = 0;
	writeu32(fd, TAG_IR_GLBL);
	writeu32(fd, global_next);
	while i < global_next {
		writeu32(fd, strlen(global_names[i]));
		i++;
	}
	i = 0;
	while i < global_next {
		write(fd, global_names[i], 0, strlen(global_names[i]) + 1);
		i++;
	}
}

fn serialize_data_chunk(fd i32, dc DataChunk) {
	writeu32(fd, TAG_IR_DATA);
	writeu32(fd, dc.count);
	writeu32(fd, dc.id);
	writeu32(fd, 0);
	var n u32 = 0;
	while n < dc.count {
		writeu32(fd, dc.data[n]);
		n++;
	}
	n = 0;
	while n < dc.count {
		writeu32(fd, dc.pmap[n]);
		n += 32;
	}
}

fn (bb BasicBlock) set_name(name str) {
	bb.first.b = get_global_id(name);
}

var label_next i32 = 0;
var label_idx []*Inst;

fn _inst_make(op u32, a i32, b i32, c i32) Inst {
	// add opcode-specific property bitflags to allow
	// for quick property testing
	op |= iop_props[op & INS_OP_MASK];

	var ins Inst = new(Inst);
	ins.next = nil;
	ins.prev = nil;
	ins.op = op;
	ins.a = a;
	ins.b = b;
	ins.c = c;
	return ins;
}

// allocate an instruction and add it to the graph
fn inst_make(op u32, a i32, b i32, c i32) i32 {
	var ins Inst = _inst_make(op, a, b, c);
	bb_active.append(ins);
	return a;
}

fn inst_target_bb(bb BasicBlock) i32 {
	// do other housekeeping
	return bb.id;
}

// declare a function entrypoint
//fn inst_label_global(name String) i32 {
//	return inst_make(INS_LABEL, get_global_id(name), 1, 0);
//}

// ALU instructions
// Default variant allocates a register for the target
// and returns that register.
// X variant is passed the target register and uses that.
// I variant treats second argument as an immediate
fn inst_alu(op u32, b i32, c i32) i32 {
	if op >= INS_MOV { Error("inst_alu invalid alu op"); }
	return inst_make(op, reg_get(), b, c);
}
fn inst_alui(op u32, b i32, imm i32) i32 {
	if op >= INS_MOV { Error("inst_alui invalid alu op"); }
	return inst_make(op | INF_C_IMM, reg_get(), b, imm);
}
fn inst_aluix(op u32, a i32, b i32, imm i32) {
	if op >= INS_MOV { Error("inst_alui invalid alu op"); }
	inst_make(op | INF_C_IMM, a, b, imm);
}
fn inst_movi(imm i32) i32 {
	return inst_make(INS_MOV | INF_C_IMM, reg_get(), 0, imm);
}
fn inst_mov(c i32) i32 {
	return inst_make(INS_MOV, reg_get(), 0, c);
}
fn inst_movx(a i32, c i32) i32 {
	return inst_make(INS_MOV, a, 0, c);
}

// load/store instructions
// Load instructions allocate and return a target register.
fn inst_ldb(b i32, c i32) i32 {
	return inst_make(INS_LOAD | INF_SZ_U8, reg_get(), b, c);
}
fn inst_ldw(b i32, c i32) i32 {
	return inst_make(INS_LOAD | INF_SZ_U32, reg_get(), b, c);
}
fn inst_ldbi(b i32, imm i32) i32 {
	return inst_make(INS_LOAD | INF_SZ_U8 | INF_C_IMM, reg_get(), b, imm);
}
fn inst_ldwi(b i32, imm i32) i32 {
	return inst_make(INS_LOAD | INF_SZ_U32 | INF_C_IMM, reg_get(), b, imm);
}
fn inst_ldwix(a i32, b i32, imm i32) {
	inst_make(INS_LOAD | INF_SZ_U32 | INF_C_IMM, a, b, imm);
}
fn inst_stb(a i32, b i32, c i32) {
	inst_make(INS_STORE | INF_SZ_U8, a, b, c);
}
fn inst_stw(a i32, b i32, c i32) {
	inst_make(INS_STORE | INF_SZ_U32, a, b, c);
}
fn inst_stbi(a i32, b i32, imm i32) {
	inst_make(INS_STORE | INF_SZ_U8 | INF_C_IMM, a, b, imm);
}
fn inst_stwi(a i32, b i32, imm i32) {
	inst_make(INS_STORE | INF_SZ_U32 | INF_C_IMM, a, b, imm);
}

// flow control
fn inst_jump(bb BasicBlock) {
	inst_make(INS_JUMP, inst_target_bb(bb), 0, 0);
}
fn inst_branch(cond i32, ttrue BasicBlock, tfalse BasicBlock) {
	inst_make(INS_BRANCH, cond, inst_target_bb(ttrue), inst_target_bb(tfalse));
}
fn inst_call(name String) {
	inst_make(INS_CALL, get_global_id(name), 0, 0);
}
fn inst_ret(a i32) {
	inst_make(INS_RET, a, 0, 0);
}

// predicates
fn inst_is_label(ins Inst) bool {
	return ins.op & INF_IS_LABEL;
}
fn inst_is_uncond_branch(ins Inst) bool {
	return ins.op & INF_IS_B_U;
}
fn inst_is_cond_branch(ins Inst) bool {
	return ins.op & INF_IS_B_C;
}
fn inst_is_branch(ins Inst) bool {
	return ins.op & INF_IS_B;
}
fn inst_is_return(ins Inst) bool {
	return ins.op & INF_IS_RET;
}


// helpers for printing instructions
fn (os OutStream) reg(id i32) OutStream {
	var n i32 = id & VF_MASK;
	if id & VF_PHYS {
		if n >= REG_COUNT {
			writes(os.fd, "$bad");
		} else {
			writec(os.fd, '$');
			writes(os.fd, reg_names[n]);
		}
	} else if id & VF_UNDEF {
		writes(os.fd, "$und");
	} else if id & VF_INVAL {
		writes(os.fd, "$err");
	} else {
		// virtual register
		writec(os.fd, '%');
		writei(os.fd, n);
	}
	os_advance(os);
	return os;
}

fn (os OutStream) arg(n i32, op i32) OutStream {
	if op & INF_C_IMM {
		writei(os.fd, n);
	} else {
		return os.reg(n);
	}
	os_advance(os);
	return os;
}

fn (os OutStream) label(n i32) OutStream {
	writes(os.fd, "bb.");
	writei(os.fd, n);
	os_advance(os);
	return os;
}

fn inst_disasm(os OutStream, ins Inst) {
	var op u32 = ins.op & INS_OP_MASK;
	var imm str = "";
	if ins.op & INF_C_IMM {
		imm = "i";
	}
	if op == INS_NOT {
		os.fmt("    not @, @\n").reg(ins.a).reg(ins.c);
	} else if op == INS_NEG {
		os.fmt("    neg @, @\n").reg(ins.a).reg(ins.c);
	} else if op < INS_MOV {
		// ALU and CMP instructions
		os.fmt("    @@ @, @, @\n").s(iop_name[op]).s(imm).reg(ins.a).reg(ins.b).arg(ins.c,ins.op);
	} else if op == INS_MOV {
		os.fmt("    mov@ @, @\n").s(imm).reg(ins.a).arg(ins.c,ins.op);
	} else if (op == INS_LOAD) | (op == INS_STORE) {
		var sz str = isz_name[(ins.op & INF_SZ_MASK) >> INF_SZ_SHIFT];
		os.fmt("    @@ @, [@, @]\n").s(iop_name[op]).s(sz).reg(ins.a).reg(ins.b).arg(ins.c,ins.op);
	} else if op == INS_LABEL {
		if ins.b != 0 {
			os.fmt("    label bb.@, \"@\"\n").n(ins.a).s(global_names[ins.b]);
		} else {
			os.fmt("    label bb.@\n").n(ins.a);
		}
	} else if op == INS_JUMP {
		os.fmt("    jump @\n").label(ins.a);
	} else if op == INS_BRANCH {
		os.fmt("    @ @, @, @\n").s(iop_name[op]).reg(ins.a).label(ins.b).label(ins.c);
	} else if op == INS_CALL {
		os.fmt("    call @\n").s(global_names[ins.a]);
	} else if op == INS_RET {
		os.fmt("    ret @\n").reg(ins.a);
	} else if op == INS_SET {
		os.fmt("    set '@, @\n").n(ins.a).reg(ins.b);
	} else if op == INS_GET {
		os.fmt("    get @, '@\n").reg(ins.a).n(ins.b);
	} else {
		os.fmt("    inval 0x@\n").x(ins.op);
	}
}

fn (os OutStream) ins(i Inst) OutStream {
	inst_disasm(os, i);
	return os;
}

fn ir_init() {
	bb_idx = new([1024]*BasicBlock);
	global_names = new([1024]*String);
	label_idx = new([1024]*Inst);
}

