enum IRflag {
	// arg c is immediate, for ALU and Bcc ops
	INF_C_IMM =     0x0100,

	// size flags for LD/ST ops
	INF_SZ_U8 =     0x0000,
	INF_SZ_U16 =    0x0040,
	INF_SZ_U32 =    0x0080,
	INF_SZ_MASK =   0x00C0,
	INF_SZ_SHIFT =  6,

	// property bits
	INF_IS_B_UC =   0x0200, // is unconditional branch
	INF_IS_B_CC =   0x0400, // is conditional branch
	INF_IS_B =      0x0600, // is any kind of branch
	INF_IS_RET =    0x0800, // is a return op
	INF_IS_EOBB =   0x0E00, // is an end of a bb (a branch or return)
	INF_IS_LABEL =  0x1000, // is a label (start of a bb)
	INF_IS_ALU =    0x2000, // is an ALU op
	INF_IS_MEM =    0x4000, // load or store
	INF_IS_PHI =    0x8000,
};

enum IRop {
	INS_ADD,   // ADD Ra, Rb, Rc       Ra = Rb + Rc
	INS_SUB,   // SUBI Ra, Rb, IMMc    Ra = Rb - IMMc
	INS_MUL,
	INS_UDIV,
	INS_SDIV,
	INS_UREM,
	INS_SREM,

	INS_LSL,
	INS_LSR,
	INS_ASR,
	INS_AND,
	INS_OR,
	INS_XOR,

	INS_MOV,   // MOV Ra, Rc           Ra = Rc

	INS_LD,    // LDW Ra, Rb, Rc       Ra = MEM[Rb + Rc]
	INS_ST,    // STBI Ra, Rb, IMMc    MEM[Rb + IMMc] = Ra

	INS_PHI,

	INS_LABEL, // La: b=Placed c=EdgeCount

	INS_B,     // B La
	INS_BEQ,   // BEQ La, Rb, Rc       BEQI La, Rb, IMMc
	INS_BNE,   // ...
	INS_BLT,
	INS_BLE,
	INS_BGT,
	INS_BGE,
	INS_CALL,
	INS_RET,

	INS_COUNT, // total unique opcodes (27)

	INS_OP_MASK = 0x3f,
};

var iop_name []str = { //INS_COUNT
	"add", "sub", "mul", "udiv", "sdiv",
	"urem", "srem", "lsl", "lsr", "asr",
	"and", "or", "xor", "mov",
	"ld", "st", "phi", "label", "b",
	"beq", "bne", "blt",
	"ble", "bgt", "bge",
	"call", "ret", "dead",
};

var iop_props []u32 = { //INS_COUNT
	INF_IS_ALU, INF_IS_ALU, INF_IS_ALU, INF_IS_ALU, INF_IS_ALU,
	INF_IS_ALU, INF_IS_ALU, INF_IS_ALU, INF_IS_ALU, INF_IS_ALU,
	INF_IS_ALU, INF_IS_ALU, INF_IS_ALU, 0,
	INF_IS_MEM, INF_IS_MEM, INF_IS_PHI, INF_IS_LABEL, INF_IS_B_UC,
	INF_IS_B_CC, INF_IS_B_CC, INF_IS_B_CC,
	INF_IS_B_CC, INF_IS_B_CC, INF_IS_B_CC,
	0, INF_IS_RET, 0,
};

var isz_name [4]str = { "b", "h", "w", "d" };

struct Inst {
	next *Inst,
	prev *Inst,
	op u32,
	a i32,
	b i32,
	c i32,
};

struct BasicBlock {
	first *Inst,
	last *Inst,
	flags u32,
	id u32,
	pcount u32,
	list *BasicBlock,
	next [2]*BasicBlock,
	prev [1]*BasicBlock,
};

var reg_next i32 = REG_VIRT_0;

fn reg_get() i32 {
	var r i32 = reg_next;
	reg_next++;
	return r;
}

var global_next i32 = 1;
var global_names [1024]*String;

// allocate a global label (negative)
fn label_get_global(name String) i32 {
	var n i32 = 1;
	while n < global_next {
		if global_names[n] == name {
			return -n;
		}
		n++;
	}
	global_next = n + 1;
	global_names[n] = name;
	return -n;
}

var label_next i32 = 0;
var label_idx [1024]*Inst;

var ins_last_placed Inst = nil;

fn _inst_make(op u32, a i32, b i32, c i32) Inst {
	// add opcode-specific property bitflags to allow
	// for quick property testing
	op |= iop_props[op & INS_OP_MASK];

	var ins Inst = new(Inst);
	ins.next = nil;
	ins.prev = nil;
	ins.op = op;
	ins.a = a;
	ins.b = b;
	ins.c = c;
	return ins;
}

// obtain a (detached) label instruction
// branches may target it before it is placed
// with inst_label()
fn label_get() i32 {
	var a i32 = label_next;
	var ins Inst = _inst_make(INS_LABEL, a, 0, 0);
	label_idx[a] = ins;
	label_next = a + 1;
	return a;
}

// allocate an instruction and add it to the graph
fn inst_make(op u32, a i32, b i32, c i32) i32 {
	var ins Inst = _inst_make(op, a, b, c);
	ins.prev = ins_last_placed;
	ins_last_placed.next = ins;
	ins_last_placed = ins;
	return a;
}

// place a label obtained with label_get()
fn inst_label(a i32) i32 {
	if (a < 0) || (a >= label_next) {
		Error("invalid label #@").n(a);
	}
	var ins Inst = label_idx[a];
	if ins.b != 0 {
		Error("label #@ placed twice!").n(a);
	}
	// mark as placed
	ins.b = 1;
	// add to graph
	ins.prev = ins_last_placed;
	ins_last_placed.next = ins;
	ins_last_placed = ins;
	return a;
}

// branch instructions use this to validate targets
fn inst_use_label(a i32) {
	if (a < 0) || (a >= label_next) {
		Error("invalid label #@").n(a);
	}
	// bump edge count
	label_idx[a].c++;
}

fn inst_label_global(name String) i32 {
	return inst_make(INS_LABEL, label_get_global(name), 1, 0);
}

// ALU instructions
fn inst_alu(op u32, b i32, c i32) i32 {
	if op > INS_XOR { Error("inst_alu invalid alu op"); }
	return inst_make(op, reg_get(), b, c);
}
fn inst_alui(op u32, b i32, imm i32) i32 {
	if op > INS_XOR { Error("inst_alui invalid alu op"); }
	return inst_make(op | INF_C_IMM, reg_get(), b, imm);
}
fn inst_aluix(op u32, a i32, b i32, imm i32) {
	if op > INS_XOR { Error("inst_alui invalid alu op"); }
	inst_make(op | INF_C_IMM, a, b, imm);
}
fn inst_movi(imm i32) i32 {
	return inst_make(INS_MOV | INF_C_IMM, reg_get(), 0, imm);
}
fn inst_mov(c i32) i32 {
	return inst_make(INS_MOV, reg_get(), 0, c);
}
fn inst_movx(a i32, c i32) i32 {
	return inst_make(INS_MOV, a, 0, c);
}

// load/store instructions
fn inst_ldb(b i32, c i32) i32 {
	return inst_make(INS_LD | INF_SZ_U8, reg_get(), b, c);
}
fn inst_ldw(b i32, c i32) i32 {
	return inst_make(INS_LD | INF_SZ_U32, reg_get(), b, c);
}
fn inst_ldbi(b i32, imm i32) i32 {
	return inst_make(INS_LD | INF_SZ_U8 | INF_C_IMM, reg_get(), b, imm);
}
fn inst_ldwi(b i32, imm i32) i32 {
	return inst_make(INS_LD | INF_SZ_U32 | INF_C_IMM, reg_get(), b, imm);
}
fn inst_ldwix(a i32, b i32, imm i32) {
	inst_make(INS_LD | INF_SZ_U32 | INF_C_IMM, a, b, imm);
}
fn inst_stb(a i32, b i32, c i32) {
	inst_make(INS_ST | INF_SZ_U8, a, b, c);
}
fn inst_stw(a i32, b i32, c i32) {
	inst_make(INS_ST | INF_SZ_U32, a, b, c);
}
fn inst_stbi(a i32, b i32, imm i32) {
	inst_make(INS_ST | INF_SZ_U8 | INF_C_IMM, a, b, imm);
}
fn inst_stwi(a i32, b i32, imm i32) {
	inst_make(INS_ST | INF_SZ_U32 | INF_C_IMM, a, b, imm);
}

// flow control
fn inst_phi(b i32, c i32) i32 {
	return inst_make(INS_PHI, reg_get(), b, c);
}
fn inst_br(label i32) i32 {
	inst_use_label(label);
	return inst_make(INS_B, label, 0, 0);
}
fn inst_br_cmp(op u32, label i32, b i32, c i32) i32 {
	inst_use_label(label);
	if (op < INS_BEQ) || (op > INS_BGE) {
		Error("inst_branch_cond inavlid branch op");
	}
	return inst_make(op, label, b, c);
}
fn inst_br_cmpi(op u32, label i32, b i32, imm i32) i32 {
	inst_use_label(label);
	if (op < INS_BEQ) || (op > INS_BGE) {
		Error("inst_branch_condi inavlid branch op");
	}
	return inst_make(op | INF_C_IMM, label, b, imm);
}
fn inst_call(label i32) {
	if label >= 0 {
		Error("cannot CALL local label #@").n(label);
	}
	inst_make(INS_CALL, label, 0, 0);
}
fn inst_ret(a i32) {
	inst_make(INS_RET, a, 0, 0);
}

// predicates
fn inst_is_label(ins Inst) bool {
	return ins.op & INF_IS_LABEL;
}
fn inst_is_uncond_branch(ins Inst) bool {
	return ins.op & INF_IS_B_UC;
}
fn inst_is_cond_branch(ins Inst) bool {
	return ins.op & INF_IS_B_CC;
}
fn inst_is_branch(ins Inst) bool {
	return ins.op & INF_IS_B;
}
fn inst_is_return(ins Inst) bool {
	return ins.op & INF_IS_RET;
}


// helpers for printing instructions
fn (os OutStream) reg(n i32) OutStream {
	if n < 0 {
		writes(os.fd, "$ERROR");
	} else if n < REG_VIRT_0 {
		// physical register
		writec(os.fd, '$');
		writes(os.fd, reg_names[n]);
	} else {
		// virtual register
		writec(os.fd, '%');
		writei(os.fd, n - REG_VIRT_0);
	}
	os_advance(os);
	return os;
}

fn (os OutStream) arg(n i32, op i32) OutStream {
	if op & INF_C_IMM {
		writei(os.fd, n);
	} else {
		return os.reg(n);
	}
	os_advance(os);
	return os;
}

fn (os OutStream) label(n i32) OutStream {
	if n >= 0 {
		writec(os.fd, 'L');
		writei(os.fd, 0); // label_idx[n].a
	} else {
		writec(os.fd, '@');
		writes(os.fd, "name"); // global_names[-1]
	}
	os_advance(os);
	return os;
}

fn inst_disasm(os OutStream, ins Inst) {
	var op u32 = ins.op & INS_OP_MASK;

	if op == INS_LABEL {
		os.fmt("@:").label(ins.a);
	} else if op == INS_MOV {
		os.fmt("    mov @, @").reg(ins.a).arg(ins.c,ins.op);
	} else if (op == INS_LD) | (op == INS_ST) {
		var sz str = isz_name[(ins.op & INF_SZ_MASK) >> INF_SZ_SHIFT];
		os.fmt("    @@ @, [@, @]").s(iop_name[op]).s(sz).reg(ins.a).reg(ins.b).arg(ins.c,ins.op);
	} else if op <= INS_PHI {
		os.fmt("    @ @, @, @").s(iop_name[op]).reg(ins.a).reg(ins.b).arg(ins.c,ins.op);
	} else if op == INS_B {
		os.fmt("    b @").label(ins.a);
	} else if (op >= INS_BEQ) && (op <= INS_BGE) {
		os.fmt("    @ @, @, @").s(iop_name[op]).label(ins.a).reg(ins.b).arg(ins.c,ins.op);
	} else if op == INS_CALL {
		os.fmt("    call @").label(ins.a);
	} else if op == INS_RET {
		os.fmt("    ret @").reg(ins.a);
	} else {
		os.fmt("    inval 0x@").x(ins.op);
	}
}
