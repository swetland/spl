fn writec(fd i32, n u32);
fn fd_open(path str) i32;
fn fd_create(path str) i32;
fn fd_close(fd i32);

fn readc(fd i32) i32;
fn writes(fd i32, s str);
fn writei(fd i32, i u32);
fn writeu(fd i32, n u32);
fn writex(fd i32, n u32);
fn writeu32(fd i32, n u32);
fn write(fd i32, s str, off u32, len u32);

fn sys_alloc(sz u32) u32;
fn sys_get_alloc_count() u32;
fn sys_get_alloc_bytes() u32;

fn os_exit(n i32);

fn os_arg(n u32) str;
fn os_arg_count() u32;

fn sys_panic();

fn streq(s1 str, s2 str) bool {
	var n u32 = 0;
	while true {
		if s1[n] != s2[n] {
			return false;
		}
		if s1[n] == 0 {
			return true;
		}
		n++;
	}
}

fn strneq(s1 str, s2 str, len u32) bool {
	var n u32 = 0;
	while n < len {
		if s1[n] != s2[n] {
			return false;
		}
		n++;
	}
	return true;
}

fn strcpyn(dst str, src str, len u32) {
	var n u32 = 0;
	while n < len {
		dst[n] = src[n];
		n++;
	}
}

fn strlen(s str) u32 {
	var n u32 = 0;
	while s[n] != 0 {
		n++;
	}
	return n;
}

fn strcat(a str, b str) str {
	var la i32 = strlen(a);
	var lb i32 = strlen(b);
	var x str = new([la + lb + 1]u8);
	var xi i32 = 0;
	var i i32 = 0;
	while i < la {
		x[xi] = a[i];
		i++;
		xi++;
	}
	i = 0;
	while i < lb {
		x[xi] = b[i];
		i++;
		xi++;
	}
	x[xi] = 0;
	return x;
}

