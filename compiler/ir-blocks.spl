struct RegInfo {
	inst *Inst,
	used i32,
};

var reg_info []RegInfo;
var reg_next i32 = 0;

// obtain a fresh virtual register
fn ir_reg_get() i32 {
	var r i32 = reg_next;
	reg_next++;
	reg_info[r].used = 0;
	reg_info[r].inst = nil;
	return r;
}

// allow a virtual register to be discarded if
// not needed, provided there aren't any newer
// ones in use
fn ir_reg_put(r i32) {
	if r == (reg_next - 1) {
		reg_next--;
	}
}

struct Phi {
	next *Phi,
	sym *Symbol,
	// initial vid
	vini i32,
	// most recent vid
	vcur i32,
	// vids from predecessor blocks
	args []i32,
	// -1: variable tracking only, 0: placeholder, >0: full phi node
	count i32,
};

struct BlockList {
	next *BlockList,
	bb *BasicBlock,
};

enum BBFlags {
	// Filled blocks contain all their instructions
	// Filled blocks may provide defs for successors
	// Successors may only be added to Filled blocks
	BB_FILLED = 0x001,

	// Sealed blocks will have no additional successors added
	// Sealed blocks may look up defs in predecessors since
	// they are all known (they must be Filled blocks).
	BB_SEALED = 0x002,

	// no path into this block
	// it is SEALED and has no predecessors
	BB_DEAD =   0x004,

	// block has been placed into the linear instruction stream
	BB_PLACED = 0x008,

	// first and last blocks in a function
	BB_ENTRY =  0x010,
	BB_EXIT =   0x020,

	// general purpose flag
	BB_MARK =   0x800,

};

// TODO alloc at runtime, reduce program size, allow for growth
var bb_next_id i32 = 0;
var bb_idx []*BasicBlock;

var bb_order_first BlockList;
var bb_order_last BlockList;
var bb_order_count i32;

// target for new instructions
var bb_active BasicBlock = nil;

fn (bb BasicBlock) add_set(shadow i32, reg i32);
fn (bb BasicBlock) add_get(reg i32, shadow i32);

fn phi_lookup(bb BasicBlock, sym Symbol) i32;

fn (phi Phi) is_trivial() bool {
	var v i32 = -1;
	var n i32 = 0;
	while n < phi.count {
		if v == -1 {
			v = phi.args[n];
		} else if v != phi.args[n] {
			return false;
		}
		n++;
	}
	return true;
}

fn phis_to_insts(bl BlockList) {
	while bl != nil {
		var phi Phi = bl.bb.phi;
		while phi != nil {
			if phi.count > 0 {
				if phi.count != bl.bb.count {
					Error("phi count mismatch");
				}
				// previous block list
				var pbl BlockList = bl.bb.prev;
				while pbl != nil {
					pbl.bb.add_set(phi.vini, phi_lookup(pbl.bb, phi.sym));
					pbl = pbl.next;
				}
				bl.bb.add_get(phi.vini, phi.vini);
			}
			phi = phi.next;
		}
		bl = bl.next;
	}
}

// search a sealed block's predecessors
// for the value(s) for a phi node
fn phi_resolve(bb BasicBlock, phi Phi) {
	//Warn("phi_resolve(bb.@,@)").n(bb.id).s(phi.sym.name.text);
	if bb.count == 0 {
		Error("phi_resolve(bb.@) no predecessors?!").n(bb.id);
	}

	var n i32 = 0;
	var args []i32 = new([bb.count]i32);
	var bl BlockList = bb.prev;
	while bl != nil {
		var val i32 = phi_lookup(bl.bb, phi.sym);
		if false {
			// does not occur across all test cases, investigate later
			if val == VF_UNDEF {
				bl = bl.next;
				continue;
			}
		}
		args[n] = val;
		n++;
		//bl.bb.add_set(phi.vini, val);
		bl = bl.next;
	}
	phi.args = args;
	phi.count = bb.count;

	// simplify node if trivial
}

fn phi_write(bb BasicBlock, sym Symbol, val i32) {
	// first check for an existing phi node
	var phi Phi = bb.phi;
	while phi != nil {
		if phi.sym == sym {
			//Warn("phi_write(bb.@,@) @").n(bb.id).s(sym.name.text).reg(val);
			phi.vcur = val;
			return;
		}
		phi = phi.next;
	}

	// otherwise create a new phi node
	phi = new(Phi);
	phi.sym = sym;
	phi.next = bb.phi;
	bb.phi = phi;
	phi.args = nil;
	phi.count = -1; // do not try to resolve later
	phi.vini = val; //VF_UNDEF;
	phi.vcur = val;
}

// search any block for a phi node for a symbol,
// creating one if necessary, and recursing if sealed
fn phi_lookup(bb BasicBlock, sym Symbol) i32 {
	// first check for an existing phi node
	var phi Phi = bb.phi;
	while phi != nil {
		if phi.sym == sym {
			//Warn("phi_lookup(bb.@,@) cached @").n(bb.id).s(sym.name.text).reg(phi.vcur);
			return phi.vcur;
		}
		phi = phi.next;
	}

	if bb.flags & BB_ENTRY {
		// special case for the function entry block / initial values of params
		// Warn("phi_lookup(bb.@,@) entry @").n(bb.id).s(sym.name.text).reg(sym.vid);
		return sym.vid;
	}

	// otherwise create a new phi node
	phi = new(Phi);
	phi.sym = sym;
	phi.next = bb.phi;
	bb.phi = phi;
	phi.args = nil;
	phi.count = 0;

	if bb.flags & BB_SEALED {
		// sealed block so we can search our predecessors
		// Warn("phi_lookup(bb.@,@) recurse").n(bb.id).s(sym.name.text);

		if bb.count == 1 {
			phi.vini = phi_lookup(bb.prev.bb, sym);
			phi.vcur = phi.vini;
			phi.count = -1;
			return phi.vini;
		}
		// must assign vini before resolve
		// since resolve may use it to insert a get instruction
		phi.vini = ir_reg_get();
		phi_resolve(bb, phi);
		if phi.is_trivial() {
			ir_reg_put(phi.vini);
			phi.count = -1;
			phi.vini = phi.args[0];
			phi.vcur = phi.vini;
			return phi.vini;
		}
		// todo flatten trivial phi
	} else {
		// unsealed block, so we install a placeholder
		phi.vini = ir_reg_get();
		//Warn("phi_lookup(bb.@,@) defer").n(bb.id).s(sym.name.text);
	}

	phi.vcur = phi.vini;
	//bb.add_get(phi.vini, phi.vini);

	return phi.vcur;
}

fn sym_to_vid_load(sym Symbol) i32 {
	//Warn("sym_load(@)").s(sym.name.text);
	var val i32 = phi_lookup(bb_active, sym);
	//Warn("sym_load(@) @").s(sym.name.text).reg(val);
	return val;
}

fn sym_to_vid_store(sym Symbol, vr i32) i32 {
	//Warn("sym_store(@) @").s(sym.name.text).reg(vr);
	phi_write(bb_active, sym, vr);
	return vr;
}

// reset all global state
// used at the start of a new function
fn bb_reset() {
	var n i32 = 0;
	while n < reg_next {
		n++;
	}
	reg_next = 0;
	bb_next_id = 0;
	bb_active = nil;
	bb_order_first = nil;
	bb_order_last = nil;
	bb_order_count = 0;
}

fn inst_track_use(i Inst, r i32) {
	if r & VF_SPECIAL { return; }
	reg_info[r].used++;
}

fn inst_track_set(i Inst, r i32) {
	if r & VF_SPECIAL { return; }
	reg_info[r].inst = i;
}

fn inst_track(i Inst) {
	var op i32 = i.op;
	if (op & INF_USE_C) && (op & INF_C_IMM) {
		Error("invalid instruction USE_C + C_IMM");
	}
	if op & INF_USE_A { inst_track_use(i, i.a); }
	if op & INF_USE_B { inst_track_use(i, i.b); }
	if op & INF_USE_C { inst_track_use(i, i.c); }
	if op & INF_SET_A { inst_track_set(i, i.a); }
}

fn (bb BasicBlock) append(ins Inst);

fn bb_make(tag str) BasicBlock {
	var bb BasicBlock = new(BasicBlock);
	bb.id = bb_next_id;
	bb.tag = tag;
	bb_next_id++;
	bb_idx[bb.id] = bb;
	//Warn("make bb.@: @ @").n(bb.id).s(tag).x(bb);
	bb.append(_inst_make(INS_LABEL, bb.id, 0, 0));
	return bb;
}

fn (bb BasicBlock) add_set(shadow i32, reg i32) {
	var inst Inst = _inst_make(INS_SET, shadow, 0, reg);
	inst.prev = bb.last.prev;
	inst.next = bb.last;
	inst.prev.next = inst;
	inst.next.prev = inst;
	inst_track(inst);
}

fn (bb BasicBlock) add_get(reg i32, shadow i32) {
	var inst Inst = _inst_make(INS_GET, reg, 0, shadow);
	inst.prev = bb.first;
	inst.next = bb.first.next;
	inst.prev.next = inst;
	if inst.next {
		inst.next.prev = inst;
	} else {
		bb.last = inst;
	}
	inst_track(inst);
}

fn (bb BasicBlock) place() {
	if bb.flags & BB_PLACED {
		Error("bb.@ placed twice").n(bb.id);
	}
	bb.flags |= BB_PLACED;
	var bl BlockList = new(BlockList);
	bl.bb = bb;
	if bb_order_last == nil {
		bb_order_first = bl;
	} else {
		bb_order_last.next = bl;
	}
	bb_order_last = bl;
	bb_order_count++;
}

fn (bb BasicBlock) link_to(target BasicBlock) {
	if target.flags & BB_SEALED {
		Warn("cannot link bb.@ to sealed bb.@").n(bb.id).n(target.id);
	}
	if bb.next0 == nil {
		bb.next0 = target;
	} else {
		bb.next1 = target;
	}
	var bl BlockList = new(BlockList);
	bl.bb = bb;
	bl.next = target.prev;
	target.prev = bl;
	target.count++;
}

fn (bb BasicBlock) append(ins Inst) {
	if bb.flags & BB_FILLED {
		//Warn("cannot add instructions to filled bb.@").n(bb.id);
		//Warn("discarding: @").ins(ins);
		return;
	}
	if bb.last == nil {
		ins.prev = nil;
		bb.first = ins;
	} else {
		ins.prev = bb.last;
		bb.last.next = ins;
	}
	bb.last = ins;
	ins.next = nil;
	if ins.op & INF_IS_EOBB {
		bb.flags |= BB_FILLED;
		if ins.op & INF_IS_B_U {
			bb.link_to(bb_idx[ins.a]);
		}
		if ins.op & INF_IS_B_C {
			bb.link_to(bb_idx[ins.b]);
			bb.link_to(bb_idx[ins.c]);
		}
	}
}

fn (bb BasicBlock) seal() {
	if bb.flags & BB_SEALED {
		Error("bb.@ sealed twice").n(bb.id);
	}
	bb.flags |= BB_SEALED;
	if bb.prev == nil {
		if !(bb.flags & BB_ENTRY) {
			bb.flags |= BB_DEAD;
			Warn("bb.@ is dead").n(bb.id);
		}
	}
	var bl BlockList = bb.prev;
	while bl != nil {
		if !(bl.bb.flags & BB_FILLED) {
			Error("bb.@ sealed, but pred bb.@ is not filled").n(bb.id).n(bl.bb.id);
		}
		bl = bl.next;
	}
	var phi Phi = bb.phi;
	while phi != nil {
		if phi.count == 0 {
			//Warn("phi_resolve(bb.@) post-seal").n(bb.id);
			phi_resolve(bb, phi);
			if phi.is_trivial() {
				Warn("need-simplify-def: bb.@ @ x@").n(bb.id).s(phi.sym.name.text).n(phi.count);
			}
		}
		phi = phi.next;
	}
}

// terminate the current bb with a jump to this
// one and make it active for accumulating instructions
fn (bb BasicBlock) _activate(seal_prev bool) {
	if bb_active != nil {
		if !(bb_active.flags & BB_FILLED) {
			if !(bb_active.flags & BB_DEAD) {
				inst_jump(bb);
				//Warn("bb.@ chained to bb.@").n(bb_active.id).n(bb.id);
			}
		}
		if seal_prev {
			if !(bb_active.flags & BB_SEALED) {
				bb_active.seal();
			}
		}
	}
	bb_active = bb;
	// housekeeping
}

fn (bb BasicBlock) activate() {
	bb._activate(false);
}

fn (bb BasicBlock) activate_and_seal_prev() {
	bb._activate(true);
}

fn (bb BasicBlock) set_name(name String) {
	bb.first.b = ir_string_get(name);
}

fn inst_make_mov(i Inst, val i32) {
	//Warn("simplify @ @").s(iop_name[i.op & INS_OP_MASK]).n(val);
	i.op = INS_MOV | INF_C_IMM | iop_props[INS_MOV];
	i.op &= (~INF_USE_C);
	i.b = 0;
	i.c = val;
}

fn inst_make_imm(i Inst, val i32) {
	i.op |= INF_C_IMM;
	i.op &= (~INF_USE_C);
	i.c = val;
}

fn b2i32(cond bool) i32 {
	if cond { return 1; }
	return 0;
}

// Convert this instruction to a simpler form in situations
// where it depends on vregs that are set by constant loads,
// and so on.
// NOTE: does not adjust used count, unsafe for placed instructions.
fn inst_simplify(i Inst) bool {
	var op i32 = i.op;
	var valc i32;
	var x Inst;

	if false { // TODO: fix resulting issues
	if (op & INS_OP_MASK) == INS_BRANCH {
		if i.a & VF_SPECIAL { return false; }
		x = reg_info[i.a].inst;
		if x == nil { return false; }
		if !((x.op & INS_OP_MASK) == INS_MOV) { return false; }
		if !(x.op & INF_C_IMM) { return false; }

		// movi %a0, c0
		// branch %a0, bb.b, bb.c  --> jump (c0 ? bb.b : bb.c)
		if x.c {
			i.a = x.b;
		} else {
			i.a = x.c;
		}
		i.b = 0;
		i.c = 0;
		i.op = INS_JUMP | iop_props[INS_JUMP];
		Warn("simplify const branch");
		return false;
	}
	}
	if op & INF_C_IMM {
		valc = i.c;
	} else {
		if i.c & VF_SPECIAL { return false; }
		x = reg_info[i.c].inst;
		if x == nil { return false; }
		if !((x.op & INS_OP_MASK) == INS_MOV) { return false; }
		if !(x.op & INF_C_IMM) { return false; }
		valc = x.c;

		// movi %a0, c0
		// alu  %a1, %b1, %a0  ->  alui  %a1, %b1, c0
		if op & INF_IS_ALU {
			inst_make_imm(i, valc);
			//Warn("simplify @ c-arg").s(iop_name[i.op & INS_OP_MASK]);
			return true;
		}

		if (op & INS_OP_MASK) == INS_LOAD {
			// movi %a0, c0
			// ld %a1, [%b1, %a0]  ->  ldi %a1, [%b1, c0]
			inst_make_imm(i, valc);
			//Warn("simplify load");
			return false;
		}
		if (op & INS_OP_MASK) == INS_STORE {
			// movi %a0, c0
			// st %a1, [%b1, %a0]  ->  sti %a1, [%b1, c0]
			inst_make_imm(i, valc);
			//Warn("simplify store");
			return false;
		}
	}
	// valc is now the value of argc which was a const arg
	// or referred to a vreg containing a constant value

	if (op & INS_OP_MASK) == INS_ADD {
		// addi %a0, %b0, c0
		// addi %a1, %a0, c1  ->  addi %a1, %b0, (c0 + c1)
		if i.b & VF_SPECIAL { return false; }
		x = reg_info[i.b].inst;
		if x == nil { return false; }
		if (x.op & INS_OP_MASK) != INS_ADD { return false; }
		if !(x.op & INF_C_IMM) { return false; }

		i.b = x.b;
		inst_make_imm(i, valc + x.c);
		//Warn("simplify add chain");
		return true;
	}

	if ((op & INS_OP_MASK) == INS_LOAD) || ((op & INS_OP_MASK) == INS_STORE) {
		// addi %a0, %b0, c0
		// ldi  %a1, [%a0, c1]  ->  ldi %a1, [%b0, c0 + c1]
		if i.b & VF_SPECIAL { return false; }
		x = reg_info[i.b].inst;
		if x == nil { return false; }
		if (x.op & INS_OP_MASK) != INS_ADD { return false; }
		if !(x.op & INF_C_IMM) { return false; }

		i.b = x.b;
		inst_make_imm(i, valc + x.c);
		//Warn("simplify add/load chain");
		return true;
	}

	// TODO
	// addi %a0, %b0, c0
	// movi %a1, c1
	// add  %a2, %a0, %a1  -> add %a2, %b0, (c0 + c1)

	// TODO
	if !(op & INF_IS_ALU) { return false; }

	if i.b & VF_SPECIAL { return false; }
	x = reg_info[i.b].inst;
	if x == nil { return false; }
	if !((x.op & INS_OP_MASK) == INS_MOV) { return false; }
	if !(x.op & INF_C_IMM) { return false; }
	var valb i32 = x.c;

	op &= INS_OP_MASK;

	// movi %a0, c0
	// movi %a1, c1
	// alu  %a2, %a0, %a1  -> alu %a2, c0, c1
	if op == INS_ADD { inst_make_mov(i, valb + valc); return false; }
	if op == INS_SUB { inst_make_mov(i, valb - valc); return false; }
	if op == INS_MUL { inst_make_mov(i, valb * valc); return false; }
	if op == INS_LSL { inst_make_mov(i, valb << valc); return false; }
	if op == INS_AND { inst_make_mov(i, valb & valc); return false; }
	if op == INS_OR  { inst_make_mov(i, valb | valc); return false; }
	if op == INS_XOR { inst_make_mov(i, valb ^ valc); return false; }

	if op == INS_CMP_EQ { inst_make_mov(i, b2i32(valb == valc)); return false; }
	if op == INS_CMP_NE { inst_make_mov(i, b2i32(valb != valc)); return false; }
	if op == INS_CMP_LT { inst_make_mov(i, b2i32(valb < valc)); return false; }
	if op == INS_CMP_LE { inst_make_mov(i, b2i32(valb <= valc)); return false; }
	if op == INS_CMP_GT { inst_make_mov(i, b2i32(valb > valc)); return false; }
	if op == INS_CMP_GE { inst_make_mov(i, b2i32(valb >= valc)); return false; }
	return false;
}

fn inst_flip_alu(i Inst, op i32, newc i32) {
	// transform alu %a0, %b0, %c0 -> alui %a0, %c0, newc
	i.op = (i.op & (~(INS_OP_MASK|INF_USE_C))) | op | INF_C_IMM;
	i.b = i.c;
	i.c = newc;
}

fn inst_simplify2(i Inst) {
	// movi %a0, c0
	// alu  %a1, %a0, %c1  -> alu %a1, %c1, c0  (if reversible)

	var op i32 = i.op;
	if !(op & INF_IS_ALU) { return; }
	if op & INF_C_IMM { return; }
	if i.c & VF_SPECIAL { return; }

	var x Inst = reg_info[i.b].inst;
	if x == nil { return; }
	if !((x.op & INS_OP_MASK) == INS_MOV) { return; }
	if !(x.op & INF_C_IMM) { return; }
	var valb i32 = x.c;

	op &= INS_OP_MASK;

	if op == INS_ADD { inst_flip_alu(i, INS_ADD, valb); return; }
	if op == INS_MUL { inst_flip_alu(i, INS_MUL, valb); return; }
	if op == INS_AND { inst_flip_alu(i, INS_AND, valb); return; }
	if op == INS_OR  { inst_flip_alu(i, INS_OR, valb); return; }
	if op == INS_XOR { inst_flip_alu(i, INS_XOR, valb); return; }

	if op == INS_CMP_EQ { inst_flip_alu(i, INS_CMP_NE, valb); return; }
	if op == INS_CMP_NE { inst_flip_alu(i, INS_CMP_EQ, valb); return; }
	if op == INS_CMP_LT { inst_flip_alu(i, INS_CMP_GE, valb); return; }
	if op == INS_CMP_LE { inst_flip_alu(i, INS_CMP_GT, valb); return; }
	if op == INS_CMP_GT { inst_flip_alu(i, INS_CMP_LE, valb); return; }
	if op == INS_CMP_GE { inst_flip_alu(i, INS_CMP_LT, valb); return; }
}

// allocate an instruction and add it to the graph
fn inst_make(op u32, a i32, b i32, c i32) i32 {
	var ins Inst = _inst_make(op, a, b, c);

	while inst_simplify(ins) { }
	inst_simplify2(ins);
	inst_track(ins);

	bb_active.append(ins);
	return a;
}

var global_next i32 = 0;
var global_names []*String;

// obtain a string identifier for call instruction use
fn ir_string_get(name String) i32 {
	var n i32 = 0;
	while n < global_next {
		if global_names[n] == name {
			return n;
		}
		n++;
	}
	global_next = n + 1;
	global_names[n] = name;
	return n;
}

fn ir_string(id i32) str {
	if id >= global_next {
		Error("invalid string id");
	}
	return global_names[id].text;
}

fn ir_strlen(id i32) u32 {
	if id >= global_next {
		Error("invalid string id");
	}
	return global_names[id].len;
}

fn inst_remove(i Inst);

fn reg_disuse(r i32) {
	if r & VF_SPECIAL { return; }
	if reg_info[r].used == 0 {
		Error("reg refcount underflow");
	}
	reg_info[r].used--;
	if reg_info[r] == 0 {
		inst_remove(reg_info[r].inst);
	}
}

fn inst_remove(i Inst) {
	if i != nil {
		if i.op & INF_DEAD {
			Error("double nopped");
		}
		i.op |= INF_DEAD;
		i.next.prev = i.prev;
		i.prev.next = i.next;
		if i.op & INF_USE_A { reg_disuse(i.a); }
		if i.op & INF_USE_B { reg_disuse(i.b); }
		if i.op & INF_USE_C { reg_disuse(i.c); }
	}
}

// TODO: actually split edges
fn split_critical_edges(bl BlockList) {
	while bl != nil {
		var bb BasicBlock = bl.bb;
		var n i32 = 0;
		var phi Phi = bb.phi;
		while phi != nil {
			if phi.count > 0 { n++; }
			phi = phi.next;
		}
		if bb.count > 1 {
			var pl BlockList = bb.prev;
			while pl != nil {
				if pl.bb.next0 && pl.bb.next1 {
					Warn("critical edge from bb.@ to bb.@ (@ phis)")
						.n(pl.bb.id).n(bb.id).n(n);
				}
				pl = pl.next;
			}
		}
		bl = bl.next;
	}
}

fn number_instructions(bl BlockList) i32 {
	var n i32 = 0;
	while bl != nil {
		var ins Inst = bl.bb.first;
		while ins != nil {
			ins.i = n;
			n++;
			ins = ins.next;
		}
		bl = bl.next;
	}
	return n;
}

fn reg_use(live BitSet, vr i32, i Inst) {
	if vr & VF_SPECIAL { return; }
	live.set(vr);
	if reg_info[vr].inst.x < 0 {
		reg_info[vr].inst.x = i.i;
	}
}

fn reg_def(live BitSet, i Inst) {
	var vr i32 = i.a;
	if vr & VF_SPECIAL { return; }
	live.clear(vr);
}

fn dump_live_set(tag str, live BitSet) {
	live.rewind();
	var n i32 = live.next();
	while n >= 0 {
		Warn("@ @").s(tag).n(n);
		n = live.next();
	}
}

// prereq: instructions must be numbered
fn compute_live_ranges(blist []*BasicBlock, nb i32, nr i32) {
	while nb > 0 {
		nb--;
		var bb BasicBlock = blist[nb];
		Warn("compute-live-range bb.@ @:@")
			.n(bb.id).n(bb.first.i).n(bb.last.i);

		var live BitSet = BitSet_make(nr);
		if bb.next0 && bb.next0.live_in {
			live.union(bb.next0.live_in);
		}
		if bb.next1 && bb.next1.live_in {
			live.union(bb.next1.live_in);
		}
		dump_live_set("live-out", live);
		var i Inst = bb.last;
		while i != nil {
			if i.op & INF_USE_A { reg_use(live, i.a, i); }
			if i.op & INF_USE_B { reg_use(live, i.b, i); }
			if i.op & INF_USE_C { reg_use(live, i.c, i); }
			if i.op & INF_SET_A { reg_def(live, i); }
			i = i.prev;
		}
		dump_live_set("live-in", live);
		bb.live_in = live;
	}
	var n i32 = 0;
	while n < reg_next {
		var i Inst = reg_info[n].inst;
		if i && (i.x >= 0) {
			Warn("live range %@ @:@").n(n).n(i.i).n(i.x);
		}
		n++;
	}
}

fn dump_ir(os OutStream, _bl BlockList, ni i32);

fn finalize_fn(_bl BlockList) {
	// this may insert additional BasicBlocks
	split_critical_edges(_bl);

	// build array of BasicBlocks
	var blist []*BasicBlock = new([bb_order_count]*BasicBlock);
	var n i32 = 0;
	var bl BlockList = _bl;
	while bl != nil {
		blist[n] = bl.bb;
		bl = bl.next;
		n++;
	}

	// place get and set instructions for phis
	phis_to_insts(_bl);

	// remove any instructions with unused results
	var count i32 = 0;
	n = 0;
	while n < reg_next {
		if reg_info[n].used == 0 {
			if reg_info[n].inst {
				inst_remove(reg_info[n].inst);
				reg_info[n].inst = nil;
				count++;
			}
		}
		n++;
	}
	Warn("finalize: removed @ dead instructions").n(count);

	// at this point, count reginfo slots have a nil .inst

	var ni i32 = number_instructions(_bl);

	compute_live_ranges(blist, bb_order_count, reg_next);

	// at this point every instruction referenced via
	// a reginfo slot has a nonzero .i and should have a
	// nonzero .x, representing its live range

	var os OutStream = ctx_make_outfile(true, ctx.curfn, ".ir0");
	if os {
		dump_ir(os, _bl, ni);
		os.close();
	}
}

fn fill(s str, c i32) {
	var i i32 = 0;
	while s[i] {
		if s[i] == ' ' { s[i] = c; }
		i++;
	}
}

fn dump_ir(os OutStream, bl BlockList, ni i32) {
	// start with a blank chart register count wide
	// and instruction count tall
	var art []str = new([ni]str);

	var n i32 = 0;
	while n < ni {
		var s str = new([reg_next + 1]u8);
		var i i32 = 0;
		while i < reg_next {
			s[i] = ' ';
			i++;
		}
		s[i] = 0;
		art[n] = s;
		n++;
	}

	// draw live intervals for each register
	n = 0;
	while n < reg_next {
		var ins Inst = reg_info[n].inst;
		if ins != nil {
			var i i32 = ins.i;
			var dead i32 = ins.x;
			while i <= dead {
				art[i][n] = '|';
				i++;
			}
		}
		n++;
	}

	// for each instruction, write
	// lineno + chart line + disassembly
	n = 0;
	while bl != nil {
		var i Inst = bl.bb.first;
		while i != nil {
			if i.op & INF_IS_LABEL { fill(art[n], '.'); }
			writec(os.fd, '0' + (n / 100) % 10);
			writec(os.fd, '0' + (n / 10) % 10);
			writec(os.fd, '0' + n % 10);
			writec(os.fd, ' ');
			writes(os.fd, art[n]);
			writec(os.fd, ' ');
			inst_disasm(os, i);
			i = i.next;
			n++;
		}
		bl = bl.next;
	}
}

// tools to write textual representations of BasicBlocks and Insts
fn dump_phis(os OutStream, bb BasicBlock) {
	var phi Phi = bb.phi;
	while phi != nil {
		if (phi.count < 1) {
			os.fmt("    .var @").reg(phi.vini);
		} else {
			os.fmt("    .phi @").reg(phi.vini);
		}
		var n i32 = 0;
		while n < phi.count {
			os.fmt(", @").reg(phi.args[n]);
			n++;
		}
		os.fmt(" // @\n").s(phi.sym.name.text);
		phi = phi.next;
	}
}

fn dump_bb(os OutStream, bb BasicBlock) {
	if !(bb.flags & BB_FILLED) {
		Warn("bb.@ is not filled").n(bb.id);
	}
	if !(bb.flags & BB_SEALED) {
		Warn("bb.@ is not sealed").n(bb.id);
	}
	if bb.flags & BB_DEAD {
		return;
	}
	os.fmt("bb.@: // @").n(bb.id).s(bb.tag);
	if bb.prev != nil {
		os.fmt(" << ");
		var bl BlockList = bb.prev;
		while bl != nil {
			os.fmt("bb.@").n(bl.bb.id);
			bl = bl.next;
			if bl != nil {
				os.fmt(", ");
			}
		}
	}
	os.fmt("\n");
	dump_phis(os, bb);
	var ins Inst = bb.first;
	while ins != nil {
		os.fmt("    ");
		inst_disasm(os, ins);
		ins = ins.next;
	}
}

fn dump_bb_list(os OutStream, bl BlockList) {
	while bl != nil {
		dump_bb(os, bl.bb);
		bl = bl.next;
	}
}

// tools to serialize BasicBlocks and DataChunks
var global_ic i32 = 0;

// TODO: make this nondestructive so we can do it
// at multiple stages of optimization, etc
fn serialize_fn(fd i32, blist BlockList) {
	var bl BlockList = blist;
	// count the fn header as an instruction, since it'll be
	// transformed into one on load, but don't include it
	// in the count
	global_ic++;
	var n i32 = global_ic;
	while bl != nil {
		// record the instruction number in each block's label
		bl.bb.first.c = global_ic;
		var inst Inst = bl.bb.first;
		while inst != nil {
			global_ic++;
			inst = inst.next;
		}
		bl = bl.next;
	}

	bl = blist;
	writeu32(fd, TAG_IR_FUNC);
	writeu32(fd, global_ic - n); // ins count
	writeu32(fd, bl.bb.first.b); // global name id
	writeu32(fd, reg_next);      // max virtual reg used
	while bl != nil {
		var inst Inst = bl.bb.first;
		while inst != nil {
			var op u32 = inst.op & INS_OP_MASK;
			// translate bb.ids to instruction numbers via labels
			if op == INS_JUMP {
				inst.a = bb_idx[inst.a].first.c;
			}
			if op == INS_BRANCH {
				inst.b = bb_idx[inst.b].first.c;
				inst.c = bb_idx[inst.c].first.c;
			}
			writeu32(fd, inst.op);
			writeu32(fd, inst.a);
			writeu32(fd, inst.b);
			writeu32(fd, inst.c);
			inst = inst.next;
		}
		bl = bl.next;
	}
}

fn serialize_header(fd i32) {
	writeu32(fd, TAG_IR_XIR0);
	writeu32(fd, 0);
	writeu32(fd, 0);
	writeu32(fd, 0);
}

fn serialize_cdata(fd i32) {
	var sz u32 = (sdata_size + 3) & (~3);
	writeu32(fd, TAG_IR_DATA);
	writeu32(fd, sz >> 2);
	writeu32(fd, -1);
	writeu32(fd, 0);
	var sd StringData = sdata_first;
	while sd != nil {
		write(fd, sd.data.text, 0, sd.data.len + 1);
		sd = sd.next;
	}
	while sz > sdata_size {
		writec(fd, 0);
		sz--;
	}
}

fn serialize_globals(fd i32) {
	var i i32 = 0;
	writeu32(fd, TAG_IR_GLBL);
	writeu32(fd, global_next);
	while i < global_next {
		writeu32(fd, ir_strlen(i));
		i++;
	}
	i = 0;
	while i < global_next {
		write(fd, ir_string(i), 0, ir_strlen(i) + 1);
		i++;
	}
}

fn serialize_data_chunk(fd i32, dc DataChunk) {
	var flags u32 = 0;
	if dc.pmap != nil {
		flags = 1;
	}
	writeu32(fd, TAG_IR_DATA);
	writeu32(fd, dc.count);
	writeu32(fd, dc.id);
	writeu32(fd, flags);
	var n u32 = 0;
	while n < dc.count {
		writeu32(fd, dc.data[n]);
		n++;
	}
	if dc.pmap != nil {
		n = 0;
		while n < dc.count {
			writeu32(fd, dc.pmap[n >> 5]);
			n += 32;
		}
	}
}


fn ir_init() {
	bb_idx = new([1024]*BasicBlock);
	global_names = new([1024]*String);
	reg_info = new([1024]RegInfo);
}

