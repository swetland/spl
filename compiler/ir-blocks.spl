var reg_next i32 = REG_VIRT_0;

// obtain a fresh virtual register
fn ir_reg_get() i32 {
	var r i32 = reg_next;
	reg_next++;
	return r;
}

struct Phi {
	next *Phi,
	sym *Symbol,
	// initial vid
	vini i32,
	// most recent vid
	vcur i32,
	// vids from predecessor blocks
	args []i32,
	count i32,
};

struct BlockList {
	next *BlockList,
	bb *BasicBlock,
};

enum BBFlags {
	// Filled blocks contain all their instructions
	// Filled blocks may provide defs for successors
	// Successors may only be added to Filled blocks
	BB_FILLED = 0x001,

	// Sealed blocks will have no additional successors added
	// Sealed blocks may look up defs in predecessors since
	// they are all known (they must be Filled blocks).
	BB_SEALED = 0x002,

	// no path into this block
	// it is SEALED and has no predecessors
	BB_DEAD =   0x004,

	// block has been placed into the linear instruction stream
	BB_PLACED = 0x008,

	// first and last blocks in a function
	BB_ENTRY =  0x010,
	BB_EXIT =   0x020,

	// general purpose flag
	BB_MARK =   0x800,

};

// TODO alloc at runtime, reduce program size, allow for growth
var bb_next_id i32 = 0;
var bb_idx []*BasicBlock;

var bb_order_first BlockList;
var bb_order_last BlockList;

// target for new instructions
var bb_active BasicBlock = nil;

fn (bb BasicBlock) add_set(shadow i32, reg i32);
fn (bb BasicBlock) add_get(reg i32, shadow i32);

fn phi_lookup(bb BasicBlock, sym Symbol) Phi;

// search a sealed block's predecessors
// for the value(s) for a phi node
fn phi_resolve(bb BasicBlock, phi Phi) {
	Warn("phi_resolve(@,@)").n(bb.id).s(phi.sym.name.text);
	if bb.count == 0 {
		Error("phi_resolve(@) no predecessors?!").n(bb.id);
	}

	var n i32 = 0;
	var args []i32 = __new(4 * bb.count);
	var bl BlockList = bb.prev;
	while bl != nil {
		var p Phi = phi_lookup(bl.bb, phi.sym);
		args[n] = p.vcur;
		n++;
		bl.bb.add_set(phi.vini, p.vcur);
		bl = bl.next;
	}
	phi.args = args;
	phi.count = bb.count;

	// simplify node if trivial
}

// search any block for a phi node for a symbol,
// creating one if necessary, and recursing if sealed
fn phi_lookup(bb BasicBlock, sym Symbol) Phi {
	// first check for an existing phi node
	var phi Phi = bb.phi;
	while phi != nil {
		if phi.sym == sym {
			Warn("phi_lookup(@,@) cached").n(bb.id).s(sym.name.text);
			return phi;
		}
		phi = phi.next;
	}

	// otherwise create a new phi node
	phi = new(Phi);
	phi.sym = sym;
	phi.next = bb.phi;
	bb.phi = phi;
	phi.args = nil;
	phi.count = 0;

	if bb.flags & BB_ENTRY {
		// special case for the function entry block
		Warn("phi_lookup(@,@) entry").n(bb.id).s(sym.name.text);
		phi.vini = sym.vid;
		phi.vcur = sym.vid;
		return phi;
	}

	phi.vini = ir_reg_get();
	phi.vcur = phi.vini;

	bb.add_get(phi.vini, phi.vini);

	if bb.flags & BB_SEALED {
		// sealed block so we can search our predecessors
		Warn("phi_lookup(@,@) recurse").n(bb.id).s(sym.name.text);
		phi_resolve(bb, phi);
	} else {
		// unsealed block, so we install a placeholder
		Warn("phi_lookup(@,@) defer").n(bb.id).s(sym.name.text);
	}
	return phi;
}

fn sym_to_vid_load(sym Symbol) i32 {
	Warn("sym_to_vid(@) ?").s(sym.name.text);
	var phi Phi = phi_lookup(bb_active, sym);
	Warn("sym_load(@) @, @").s(sym.name.text).reg(phi.vini).reg(phi.vcur);
	return phi.vcur;
}

fn sym_to_vid_store(sym Symbol) i32 {
	Warn("sym_to_vid(@) ?").s(sym.name.text);
	var phi Phi = phi_lookup(bb_active, sym);
	var old i32 = phi.vcur;
	phi.vcur = ir_reg_get();
	Warn("sym_store(@) @, @ > @").s(sym.name.text).reg(phi.vini).reg(old).reg(phi.vcur);
	return phi.vcur;
}

// reset all global state
// used at the start of a new function
fn bb_reset() {
	reg_next = REG_VIRT_0;
	bb_next_id = 0;
	bb_active = nil;
	bb_order_first = nil;
	bb_order_last = nil;
}

fn (bb BasicBlock) append(ins Inst);

fn bb_make(tag str) BasicBlock {
	var bb BasicBlock = new(BasicBlock);
	bb.id = bb_next_id;
	bb.tag = tag;
	bb_next_id++;
	bb_idx[bb.id] = bb;
	Warn("make bb.@: @ @").n(bb.id).s(tag).x(bb);
	bb.append(_inst_make(INS_LABEL, bb.id, 0, 0));
	return bb;
}

fn (bb BasicBlock) add_set(shadow i32, reg i32) {
	var inst Inst = _inst_make(INS_SET, shadow, reg, 0);
	inst.prev = bb.last.prev;
	inst.next = bb.last;
	inst.prev.next = inst;
	inst.next.prev = inst;
}

fn (bb BasicBlock) add_get(reg i32, shadow i32) {
	var inst Inst = _inst_make(INS_GET, reg, shadow, 0);
	inst.prev = bb.first;
	inst.next = bb.first.next;
	inst.prev.next = inst;
	if inst.next {
		inst.next.prev = inst;
	} else {
		bb.last = inst;
	}
}

fn (bb BasicBlock) place() {
	if bb.flags & BB_PLACED {
		Error("bb.@ placed twice").n(bb.id);
	}
	bb.flags |= BB_PLACED;
	var bl BlockList = new(BlockList);
	bl.bb = bb;
	if bb_order_last == nil {
		bb_order_first = bl;
	} else {
		bb_order_last.next = bl;
	}
	bb_order_last = bl;
}

fn (bb BasicBlock) link_to(target BasicBlock) {
	if target.flags & BB_SEALED {
		Warn("cannot link bb.@ to sealed bb.@").n(bb.id).n(target.id);
	}
	if bb.next0 == nil {
		bb.next0 = target;
	} else {
		bb.next1 = target;
	}
	var bl BlockList = new(BlockList);
	bl.bb = bb;
	bl.next = target.prev;
	target.prev = bl;
	target.count++;
}

fn (bb BasicBlock) append(ins Inst) {
	if bb.flags & BB_FILLED {
		//Warn("cannot add instructions to filled bb.@").n(bb.id);
		//Warn("discarding: @").ins(ins);
		return;
	}
	if bb.last == nil {
		ins.prev = nil;
		bb.first = ins;
	} else {
		ins.prev = bb.last;
		bb.last.next = ins;
	}
	bb.last = ins;
	ins.next = nil;
	if ins.op & INF_IS_EOBB {
		bb.flags |= BB_FILLED;
		if ins.op & INF_IS_B_U {
			bb.link_to(bb_idx[ins.a]);
		}
		if ins.op & INF_IS_B_C {
			bb.link_to(bb_idx[ins.b]);
			bb.link_to(bb_idx[ins.c]);
		}
	}
}

fn (bb BasicBlock) seal() {
	if bb.flags & BB_SEALED {
		Error("bb.@ sealed twice").n(bb.id);
	}
	bb.flags |= BB_SEALED;
	if bb.prev == nil {
		if !(bb.flags & BB_ENTRY) {
			bb.flags |= BB_DEAD;
			Warn("bb.@ is dead").n(bb.id);
		}
	}
	var bl BlockList = bb.prev;
	while bl != nil {
		if !(bl.bb.flags & BB_FILLED) {
			Error("bb.@ sealed, but pred bb.@ is not filled").n(bb.id).n(bl.bb.id);
		}
		bl = bl.next;
	}
	var phi Phi = bb.phi;
	while phi != nil {
		if phi.count == 0 {
			Warn("phi_lookup(@) post-seal").n(bb.id);
			phi_resolve(bb, phi);
		}
		phi = phi.next;
	}
}

// terminate the current bb with a jump to this
// one and make it active for accumulating instructions
fn (bb BasicBlock) _activate(seal_prev bool) {
	if bb_active != nil {
		if !(bb_active.flags & BB_FILLED) {
			if !(bb_active.flags & BB_DEAD) {
				inst_jump(bb);
				Warn("bb.@ chained to bb.@").n(bb_active.id).n(bb.id);
			}
		}
		if seal_prev {
			if !(bb_active.flags & BB_SEALED) {
				bb_active.seal();
			}
		}
	}
	bb_active = bb;
	// housekeeping
}

fn (bb BasicBlock) activate() {
	bb._activate(false);
}

fn (bb BasicBlock) activate_and_seal_prev() {
	bb._activate(true);
}

fn (bb BasicBlock) set_name(name String) {
	bb.first.b = ir_string_get(name);
}

// allocate an instruction and add it to the graph
fn inst_make(op u32, a i32, b i32, c i32) i32 {
	var ins Inst = _inst_make(op, a, b, c);
	bb_active.append(ins);
	return a;
}

var global_next i32 = 0;
var global_names []*String;

// obtain a string identifier for call instruction use
fn ir_string_get(name String) i32 {
	var n i32 = 0;
	while n < global_next {
		if global_names[n] == name {
			return n;
		}
		n++;
	}
	global_next = n + 1;
	global_names[n] = name;
	Warn("name @ '@'").n(n).s(name.text);
	return n;
}

fn ir_string(id i32) str {
	if id >= global_next {
		Error("invalid string id");
	}
	return global_names[id].text;
}

fn ir_strlen(id i32) u32 {
	if id >= global_next {
		Error("invalid string id");
	}
	return global_names[id].len;
}

// tools to write textual representations of BasicBlocks and Insts
fn dump_phis(os OutStream, bb BasicBlock, graph bool) {
	var tag str = "    phi @";
	if bb.flags & BB_ENTRY {
		tag = "    ini @";
	}
	var phi Phi = bb.phi;
	while phi != nil {
		if graph {
			os.fmt("<TR><TD ALIGN=\"left\">");
		}
		os.fmt(tag).reg(phi.vini);
		var n i32 = 0;
		while n < phi.count {
			os.fmt(", @").reg(phi.args[n]);
			n++;
		}
		os.fmt(" // @\n").s(phi.sym.name.text);
		if graph {
			os.fmt("</TD></TR>\n");
		}
		phi = phi.next;
	}
}

fn dump_bb(os OutStream, bb BasicBlock, graph bool) {
	if !(bb.flags & BB_FILLED) {
		Warn("bb.@ is not filled").n(bb.id);
	}
	if !(bb.flags & BB_SEALED) {
		Warn("bb.@ is not sealed").n(bb.id);
	}
	if bb.flags & BB_DEAD {
		if graph {
			os.fmt("\"bb.@\" [ style=invis ];\n").n(bb.id);
		}
		return;
	}
	if graph {
		if false {
		var bl BlockList = bb.prev;
		while bl != nil {
			os.fmt("\"bb.@\":sw -> \"bb.@\":ne [ constraint=false; ];\n").n(bl.bb.id).n(bb.id);
			bl = bl.next;
		}
		}
		os.fmt("\"bb.@\" [ label=<<TABLE BORDER=\"0\" CELLBORDER=\"1\" CELLSPACING=\"0\">\n").n(bb.id);
		os.fmt("<TR><TD BGCOLOR=\"gray\" ALIGN=\"left\">bb.@: @</TD></TR>\n").n(bb.id).s(bb.tag);
	} else {
		os.fmt("bb.@: // @").n(bb.id).s(bb.tag);
		if bb.prev != nil {
			os.fmt(" << ");
			var bl BlockList = bb.prev;
			while bl != nil {
				os.fmt("bb.@").n(bl.bb.id);
				bl = bl.next;
				if bl != nil {
					os.fmt(", ");
				}
			}
		}
		os.fmt("\n");
	}
	dump_phis(os, bb, graph);
	var ins Inst = bb.first;
	while ins != nil {
		if graph {
			os.fmt("<TR><TD ALIGN=\"left\">");
		}
		inst_disasm(os, ins);
		if graph {
			os.fmt("</TD></TR>\n");
		}
		ins = ins.next;
	}
	if graph {
		os.fmt("</TABLE>>; ];\n");
		if bb.next0 {
			os.fmt("\"bb.@\":sw -> \"bb.@\":nw [ constraint=false; ];\n").n(bb.id).n(bb.next0.id);
		}
		if bb.next1 {
			os.fmt("\"bb.@\":se -> \"bb.@\":ne [ constraint=false; ];\n").n(bb.id).n(bb.next1.id);
		}
	}
}

fn dump_bb_list(os OutStream, bl BlockList, graph bool) {
	if graph {
		os.fmt("digraph g {\n");
		os.fmt("node [ shape=plain; ];\n");
	}
	while bl != nil {
		if graph && (bl.next != nil) {
			os.fmt("\"bb.@\" -> \"bb.@\" [ style=invis ];\n").n(bl.bb.id).n(bl.next.bb.id);
		}
		dump_bb(os, bl.bb, graph);
		bl = bl.next;
	}
	if graph {
		os.fmt("}\n");
	}
}

// tools to serialize BasicBlocks and DataChunks
var global_ic i32 = 0;

// TODO: make this nondestructive so we can do it
// at multiple stages of optimization, etc
fn serialize_fn(fd i32, blist BlockList) {
	var bl BlockList = blist;
	// count the fn header as an instruction, since it'll be
	// transformed into one on load, but don't include it
	// in the count
	global_ic++;
	var n i32 = global_ic;
	while bl != nil {
		// record the instruction number in each block's label
		bl.bb.first.c = global_ic;
		var inst Inst = bl.bb.first;
		while inst != nil {
			global_ic++;
			inst = inst.next;
		}
		bl = bl.next;
	}

	bl = blist;
	writeu32(fd, TAG_IR_FUNC);
	writeu32(fd, global_ic - n); // ins count
	writeu32(fd, bl.bb.first.b); // global name id
	writeu32(fd, reg_next);      // max virtual reg used
	while bl != nil {
		var inst Inst = bl.bb.first;
		while inst != nil {
			var op u32 = inst.op & INS_OP_MASK;
			// translate bb.ids to instruction numbers via labels
			if op == INS_JUMP {
				inst.a = bb_idx[inst.a].first.c;
			}
			if op == INS_BRANCH {
				inst.b = bb_idx[inst.b].first.c;
				inst.c = bb_idx[inst.c].first.c;
			}
			writeu32(fd, inst.op);
			writeu32(fd, inst.a);
			writeu32(fd, inst.b);
			writeu32(fd, inst.c);
			inst = inst.next;
		}
		bl = bl.next;
	}
}

fn serialize_header(fd i32) {
	writeu32(fd, TAG_IR_XIR0);
	writeu32(fd, 0);
	writeu32(fd, 0);
	writeu32(fd, 0);
}

fn serialize_globals(fd i32) {
	var i i32 = 0;
	writeu32(fd, TAG_IR_GLBL);
	writeu32(fd, global_next);
	while i < global_next {
		writeu32(fd, ir_strlen(i));
		i++;
	}
	i = 0;
	while i < global_next {
		write(fd, ir_string(i), 0, ir_strlen(i) + 1);
		i++;
	}
}

fn serialize_data_chunk(fd i32, dc DataChunk) {
	writeu32(fd, TAG_IR_DATA);
	writeu32(fd, dc.count);
	writeu32(fd, dc.id);
	writeu32(fd, 0);
	var n u32 = 0;
	while n < dc.count {
		writeu32(fd, dc.data[n]);
		n++;
	}
	n = 0;
	while n < dc.count {
		writeu32(fd, dc.pmap[n]);
		n += 32;
	}
}


fn ir_init() {
	bb_idx = new([1024]*BasicBlock);
	global_names = new([1024]*String);
}

