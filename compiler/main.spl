var indent u32 = 0;

fn print_indent(fd i32) {
	var n u32 = 0;
	while n < indent {
		writes(fd, "   ");
		n++;
	}
}

fn print_type(fd i32, type Type) {
	if type.kind == TYPE_POINTER {
		writes(fd, "*");
		type = type.of;
	}
	if type.kind == TYPE_ARRAY {
		writes(fd, "[]");
		type = type.of;
	}
	writes(fd, type.name.text);
}

fn dump_ast_node(fd i32, node Ast);

fn _dump_ast_node(fd i32, node Ast) {
	var kind AstKind = node.kind;

	print_indent(fd);
	writes(fd, ast_kind[kind]);
	writes(fd, " ");
	indent++;
	if kind == AST_CONST {
		writex(fd, node.ival);
	} else if kind == AST_FUNC {
		writes(fd, node.name.text);
		writes(fd, "(");
		var param Symbol = node.sym.type.list;
		while param != nil {
			writes(fd, param.name.text);
			if param.next != nil {
				writes(fd, ", ");
			}
			param = param.next;
		}
		writes(fd, ") ");
		writes(fd, node.sym.type.of.name.text);
	} else if kind == AST_BLOCK {
		writes(fd, "(");
		var sym Symbol = node.sym;
		while sym != nil {
			writes(fd, sym.name.text);
			if sym.next != nil {
				writes(fd, ", ");
			}
			sym = sym.next;
		}
		writes(fd, ") ");
	} else if kind == AST_STRING {
		printstr(fd, node.name.text);
	} else if kind == AST_SYMBOL {
		writes(fd, node.name.text);
	} else if kind == AST_NEW {
		print_type(fd, node.type);
	}
	if node.type != nil {
		writes(fd, " [");
		print_type(fd, node.type);
		writes(fd, "]");
	}
	//writes(fd, " #");
	//writei(fd, node.srcloc & 0x000FFFFF);

	writes(fd, "\n");

	dump_ast_node(fd, node.left);
	dump_ast_node(fd, node.right);
	indent = indent - 1;
}

fn dump_ast_node(fd i32, node Ast) {
	if node != nil {
		while true {
			_dump_ast_node(fd, node);
			node = node.next;
			if node == nil {
				break;
			}
		}
	}
}

fn dump_types(fd i32) {
	var type Type = ctx.typelist;
	while type != nil {
		writes(fd, type.name.text);
		writes(fd, ": ");
		writei(fd, type_size(type));
		writes(fd, "\n");
		if type.kind == TYPE_STRUCT {
			var sym Symbol = type.list;
			while sym != nil {
				writes(fd, "    ");
				writes(fd, sym.name.text);
				writes(fd, ": ");
				writei(fd, sym.ival);
				writes(fd, "\n");
				sym = sym.next;
			}
		}
		type = type.next;
	}
}


fn start() i32 {
	ctx_init();
	parse_init();
	var astfd i32 = -1;
	var outfd i32 = 1;

	var n u32 = 0;
	while n < os_arg_count() {
		var arg str = os_arg(n);
		if streq(arg, "-ast") {
			n++;
			arg = os_arg(n);
			astfd = fd_create(arg);
			if astfd == -1 {
				Error("cannot open AST list file '@'").s(arg);
			}
			n++;
			continue;
		}
		if streq(arg, "-out") {
			n++;
			arg = os_arg(n);
			outfd = fd_create(arg);
			if outfd == -1 {
				Error("cannot open output file '@'").s(arg);
			}
			n++;
			continue;
		}
		if arg[0] == '-' {
			Error("unsupported option '@'").s(arg);
		}
		ctx.fd_in = fd_open(arg);
		if ctx.fd_in == -1 {
			Error("cannot open '@'").s(arg);
		}
		ctx_set_source_file(arg);

		scan();
		next();
		parse_program();

		fd_close(ctx.fd_in);
		ctx.fd_in = -1;

		n++;
	}

	if astfd != -1 {
		dump_ast_node(astfd, ctx.program);
		dump_types(astfd);
	}
	if outfd != -1 {
		gen(outfd, ctx.program.left);
	}
	return 0;
}

