var indent u32 = 0;

fn print_indent(fd i32) {
	var n u32 = 0;
	while n < indent {
		writes(fd, "   ");
		n++;
	}
}

fn print_type(fd i32, type Type) {
	while true {
		if type == ctx.type_str {
			writes(fd, type.name.text);
			return;
		} else if type.kind == TYPE_POINTER {
			writes(fd, "*");
			type = type.of;
		} else if type.kind == TYPE_ARRAY {
			writes(fd, "[");
			if type.count { writei(fd, type.count); }
			writes(fd, "]");
			type = type.of;
		} else {
			break;
		}
	}
	writes(fd, type.name.text);
}

fn dump_ast_node(fd i32, node Ast);

fn _dump_ast_node(fd i32, node Ast) {
	var kind AstKind = node.kind;

	print_indent(fd);
	writes(fd, ast_kind[kind]);
	writes(fd, " ");
	indent++;
	if kind == AST_CONST {
		writex(fd, node.ival);
	} else if kind == AST_FUNC {
		writes(fd, node.sym.name.text);
		writes(fd, "(");
		var param Symbol = node.sym.type.list;
		while param != nil {
			writes(fd, param.name.text);
			if param.next != nil {
				writes(fd, ", ");
			}
			param = param.next;
		}
		writes(fd, ") ");
		writes(fd, node.sym.type.of.name.text);
	} else if kind == AST_BLOCK {
		writes(fd, "(");
		var sym Symbol = node.sym;
		while sym != nil {
			writes(fd, sym.name.text);
			if sym.next != nil {
				writes(fd, ", ");
			}
			sym = sym.next;
		}
		writes(fd, ") ");
	} else if kind == AST_STRING {
		printstr(fd, node.sval.text);
	} else if kind == AST_SYMBOL {
		writes(fd, node.sym.name.text);
	} else if kind == AST_NEW {
		print_type(fd, node.type);
	}
	if node.type != nil {
		writes(fd, " [");
		print_type(fd, node.type);
		writes(fd, "]");
	}
	//writes(fd, " #");
	//writei(fd, node.srcloc & 0x000FFFFF);

	writes(fd, "\n");

	dump_ast_node(fd, node.left);
	dump_ast_node(fd, node.right);
	indent = indent - 1;
}

fn dump_ast_node(fd i32, node Ast) {
	if node != nil {
		while true {
			_dump_ast_node(fd, node);
			node = node.next;
			if node == nil {
				break;
			}
		}
	}
}

fn dump_type(os OutStream, type Type) {
	if type.kind == TYPE_FN { return; }
	FmtLn(os,"@: sz=@").t(type).n(type_size(type));
	if type.kind == TYPE_STRUCT {
		var sym Symbol = type.list;
		while sym != nil {
			FmtLn(os, "    @: @ off=@").s(sym.name.text).t(sym.type).n(sym.ival);
			sym = sym.next;
		}
	}
}

fn dump_types(fd i32) {
	var os OutStream = OutFd(fd);
	var type Type = ctx.typelist;
	while type != nil {
		dump_type(os, type);
		type = type.next;
	}
}

fn start() i32 {
	ctx_init();
	parse_init();
	var astfd i32 = -1;
	var outfd i32 = 1;
	var stats i32 = 0;
	var err OutStream = OutFd(2);

	var n u32 = 0;
	while n < os_arg_count() {
		var arg str = os_arg(n);
		n++;
		if streq(arg, "-stats") {
			stats = 1;
			continue;
		}
		if streq(arg, "-dot") {
			ctx.with_graphs = true;
			continue;
		}
		if streq(arg, "-ir") {
			ctx.with_ir = true;
			continue;
		}
		if streq(arg, "-ast") {
			arg = os_arg(n);
			n++;
			astfd = fd_create(arg);
			if astfd == -1 {
				Error("cannot open AST list file '@'").s(arg);
			}
			ctx.out_base = arg;
			continue;
		}
		if streq(arg, "-out") {
			arg = os_arg(n);
			n++;
			outfd = fd_create(arg);
			if outfd == -1 {
				Error("cannot open output file '@'").s(arg);
			}
			continue;
		}
		if arg[0] == '-' {
			Error("unsupported option '@'").s(arg);
		}
		ctx.fd_in = fd_open(arg);
		if ctx.fd_in == -1 {
			Error("cannot open '@'").s(arg);
		}
		ctx_set_source_file(arg);

		scan();
		next();
		parse_program();

		fd_close(ctx.fd_in);
		ctx.fd_in = -1;
	}

	if astfd != -1 {
		dump_ast_node(astfd, ctx.program);
		dump_types(astfd);
	}
	if outfd != -1 {
		gen(outfd, ctx.program.left);
	}

	if stats {
		var gsc i32 = 0;
		var sym Symbol = ctx.global.first;
		while sym != nil {
			sym = sym.next;
			gsc++;
		}
		FmtLn(err, "alloc count:  @").n(__alloc_count);
		FmtLn(err, "alloc bytes:  @").n(__alloc_bytes);
		FmtLn(err, "alloc string: @").n(__alloc_string);
		FmtLn(err, "alloc scope:  @").n(__alloc_scope);
		FmtLn(err, "alloc symbol: @").n(__alloc_symbol);
		FmtLn(err, "alloc type:   @").n(__alloc_type);
		FmtLn(err, "alloc node:   @").n(__alloc_node);
		FmtLn(err, "find string:  @").n(__lookup_string);
		FmtLn(err, "find symbol:  @").n(__lookup_symbol);
		FmtLn(err, "find global:  @").n(__lookup_global);
		FmtLn(err, "global syms:  @").n(gsc);
	}
	return 0;
}

