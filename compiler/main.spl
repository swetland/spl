fn print_indent(fd i32, indent i32) {
	var n i32 = 0;
	while n < indent {
		writes(fd, "   ");
		n++;
	}
}

fn print_type(fd i32, type Type);

fn print_fn_type(fd i32, type Type) {
	writes(fd, "(");
	var param Symbol = type.list;
	while param != nil {
		writes(fd, param.name.text);
		writes(fd, " ");
		print_type(fd, param.type);
		if param.next != nil {
			writes(fd, ", ");
		}
		param = param.next;
	}
	writes(fd, ") ");
	print_type(fd, type.of);
}

fn print_type(fd i32, type Type) {
	while true {
		if type == ctx.type_str {
			writes(fd, type.name.text);
			return;
		} else if type.kind == TYPE_POINTER {
			writes(fd, "*");
			type = type.of;
		} else if type.kind == TYPE_ARRAY {
			writes(fd, "[");
			if type.count { writeu(fd, type.count); }
			writes(fd, "]");
			type = type.of;
		} else if type.kind == TYPE_FN {
			writes(fd, "fn");
			print_fn_type(fd, type);
			return;
		} else if type.kind == TYPE_ANON {
			writes(fd, "$");
			break;
		} else {
			break;
		}
	}
	writes(fd, type.name.text);
}

fn dump_ast_nodes(fd i32, node Ast, indent i32);

fn dump_ast_node(fd i32, node Ast, indent i32) {
	var kind AstKind = node.kind;

	if kind == AST_FUNC {
		//writes(fd, "\n// ");
		//print_srcloc(fd, node.srcloc);
		writes(fd, "\n");
	}

	print_indent(fd, indent);
	writes(fd, ast_kind[kind]);
	indent++;
	if kind == AST_CONST {
		writes(fd, " ");
		writex(fd, node.ival);
	} else if kind == AST_FUNC {
		writes(fd, " ");
		writes(fd, node.sym.name.text);
		print_fn_type(fd, node.sym.type);
	} else if kind == AST_BLOCK {
		writes(fd, " (");
		var sym Symbol = node.sym;
		while sym != nil {
			writes(fd, sym.name.text);
			if sym.next != nil {
				writes(fd, ", ");
			}
			sym = sym.next;
		}
		writes(fd, ")");
	} else if kind == AST_STRING {
		writes(fd, " ");
		printstr(fd, node.sval.text);
	} else if kind == AST_NEW {
		writes(fd, " ");
		print_type(fd, node.type);
	} else {
		if node.sym {
			writes(fd, " ");
			writes(fd, node.sym.name.text);
		}
	}
	if (node.type != nil) && (kind != AST_FUNC) {
		writes(fd, " ");
		print_type(fd, node.type);
	}
	writes(fd, "\n");

	dump_ast_nodes(fd, node.left, indent);
	dump_ast_nodes(fd, node.right, indent);
	indent--;
}

fn dump_ast_nodes(fd i32, node Ast, indent i32) {
	while node != nil {
		dump_ast_node(fd, node, indent);
		node = node.next;
	}
}

fn dump_type(os OutStream, type Type) {
	if type.kind == TYPE_FN { return; }
	FmtLn(os,"@: sz=@").t(type).u(type_size(type));
	if type.kind == TYPE_STRUCT {
		var sym Symbol = type.list;
		while sym != nil {
			FmtLn(os, "    @: @ off=@").s(sym.name.text).t(sym.type).u(sym.ival);
			sym = sym.next;
		}
	}
}

fn dump_types(fd i32) {
	var os OutStream = OutFd(fd);
	var type Type = ctx.typelist;
	while type != nil {
		dump_type(os, type);
		type = type.next;
	}
}

fn start() i32 {
	ctx_init();
	parse_init();
	var ptfd i32 = -1;
	var astfd i32 = -1;
	var outfd i32 = 1;
	var stats i32 = 0;
	var err OutStream = OutFd(2);

	var n u32 = 0;
	while n < os_arg_count() {
		var arg str = os_arg(n);
		n++;
		if streq(arg, "-stats") {
			stats = 1;
			continue;
		}
		if streq(arg, "-ir") {
			ctx.options |= OPT_WITH_IR;
			continue;
		}
		if streq(arg, "-panic") {
			ctx.options |= OPT_PANIC_ON_ERROR;
			continue;
		}
		if streq(arg, "-pt") {
			arg = os_arg(n);
			n++;
			ptfd = fd_create(arg);
			if ptfd == -1 {
				Error("cannot open parse tree list file '@'").s(arg);
			}
			ctx.out_base = arg;
			continue;
		}
		if streq(arg, "-ast") {
			arg = os_arg(n);
			n++;
			astfd = fd_create(arg);
			if astfd == -1 {
				Error("cannot open AST list file '@'").s(arg);
			}
			ctx.out_base = arg;
			continue;
		}
		if streq(arg, "-out") {
			arg = os_arg(n);
			n++;
			outfd = fd_create(arg);
			if outfd == -1 {
				Error("cannot open output file '@'").s(arg);
			}
			continue;
		}
		if arg[0] == '-' {
			Error("unsupported option '@'").s(arg);
		}
		ctx.fd_in = fd_open(arg);
		if ctx.fd_in == -1 {
			Error("cannot open '@'").s(arg);
		}
		ctx_set_source_file(arg);

		scan();
		next();
		parse_program();

		fd_close(ctx.fd_in);
		ctx.fd_in = -1;
	}

	// gen() may want to generate debug files
	// trim the extension from the output file base name
	// so that these debug files have nicer looking names
        if ctx.out_base != nil {
                var s str = ctx.out_base;
                var i u32 = 0;
                var len u32 = strlen(s);
                while i < len {
                        if s[i] == '.' {
                                s[i] = 0;
                                break;
                        }
                        i++;
                }
        }

	if ptfd != -1 {
		dump_ast_nodes(ptfd, ctx.program.left, -1);
		writes(ptfd, "\n");
		dump_types(ptfd);
	}
	validate(ctx.program.left);

	if astfd != -1 {
		dump_ast_nodes(astfd, ctx.program.left, -1);
		writes(astfd, "\n");
		dump_types(astfd);
	}

	if outfd != -1 {
		gen(outfd, ctx.program.left);
	}

	if stats {
		var gsc u32 = 0;
		var sym Symbol = ctx.global.first;
		while sym != nil {
			sym = sym.next;
			gsc++;
		}
		FmtLn(err, "alloc count:  @").u(sys_get_alloc_count());
		FmtLn(err, "alloc bytes:  @").u(sys_get_alloc_bytes());
		FmtLn(err, "alloc string: @").u(__alloc_string);
		FmtLn(err, "alloc scope:  @").u(__alloc_scope);
		FmtLn(err, "alloc symbol: @").u(__alloc_symbol);
		FmtLn(err, "alloc type:   @").u(__alloc_type);
		FmtLn(err, "alloc node:   @").u(__alloc_node);
		FmtLn(err, "find string:  @").u(__lookup_string);
		FmtLn(err, "find symbol:  @").u(__lookup_symbol);
		FmtLn(err, "find global:  @").u(__lookup_global);
		FmtLn(err, "global syms:  @").u(gsc);
	}
	return 0;
}

