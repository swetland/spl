// Shared code for managing data chunks

enum DataChunkKind {
	DATA_U8,
	DATA_U32,
	DATA_PTR,
};

struct DataChunk {
	next *DataChunk,
	data *[]u32,
	pmap *[]u32,
	kind u32,
	count u32,
	id u32,
};

fn emit_data_chunk(dc DataChunk);

var data_id u32 = 0;
var data_first DataChunk = nil;
var data_last DataChunk = nil;

fn make_data_chunk(kind u32, n u32) DataChunk {
	var dc DataChunk = new(DataChunk);
	if kind == DATA_U8 {
		// bytecount to wordcount, rounding up
		n = (n + 3) >> 2;
	} else {
		// allocate a pointer map
		dc.pmap = new([(n + 31) >> 5]u32);
	}
	dc.next = nil;
	dc.data = new([n]u32);
	dc.kind = kind;
	dc.count = n;
	dc.id = data_id;
	if data_last == nil {
		data_first = dc;
	} else {
		data_last.next = dc;
	}
	data_last = dc;
	data_id++;
	return dc;
}

fn write_data_chunk(dc DataChunk, idx u32, val u32, is_ptr bool) {
	if dc.kind == DATA_U8 {
		val = (val & 0xFF) << ((idx & 3) * 8);
		dc.data[idx >> 2] |= val;
	} else {
		dc.data[idx] = val;
		if is_ptr {
			dc.pmap[idx >> 5] |= 1u << (idx & 31);
		}
	}
}

fn make_string_chunk(s str) u32 {
	var len u32 = strlen(s);
	// include terminator \0
	var dc DataChunk = make_data_chunk(DATA_U8, len + 1);
	var n u32 = 0;
	while n < len {
		write_data_chunk(dc, n, s[n], false);
		n++;
	}
	return dc.id;
}

fn emit_data_chunks() {
	var dc DataChunk = data_first;
	while dc != nil {
		emit_data_chunk(dc);
		dc = dc.next;
	}
	data_first = nil;
	data_last = nil;
}

fn gen_global_addrs(node Ast) {
	var n u32 = 0;
	while node != nil {
		if node.kind == AST_ASSIGN {
			var sym Symbol = node.left.sym;
			sym.ival = n;
			n += 4;
		}
		node = node.next;
	}
}

fn gen_global_array_init(node Ast) u32 {
	var kind DataChunkKind = DATA_U32;
	if node.kind == AST_STRING {
		return make_string_chunk(node.sval.text);
	}
	var sz u32 = node.ival;
	if node.kind == AST_ARRAY {
		var tsz u32 = type_size(node.type);
		if node.type.kind == TYPE_POINTER {
			kind = DATA_PTR;
		} else if type_size(node.type) == 1 {
			kind = DATA_U8;
		} else {
			sz = sz * tsz / 4;
		}
	} else {
		ErrorAt(node, "illegal array init");
	}
	var dc DataChunk = make_data_chunk(kind, sz);
	node = node.left;
	var n u32 = 0;
	while node != nil {
		//TODO: advance by stride
		if kind == DATA_PTR {
			write_data_chunk(dc, n, gen_global_array_init(node), true);
		} else {
			write_data_chunk(dc, n, eval_const_expr(node), false);
		}
		node = node.next;
		n++;
	}
	return dc.id;
}

fn gen_global_data(all Ast) {
	var node Ast = all;
	var n u32 = 0;
	while node != nil {
		if node.kind == AST_ASSIGN {
			n++;
		}
		node = node.next;
	}
	if n == 0 {
		return;
	}
	var dc DataChunk = make_data_chunk(DATA_U32, n);
	node = all;
	n = 0;
	while node != nil {
		if node.kind == AST_ASSIGN {
			var sym Symbol = node.left.sym;
			// global word: sym.name.text
			if node.right.kind == AST_STRING {
				var id u32 = make_string_chunk(node.right.sval.text);
				write_data_chunk(dc, n, id, true);
			} else if node.right.kind == AST_ARRAY {
				var id u32 = gen_global_array_init(node.right);
				write_data_chunk(dc, n, id, true);
			} else if node.right.kind == AST_ASSIGN {
				ErrorAt(node, "global struct init unsupported");
			} else {
				var val u32 = eval_const_expr(node.right);
				write_data_chunk(dc, n, val, false);
			}
			n++;
		}
		node = node.next;
	}
}

struct StringData {
	next *StringData,
	data *String,
};

var sdata_first StringData = nil;
var sdata_last StringData = nil;
var sdata_size u32 = 0;

fn make_cdata_str(s String) u32 {
	var off u32 = sdata_size;
	var sd StringData = new(StringData);
	sd.next = nil;
	sd.data = s;
	if sdata_last == nil {
		sdata_first = sd;
	} else {
		sdata_last.next = sd;
	}
	sdata_last = sd;
	sdata_size += s.len + 1;
	return off;
}
