var os OutStream;

fn emit(msg str) OutStream {
	os.msg = msg;
	os.idx = 0;
	os_advance(os);
	return os;
}

fn GenError(node Ast, msg str) OutStream {
	writes(2, "\n");
	print_srcloc(2, node.srcloc);
	writes(2, ": error: ");
	return make_OutStream(msg, 2, true, nil);
}

// ----

var func_exit BasicBlock = nil;
var func_type Type = nil;
var loop_exit BasicBlock = nil;
var loop_cont BasicBlock = nil;

fn gen_expr(node Ast) i32;

fn gen_relop(node Ast, op IRop) i32 {
	return inst_alu(op, gen_expr(node.left), gen_expr(node.right));
}

fn gen_binop(node Ast, op IRop) i32 {
	return inst_alu(op, gen_expr(node.left), gen_expr(node.right));
}

fn gen_unop(node Ast, op IRop) i32 {
	return inst_alu(op, gen_expr(node.left), 0);
}

fn gen_bool_not(node Ast) i32 {
	return inst_alui(INS_CMP_EQ, gen_expr(node.left), 0);
}

fn gen_load(node Ast) i32 {
	var sym Symbol = node.sym;
	if sym.kind & SYMBOL_DEF {
		return inst_movi(sym.ival);
	}
	if sym.kind & SYMBOL_GLOBAL {
		inst_ldwi(REG_GP, sym.ival);
	}
	// param or local
	return node.sym.vid;
}

fn gen_store(sym Symbol, val i32) i32 {
	if sym.kind & SYMBOL_GLOBAL {
		return inst_stwi(val, REG_GP, sym.ival);
	}
	var vid i32 = sym.vid;
	sym.vid = inst_mov(val);
	if vid >= 0 {
		Warn("mutating @: @ to @").s(sym.name.text).reg(vid).reg(sym.vid);
	}
	return sym.vid;
}

fn gen_assign(node Ast) i32 {
	if node.left.kind == AST_SYMBOL {
		gen_store(node.left.sym, gen_expr(node.right));
	} else {
		GenError(node, "unsupported assignment");
	}
}

fn gen_call(fcall Ast) i32 {
	var sym Symbol = fcall.left.sym;
	if sym == nil {
		// TODO: should be impossible
		GenError(fcall, "calling undefined function");
	}

	inst_aluix(INS_SUB, REG_SP, REG_SP, sym.type.count * 4);
	var n i32 = 0;
	var node Ast = fcall.right;
	while node != nil {
		inst_stwi(gen_expr(node), REG_SP, n * 4);
		node = node.next;
		n++;
	}
	if n != sym.type.count {
		GenError(fcall, "parameter count mismatch for '@': expected @, found @").s(sym.name.text).n(sym.type.count).n(n);
	}


	// TODO: possibly better way to get the (mangled) canonical
	// function name from a method than indirecting through the type?
	inst_call(sym.type.name.text);
	inst_aluix(INS_ADD, REG_SP, REG_SP, sym.type.count * 4);
	return inst_mov(REG_RV);

	// TODO: terminate bb after call?
}

fn gen_expr(node Ast) i32 {
	var kind i32 = node.kind;

	if kind == AST_CONST { return inst_movi(node.ival); }
	if kind == AST_SYMBOL { return gen_load(node); }
	if kind == AST_EQ  { return gen_relop(node, INS_CMP_EQ); }
	if kind == AST_NE  { return gen_relop(node, INS_CMP_NE); }
	if kind == AST_LT  { return gen_relop(node, INS_CMP_LT); }
	if kind == AST_LE  { return gen_relop(node, INS_CMP_LE); }
	if kind == AST_GT  { return gen_relop(node, INS_CMP_GT); }
	if kind == AST_GE  { return gen_relop(node, INS_CMP_GE); }
	if kind == AST_ADD { return gen_binop(node, INS_ADD); }
	if kind == AST_SUB { return gen_binop(node, INS_SUB); }
	if kind == AST_OR  { return gen_binop(node, INS_OR); }
	if kind == AST_XOR { return gen_binop(node, INS_XOR); }
	if kind == AST_MUL { return gen_binop(node, INS_MUL); }
	if kind == AST_DIV { return gen_binop(node, INS_SDIV); }
	if kind == AST_MOD { return gen_binop(node, INS_SREM); }
	if kind == AST_AND { return gen_binop(node, INS_AND); }
	if kind == AST_LSL { return gen_binop(node, INS_LSL); }
	if kind == AST_LSR { return gen_binop(node, INS_LSR); }
	if kind == AST_NOT { return gen_unop(node, INS_NOT); }
	if kind == AST_NEG { return gen_unop(node, INS_NEG); }
	if kind == AST_BOOL_NOT { return gen_bool_not(node); }
	//if kind == AST_BOOL_AND { return gen_bool_and(node); }
	//if kind == AST_BOOL_OR { return gen_bool_or(node); }
	//if kind == AST_STRING { return gen_string_const(node.sval.text); }
	//if kind == AST_DEREF { }
	//if kind == AST_INDEX { return gen_array_load(node); }
	//if kind == AST_FIELD { return gen_field_load(node); }
	if kind == AST_CALL { return gen_call(node); }
	if kind == AST_ASSIGN { return gen_assign(node); }
	//if kind == AST_NEW { }
	//GenError(node, "unsupported @ in expr").s(ast_kind[kind]);
	Warn("unsupported @ in expr").s(ast_kind[kind]);
	return 0;
}

fn gen_block(node Ast);

fn gen_return(node Ast) {
	if node.left == nil {
		//TODO ensure void return
	} else {
		//TODO ensure non-void return
		inst_movx(REG_RV, gen_expr(node.left));
	}
	inst_jump(func_exit);
}

fn gen_break(node Ast) {
	if loop_exit == nil {
		GenError(node, "break used outside of loop");
	}
	inst_jump(loop_exit);
}

fn gen_continue(node Ast) {
	if loop_cont == nil {
		GenError(node, "continue used outside of loop");
	}
	inst_jump(loop_cont);
}

fn gen_while(node Ast) {
	// push break/continue points
	var save_exit BasicBlock = loop_exit;
	var save_cont BasicBlock = loop_cont;
	var loop_body BasicBlock;
	var save BasicBlock;

	loop_body = bb_make();
	loop_cont = bb_make();
	loop_exit = bb_make();

	loop_cont.activate();
	var cv i32 = gen_expr(node.left);
	inst_branch(cv, loop_body, loop_exit);

	loop_body.activate();
	gen_block(node.right);
	inst_jump(loop_cont);

	loop_exit.activate();

	// pop break/continue points
	loop_exit = save_exit;
	loop_cont = save_cont;
}

fn gen_if(node Ast) {
	var exit BasicBlock = bb_make();

	// next basic block to use
	var bb BasicBlock = bb_make();

	while node != nil {
		if node.kind == AST_ELSE {
			// can only be the last child,
			// after one or more CASE nodes
			bb.activate();
			gen_block(node.left);
			inst_jump(exit);
		} else {
			var if_t BasicBlock = bb_make();
			var if_f BasicBlock;
			if node.next != nil {
				if_f = bb_make();
			} else {
				// TODO if this is = exit() 2b codegen is bogus
				if_f = exit;
			}

			bb.activate();
			var cv i32 = gen_expr(node.left);
			inst_branch(cv, if_t, if_f);

			if_t.activate();
			gen_block(node.right);
			inst_jump(exit);

			bb = if_f;
		}
		node = node.next;
	}

	exit.activate();
}

fn gen_block(node Ast) { //dup
	node = node.left;
	while node != nil {
		var kind i32 = node.kind;
		if kind == AST_WHILE {
			gen_while(node);
		} else if kind == AST_BREAK {
			gen_break(node);
		} else if kind == AST_CONTINUE {
			gen_continue(node);
		} else if kind == AST_RETURN {
			gen_return(node);
		} else if kind == AST_IF {
			gen_if(node);
		} else if kind == AST_BLOCK {
			gen_block(node);
		} else if ast_is_expr(kind) {
			gen_expr(node);
		} else {
			GenError(node, "unsupported @ in block").s(ast_kind[kind]);
		}
		node = node.next;
	}
}

var local_max i32;

fn setup_locals(node Ast, n i32) { //dup
	if node.kind == AST_BLOCK {
		var sym Symbol = node.sym;
		while sym != nil {
			Warn("local @ @\n").n(n).s(sym.name.text);
			sym.ival = n;
			sym.vid = VF_UNDEF;
			n += 4;
			sym = sym.next;
		}
	}
	var node2 Ast = node.left;
	while node2 != nil {
		setup_locals(node2, n);
		node2 = node2.next;
	}
	node2 = node.right;
	while node2 != nil {
		setup_locals(node2, n);
		node2 = node2.next;
	}
	if n > local_max {
		local_max = n;
	}
}

fn dump_bb(bb BasicBlock) {
	if bb.flags & BB_MARK { return; }
	bb.flags |= BB_MARK;

	os.fmt("bb$@:").n(bb.id);
	var ins Inst = bb.first;
	while ins != nil {
		inst_disasm(os, ins);
		if inst_is_uncond_branch(ins) {
			dump_bb(bb_idx[ins.a]);
			return;
		}
		if inst_is_cond_branch(ins) {
			dump_bb(bb_idx[ins.b]);
			dump_bb(bb_idx[ins.c]);
			return;
		}
		if inst_is_return(ins) {
			return;
		}
		ins = ins.next;
	}
}

fn gen_fn(node Ast) {
	if node.left == nil { return; }

	//Warn("gen_fn() @").s(node.sym.name.text);
	bb_reset();

	// bb #0 and #1 are always function entry and exit
	var func_enter BasicBlock = bb_make();
	func_exit = bb_make();

	func_enter.activate();

	// housekeeping
	inst_label_global(node.sym.name.text);
	local_max = 0;
	setup_locals(node.left, 12);

	// prologue
	var sym Symbol = node.sym.type.list;
	var n i32 = 0;
	while sym != nil {
		sym.vid = inst_ldwi(REG_SP, n * 4);
		sym = sym.next;
		n++;
	}

	gen_block(node.left);

	// epilogue
	func_exit.activate();
	inst_ret(REG_RA);

	bb_active = nil;

	os.fmt("\n// fn @").s(node.sym.name.text);
	dump_bb(func_enter);
}

fn gen_functions(node Ast) {
	while node != nil {
		if node.kind == AST_FUNC {
			gen_fn(node);
		}
		node = node.next;
	}
}

fn gen_global_addrs(node Ast) { //dup
	var n i32 = 0;
	while node != nil {
		if node.kind == AST_ASSIGN {
			var sym Symbol = node.left.sym;
			sym.ival = n;
			n += 4;
		}
		node = node.next;
	}
}

fn gen(outfd i32, node Ast) {
	os = OutFd(outfd);
	emit("// ir-gen\n");
	gen_global_addrs(node);
	gen_functions(node);
	// gen_global_inits(node);
}
