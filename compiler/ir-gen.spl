var os OutStream;

fn emit(msg str) OutStream {
	os.msg = msg;
	os.idx = 0;
	os_advance(os);
	return os;
}

// ----

var func_exit BasicBlock = nil;
var func_type Type = nil;
var loop_exit BasicBlock = nil;
var loop_cont BasicBlock = nil;

fn gen_expr(node Ast) i32;

fn gen_relop(node Ast, op IRop) i32 {
	return inst_alu(op, gen_expr(node.left), gen_expr(node.right));
}

fn gen_binop(node Ast, op IRop) i32 {
	return inst_alu(op, gen_expr(node.left), gen_expr(node.right));
}

fn gen_unop(node Ast, op IRop) i32 {
	return inst_alu(op, 0, gen_expr(node.left));
}

fn gen_bool_not(node Ast) i32 {
	return inst_alui(INS_CMP_EQ, gen_expr(node.left), 0);
}

fn gen_load(node Ast) i32 {
	var sym Symbol = node.sym;
	if sym.kind & SYMBOL_DEF {
		return inst_movi(sym.ival);
	}
	if sym.kind & SYMBOL_GLOBAL {
		return inst_ldwi(REG_GP, sym.ival);
	}
	// param or local
	return sym_to_vid_load(sym);
}

fn gen_store(sym Symbol, val i32) i32 {
	if sym.kind & SYMBOL_GLOBAL {
		return inst_stwi(val, REG_GP, sym.ival);
	}
	if sym.kind & SYMBOL_DEF {
		Error("cannot store to constant '@'").s(sym.name.text);
	}
	// param or local
	// inst_mov(val) instead of val avoids snarls at some cost
	sym_to_vid_store(sym, val);
	return val;
}

fn gen_addr(node Ast) i32;
fn gen_index_addr(node Ast) i32;
fn gen_field_addr(node Ast) i32;

// obtain the target address of a pointer
fn gen_ptr_addr(node Ast) i32 {
	var kind i32 = node.kind;

	if kind == AST_SYMBOL {
		var sym Symbol = node.sym;
		if sym.kind & (SYMBOL_PARAM | SYMBOL_LOCAL) {
			return sym_to_vid_load(sym);
		} else if sym.kind & SYMBOL_GLOBAL {
			// get address of global pointer
			var gaddr i32 = inst_alui(INS_ADD, REG_GP, sym.ival);
			// and dereference it
			return inst_ldwi(gaddr, 0);
		} else {
			GenError(node, "gen_ptr_addr cannot resolve '@' @")
				.s(sym.name.text).x(sym.kind);
		}
	}
	if kind == AST_INDEX {
		return inst_ldwi(gen_index_addr(node), 0);
	}
	if kind == AST_FIELD {
		return inst_ldwi(gen_field_addr(node), 0);
	}
	GenError(node, "sorry... @ in ptr addr expr").s(ast_kind[kind]);
	return 0;
}

fn gen_field_addr(node Ast) i32 {
	var type Type = node.left.type;
	var ptr bool = false;
	var ar i32;
	if type.kind == TYPE_POINTER {
		type = type.of;
		ar = gen_ptr_addr(node.left);
	} else {
		ar = gen_addr(node.left);
	}
	if type.kind != TYPE_STRUCT {
		GenError(node, "invalid FIELD reference");
	}
	return inst_alui(INS_ADD, ar, node.right.sym.ival);
}

fn gen_index_addr(node Ast) i32 {
	var type Type = node.left.type;
	var ar i32;
	if type.kind == TYPE_POINTER {
		// dereference
		type = type.of;
		ar = gen_ptr_addr(node.left);
	} else {
		//GenError(node, "crap");
		ar = gen_addr(node.left);
	}
	if type.kind != TYPE_ARRAY {
		GenError(node, "index of non-array type");
	}
	var ir i32 = gen_expr(node.right);
	var sz i32 = type_size(type.of);
	if sz == 2 {
		ir = inst_alui(INS_LSL, ir, 1);
	} else if sz == 4 {
		ir = inst_alui(INS_LSL, ir, 2);
	} else if sz != 1 {
		ir = inst_alui(INS_MUL, ir, sz);
	}
	return inst_alu(INS_ADD, ar, ir);
}

fn gen_call(node Ast) i32;

fn gen_addr(node Ast) i32 {
	var kind i32 = node.kind;
	if kind == AST_FIELD {
		return gen_field_addr(node);
	}
	if kind == AST_INDEX {
		return gen_index_addr(node);
	}
	if kind == AST_CALL {
		// TODO more strict type matching
		if node.type.kind != TYPE_POINTER {
			GenError(node, "fn @ does not return a pointer").s(node.left.sym.name.text);
		}
		return gen_call(node);
	}
	GenError(node, "sorry... @ in addr expr").s(ast_kind[kind]);
}

fn gen_array_load(node Ast) i32 {
	return inst_loadi(type_size(node.type), gen_index_addr(node), 0);
}

fn gen_array_store(node Ast, vr i32) i32 {
	inst_storei(type_size(node.type), vr, gen_index_addr(node), 0);
	return vr;
}

fn gen_field_load(node Ast) i32 {
	return inst_loadi(type_size(node.type), gen_field_addr(node), 0);
}

fn gen_field_store(node Ast, vr i32) i32 {
	inst_storei(type_size(node.type), vr, gen_field_addr(node), 0);
	return vr;
}

fn gen_assign(node Ast) i32 {
	var kind i32 = node.left.kind;
	if kind == AST_SYMBOL {
		if (node.left.type.kind == TYPE_POINTER) &&
			(node.right.type.kind != TYPE_POINTER) {
			if !types_match(node.left.type.of, node.right.type) {
				GenError(node, "cannot obtain @ from @").t(node.left.type).t(node.right.type);
			}
			return gen_store(node.left.sym, gen_addr(node.right));
		} else {
			return gen_store(node.left.sym, gen_expr(node.right));
		}
	}
	if kind == AST_INDEX {
		return gen_array_store(node.left, gen_expr(node.right));
	}
	if kind == AST_FIELD {
		return gen_field_store(node.left, gen_expr(node.right));
	}
	var ar i32 = gen_addr(node.left);
	var vr i32 = gen_expr(node.right);
	return inst_stwi(vr, ar, 0);
}

fn gen_call(fcall Ast) i32 {
	var sym Symbol = fcall.left.sym;
	if sym == nil {
		// TODO: should be impossible
		GenError(fcall, "calling undefined function");
	}

	if sym.type.count > 0 {
		inst_aluix(INS_SUB, REG_SP, REG_SP, sym.type.count * 4);
	}
	var n i32 = 0;
	var node Ast = fcall.right;
	while node != nil {
		inst_stwi(gen_expr(node), REG_SP, n * 4);
		node = node.next;
		n++;
	}
	if n != sym.type.count {
		GenError(fcall, "parameter count mismatch for '@': expected @, found @").s(sym.name.text).n(sym.type.count).n(n);
	}

	// TODO: possibly better way to get the (mangled) canonical
	// function name from a method than indirecting through the type?
	inst_call(sym.type.name);

	if sym.type.count > 0 {
		inst_aluix(INS_ADD, REG_SP, REG_SP, sym.type.count * 4);
	}

	if sym.type.of == ctx.type_void {
		return REG_ZERO;
	} else {
		return inst_mov(REG_RV);
	}

	// TODO: terminate bb after call?
}


fn gen_bool_and(node Ast) i32 {
	var _if BasicBlock = bb_make("bool-and-test0");
	var _else BasicBlock = bb_make("bool-and-test1");
	var _false BasicBlock = bb_make("bool-and-false");
	var _true BasicBlock = bb_make("bool-and-true");
	var _exit BasicBlock = bb_make("bool-and-exit");

	_if.activate_and_seal_prev();
	_if.place();
	_if.seal();
	inst_branch(gen_expr(node.left), _else, _false);

	_else.activate();
	_else.place();
	_else.seal();
	inst_branch(gen_expr(node.right), _true, _false);

	var v0 i32 = ir_reg_get();
	var v1 i32 = ir_reg_get();
	var r i32 = ir_reg_get();

	_false.activate();
	_false.place();
	_false.seal();
	inst_movix(v0, 0);
	inst_set(r, v0);
	inst_jump(_exit);

	_true.activate();
	_true.place();
	_true.seal();
	inst_movix(v1, 1);
	inst_set(r, v1);
	inst_jump(_exit);

	_exit.place();
	_exit.activate();
	_exit.seal();
	return inst_get(r);
}

fn gen_bool_or(node Ast) i32 {
	var _if BasicBlock = bb_make("bool-or-test0");
	var _else BasicBlock = bb_make("bool-or-test1");
	var _false BasicBlock = bb_make("bool-or-false");
	var _true BasicBlock = bb_make("bool-or-true");
	var _exit BasicBlock = bb_make("bool-or-exit");

	_if.activate_and_seal_prev();
	_if.place();
	_if.seal();
	inst_branch(gen_expr(node.left), _true, _else);

	_else.activate();
	_else.place();
	_else.seal();
	inst_branch(gen_expr(node.right), _true, _false);

	var v0 i32 = ir_reg_get();
	var v1 i32 = ir_reg_get();
	var r i32 = ir_reg_get();

	_false.activate();
	_false.place();
	_false.seal();
	inst_movix(v0, 0);
	inst_set(r, v0);
	inst_jump(_exit);

	_true.activate();
	_true.place();
	_true.seal();
	inst_movix(v1, 1);
	inst_set(r, v1);
	inst_jump(_exit);

	_exit.place();
	_exit.activate();
	_exit.seal();
	return inst_get(r);
}

fn gen_expr(node Ast) i32 {
	var kind i32 = node.kind;

	if kind == AST_CONST { return inst_movi(node.ival); }
	if kind == AST_SYMBOL { return gen_load(node); }
	if kind == AST_EQ  { return gen_relop(node, INS_CMP_EQ); }
	if kind == AST_NE  { return gen_relop(node, INS_CMP_NE); }
	if kind == AST_LT  { return gen_relop(node, INS_CMP_LT); }
	if kind == AST_LE  { return gen_relop(node, INS_CMP_LE); }
	if kind == AST_GT  { return gen_relop(node, INS_CMP_GT); }
	if kind == AST_GE  { return gen_relop(node, INS_CMP_GE); }
	if kind == AST_ADD { return gen_binop(node, INS_ADD); }
	if kind == AST_SUB { return gen_binop(node, INS_SUB); }
	if kind == AST_OR  { return gen_binop(node, INS_OR); }
	if kind == AST_XOR { return gen_binop(node, INS_XOR); }
	if kind == AST_MUL { return gen_binop(node, INS_MUL); }
	if kind == AST_DIV { return gen_binop(node, INS_SDIV); }
	if kind == AST_MOD { return gen_binop(node, INS_SREM); }
	if kind == AST_AND { return gen_binop(node, INS_AND); }
	if kind == AST_LSL { return gen_binop(node, INS_LSL); }
	if kind == AST_LSR { return gen_binop(node, INS_LSR); }
	if kind == AST_NOT { return gen_unop(node, INS_NOT); }
	if kind == AST_NEG { return gen_unop(node, INS_NEG); }
	if kind == AST_BOOL_NOT { return gen_bool_not(node); }
	if kind == AST_BOOL_AND { return gen_bool_and(node); }
	if kind == AST_BOOL_OR { return gen_bool_or(node); }
	if kind == AST_STRING { return inst_cdata_str(node.sval); }
	//if kind == AST_DEREF { }
	if kind == AST_INDEX { return gen_array_load(node); }
	if kind == AST_FIELD { return gen_field_load(node); }
	if kind == AST_CALL { return gen_call(node); }
	if kind == AST_ASSIGN { return gen_assign(node); }
	//if kind == AST_NEW { }
	GenError(node, "unsupported @ in expr").s(ast_kind[kind]);
	return 0;
}

fn gen_block(node Ast);

fn gen_return(node Ast) {
	if node.left == nil {
		//TODO ensure void return
	} else {
		//TODO ensure non-void return
		inst_movx(REG_RV, gen_expr(node.left));
	}
	inst_jump(func_exit);
}

fn gen_break(node Ast) {
	if loop_exit == nil {
		GenError(node, "break used outside of loop");
	}
	inst_jump(loop_exit);
}

fn gen_continue(node Ast) {
	if loop_cont == nil {
		GenError(node, "continue used outside of loop");
	}
	inst_jump(loop_cont);
}

fn gen_while(node Ast) {
	// push break/continue points
	var save_exit BasicBlock = loop_exit;
	var save_cont BasicBlock = loop_cont;
	var loop_body BasicBlock;
	var save BasicBlock;

	loop_body = bb_make("while-body");
	loop_cont = bb_make("while-loop");
	loop_exit = bb_make("while-exit");

	loop_cont.place();
	loop_cont.activate_and_seal_prev();
	var cv i32 = gen_expr(node.left);
	inst_branch(cv, loop_body, loop_exit);

	loop_body.place();
	loop_body.activate();
	loop_body.seal();
	gen_block(node.right);
	inst_jump(loop_cont);

	loop_cont.seal();

	loop_exit.place();
	loop_exit.activate_and_seal_prev();
	loop_exit.seal();

	// pop break/continue points
	loop_exit = save_exit;
	loop_cont = save_cont;
}

fn gen_if(node Ast) {
	var exit BasicBlock = bb_make("if-exit");

	// next basic block to use
	var bb BasicBlock = bb_make("if-cond-expr");

	node = node.left;
	while node != nil {
		if node.kind == AST_ELSE {
			// can only be the last child,
			// after one or more CASE nodes
			bb.activate_and_seal_prev();
			bb.place();
			bb.seal();
			gen_block(node.left);
			inst_jump(exit);
		} else {
			var if_t BasicBlock = bb_make("if-case-true");
			var if_f BasicBlock;
			if node.next != nil {
				if_f = bb_make("if-case-false");
			} else {
				// TODO if this is = exit() 2b codegen is bogus
				if_f = exit;
			}

			bb.activate_and_seal_prev();
			bb.place();
			bb.seal();
			var cv i32 = gen_expr(node.left);
			inst_branch(cv, if_t, if_f);

			if_t.place();
			if_t.activate();
			if_t.seal();
			gen_block(node.right);
			inst_jump(exit);

			bb = if_f;
		}
		node = node.next;
	}

	exit.place();
	exit.activate_and_seal_prev(); //?
	exit.seal();
}

fn gen_block(node Ast) { //dup
	node = node.left;
	while node != nil {
		var kind i32 = node.kind;
		if kind == AST_WHILE {
			gen_while(node);
		} else if kind == AST_BREAK {
			gen_break(node);
		} else if kind == AST_CONTINUE {
			gen_continue(node);
		} else if kind == AST_RETURN {
			gen_return(node);
		} else if kind == AST_IF {
			gen_if(node);
		} else if kind == AST_BLOCK {
			gen_block(node);
		} else if ast_is_expr(kind) {
			gen_expr(node);
		} else {
			GenError(node, "unsupported @ in block").s(ast_kind[kind]);
		}
		node = node.next;
	}
}

var local_max i32;

fn setup_locals(node Ast, n i32) { //dup
	if node.kind == AST_BLOCK {
		var sym Symbol = node.sym;
		while sym != nil {
			Warn("local @ @").n(n).s(sym.name.text);
			sym.ival = n;
			sym.vid = VF_UNDEF;
			n += 4;
			sym = sym.next;
		}
	}
	var node2 Ast = node.left;
	while node2 != nil {
		setup_locals(node2, n);
		node2 = node2.next;
	}
	node2 = node.right;
	while node2 != nil {
		setup_locals(node2, n);
		node2 = node2.next;
	}
	if n > local_max {
		local_max = n;
	}
}

fn get_outfile(enable bool, name str, ext str) OutStream;

fn gen_fn(node Ast) {
	if node.left == nil { return; }

	Warn("gen_fn() @ ---------------------").s(node.sym.name.text);
	bb_reset();

	// bb #0 and #1 are always function entry and exit
	var func_enter BasicBlock = bb_make("fn-entry");
	func_exit = bb_make("fn-exit");
	func_exit.flags |= BB_EXIT;

	func_enter.flags |= BB_ENTRY;
	func_enter.set_name(node.sym.name);
	func_enter.place();
	func_enter.activate();
	func_enter.seal();

	// housekeeping
	local_max = 0;
	setup_locals(node.left, 12);

	// prologue
	inst_stwi(REG_RA, REG_SP, -4);
	inst_stwi(REG_FP, REG_SP, -8);
	inst_movx(REG_FP, REG_SP);
	inst_aluix(INS_SUB, REG_SP, REG_SP, 8);

	var sym Symbol = node.sym.type.list;
	var n i32 = 0;
	while sym != nil {
		sym.vid = inst_ldwi(REG_FP, n * 4);
		sym = sym.next;
		n++;
	}

	gen_block(node.left);

	// epilogue
	func_exit.place();
	func_exit.activate_and_seal_prev();
	func_exit.seal();
	inst_ldwix(REG_RA, REG_FP, -4);
	inst_ldwix(REG_FP, REG_FP, -8);
	inst_aluix(INS_ADD, REG_SP, REG_SP, 8);
	inst_ret(REG_RA);

	bb_active = nil;

	//TODO ensure no blocks are unplaced

	var name str = node.sym.name.text;

	finalize_fn(bb_order_first);

	var is OutStream = get_outfile(ctx.with_ir, name, ".ir");
	if is != nil {
		is.fmt("\n// fn @\n").s(name);
		dump_bb_list(is, bb_order_first, false);
		fd_close(is.fd);
	}

	var gs OutStream = get_outfile(ctx.with_graphs, name, ".dot");
	if gs != nil {
		dump_bb_list(gs, bb_order_first, true);
		fd_close(gs.fd);
	}

	serialize_fn(os.fd, bb_order_first);
}

fn gen_functions(node Ast) {
	while node != nil {
		if node.kind == AST_FUNC {
			gen_fn(node);
		}
		node = node.next;
	}
}

fn get_outfile(enable bool, name str, ext str) OutStream {
	if (!enable) || (ctx.out_base == nil) {
		return nil;
	}
	var fname str = strcat(ctx.out_base, "-");
	fname = strcat(fname, name);
	fname = strcat(fname, ext);
	return OutFd(fd_create(fname));
}

fn emit_data_chunk(dc DataChunk) {
	serialize_data_chunk(os.fd, dc);
}

fn gen(outfd i32, node Ast) {
	if ctx.out_base != nil {
		// trim extension from output base name
		var s str = ctx.out_base;
		var i i32 = 0;
		var len i32 = strlen(s);
		while i < len {
			if s[i] == '.' {
				s[i] = 0;
				break;
			}
			i++;
		}
	}
	ir_init();
	os = OutFd(outfd);
	gen_global_addrs(node);
	gen_global_data(node);

	serialize_header(os.fd);
	gen_functions(node);
	emit_data_chunks();
	serialize_cdata(os.fd);

	// these are always last
	serialize_globals(os.fd);
}
