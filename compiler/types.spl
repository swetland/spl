// ================================================================
// data types

struct Type;
struct AnonTypeUse;

struct String {
	next *String,
	len u32,
	text [1]u8,
};

enum SymbolKind u16 {
	SYMBOL_MASK      = 0x00F,
	// basic types
	SYMBOL_VAR       = 0x001, // variable
	SYMBOL_DEF       = 0x002, // enum or constant
	SYMBOL_FLD       = 0x004, // field of a structure
	SYMBOL_FN        = 0x008, // function
	// flags: scope for variables:
	SYMBOL_LOCAL     = 0x010,
	SYMBOL_PARAM     = 0x020,
	SYMBOL_GLOBAL    = 0x040,
	// flags: function decl (vs defn)
	SYMBOL_DECL      = 0x080,
	// flags: unnamed parameter
	SYMBOL_ANON      = 0x100,
};

struct Symbol {
	next *Symbol,
	name *String,
	type *Type,
	kind SymbolKind,
	// var: offset from param/frame/global base
	// fld: offset from struct base
	// fn: srcloc of decl or defn
	ival u32,
	// used by IR generation
	vid u32,
};

enum ScopeKind u8 {
	SCOPE_GLOBAL,
	SCOPE_FUNC,
	SCOPE_BLOCK,
	SCOPE_LOOP,
	SCOPE_STRUCT,
};

struct Scope {
	parent *Scope,
	first *Symbol,
	last *Symbol,
	kind ScopeKind,
};

enum TypeKind u16 {
	TYPE_VOID       = 0x0100,
	TYPE_BOOL       = 0x0101,
	TYPE_U8         = 0x0010,
	TYPE_I8         = 0x0014,
	TYPE_U16        = 0x0011,
	TYPE_I16        = 0x0015,
	TYPE_U32        = 0x0012,
	TYPE_I32        = 0x0016,
	TYPE_NIL        = 0x0200, // first non-scalar type
	TYPE_POINTER    = 0x0201,
	TYPE_ARRAY      = 0x0400,
	TYPE_STR        = 0x0401,
	TYPE_STRUCT     = 0x0800,
	TYPE_SLICE      = 0x0801,
	TYPE_FN         = 0x1000,
	TYPE_ANON       = 0x0103, // opaque/template type
	TYPE_UNDEFINED  = 0x8000, // fwd ref to a struct

	TYPE_MASK_INT   = 0x0007,
	TYPE_MASK_SIZE  = 0x0003,
	TYPE_IS_NOT_INT = 0xFFE8, // non-int type if any match
	TYPE_IS_SIGNED  = 0x0004,
	TYPE_IS_INTEGER = 0x0010,
	TYPE_IS_FLOAT   = 0x0020,
	TYPE_IS_POINTER = 0x0200,
	TYPE_IS_ARRAY   = 0x0400,
	TYPE_IS_STRUCT  = 0x0800,
	// array/struct/undef/fn are passed by reference:
	TYPE_NEED_PTR   = 0x9C00,
};

struct Type {
	next *Type,
	name *String,
	// for slice, array, ptr, fn (return type)
	of *Type,
	// cached pointer-to-this-type
	ptr *Type,
	// for struct (fields), fn (params)
	list *Symbol,
	kind TypeKind,
	// slice/array: number of slots
	// struct: total byte size
	// fn: parameter count
	count u32,
	methods *Symbol,
};

fn type_is_scalar(type Type) bool {
	return type.kind < TYPE_NIL;
}

// ================================================================
// Abstract Syntax Tree

enum AstKind u8 {
// top node
	AST_PROGRAM,  // l=FUNC*
// program components (chained into a list by next)
	AST_FUNC,     // l=BLOCK sym: fn-symbol ival: fnflags
// container of statements
	AST_BLOCK,    // l=STMT* sym: local-symbols-list
// statements (chained into a list by next)
	AST_WHILE,    // l=EXPR r=BLOCK
	AST_BREAK,
	AST_CONTINUE,
	AST_RETURN,   // l=EXPR
	AST_IF,       // l=CASE*
// sub-parts of if
	AST_CASE,     // l=EXPR r=BLOCK
	AST_ELSE,     // l=BLOCK
// expressions
	AST_SYMBOL,   // sym: symbol
	AST_CONST,    // ival: numeric constant
	AST_STRING,   // name: string constant
	AST_INDEX,    // l=EXPR type: array-of-...  r=EXPR index
	AST_FIELD,    // l=EXPR type: struct        r=SYMBOL field
	AST_ADDROF,   // l=EXPR type: lvalue
	AST_CALL,     // l=SYMBOL r=EXPR*
	AST_ASSIGN,   // l=lhsEXPR r=rhsEXPR
	AST_CAST,     // l=EXPR type: cast-to
	AST_ARRAY,    // l=EXPR* type: array-of-...
	AST_NEW,      // l=EXPR(arraycount or extraalloc) type: type
// binary expressions
	// Rel Ops (maintain order matched w/ lexer)
	AST_EQ, AST_NE, AST_LT, AST_LE, AST_GT, AST_GE,
	// Add Ops (maintain order matched w/ lexer)
	AST_ADD, AST_SUB, AST_OR, AST_XOR,
	// Mul Ops (maintain order matched w/ lexer)
	AST_MUL, AST_DIV, AST_MOD, AST_LSL, AST_LSR, AST_AND, AST_CLR,
	// uncategorized ops
	AST_NOT, AST_BOOL_AND, AST_BOOL_OR, AST_BOOL_NOT, AST_NEG,
// nodes generated during validation pass
	AST_FNADDR,         // s=sym
	AST_FNNAME,         // s=sym
	AST_LOAD_LOCAL,     // s=sym
	AST_LOAD_PARAM,     // s=sym
	AST_LOAD_GLOBAL,    // s=sym
	AST_STORE_LOCAL,    // s=sym l=EXPR
	AST_STORE_PARAM,    // s=sym l=EXPR
	AST_STORE_GLOBAL,   // s=sym l=EXPR
	AST_LOAD_PTR,       // l=ADDR
	AST_STORE_PTR,      // l=ADDR r=EXPR
	AST_ADDROF_FIELD,   // s=sym(field) l=ADDR(struct)
	AST_ADDROF_ELEM,    // l=ADDR(array) r=EXPR(index)
	AST_KIND_COUNT,
};

var ast_kind []str = {
	"PROGRAM", "FUNC",
	"BLOCK", "WHILE", "BREAK", "CONTINUE",
	"RETURN", "IF", "CASE", "ELSE",
	"SYMBOL", "CONST", "STRING",
	"INDEX", "FIELD", "ADDROF",
	"CALL", "ASSIGN", "CAST", "ARRAY", "NEW",
	"EQ", "NE", "LT", "LE", "GT", "GE",
	"ADD", "SUB", "OR", "XOR",
	"MUL", "DIV", "MOD", "LSL", "LSR", "AND", "CLR",
	"NOT", "BOOL AND", "BOOL OR", "BOOL NOT", "NEG",
	"FNADDR", "FNNAME",
	"LOAD-LOCAL", "LOAD-PARAM", "LOAD-GLOBAL",
	"STORE-LOCAL", "STORE-PARAM", "STORE-GLOBAL",
	"LOAD-PTR", "STORE-PTR",
	"ADDROF-FIELD", "ADDROF-ELEM",
};

// AST_FUNC node ival:
enum FN_FLAGS {
	FN_LEAF = 1, // doesn't make any function calls
};

fn ast_is_relop(kind AstKind) bool {
	return (kind >= AST_EQ) && (kind <= AST_GE);
}

fn ast_is_addop(kind AstKind) bool {
	return (kind >= AST_ADD) && (kind <= AST_XOR);
}

fn ast_is_mulop(kind AstKind) bool {
	return (kind >= AST_MUL) && (kind <= AST_LSR);
}

fn ast_is_binop(kind AstKind) bool {
	return (kind >= AST_EQ) && (kind <= AST_LSR);
}

fn ast_is_expr(kind AstKind) bool {
	return (kind >= AST_SYMBOL);
}

fn ast_is_stmt(kind AstKind) bool {
	return (kind >= AST_WHILE) && (kind <= AST_ELSE);
}

struct Ast {
	kind AstKind,

	left *Ast,
	right *Ast,
	next *Ast, // intrusive list

	ival u32,
	sval *String,
	sym *Symbol,
	type *Type,

	// 12 bits: source file id
	// 20 bits: source line number
	srcloc u32,
};


// ================================================================
// lexical scanner tokens

// token classes (tok & tcMASK)
enum TokenClass u8 {
	tcRELOP = 0x08, tcADDOP = 0x10, tcMULOP = 0x18,
	tcAEQOP = 0x20, tcMEQOP = 0x28, tcMASK = 0xF8,
};

enum Token u8 {
	// EndMarks, Braces, Brackets Parens
	tEOF, tEOL, tOBRACE, tCBRACE, tOBRACK, tCBRACK, tOPAREN, tCPAREN,
	// RelOps (do not reorder)
	tEQ, tNE, tLT, tLE, tGT, tGE, tx0E, tx0F,
	// AddOps (do not reorder)
	tPLUS, tMINUS, tPIPE, tCARET, tx14, tx15, tx16, tx17,
	// MulOps (do not reorder)
	tSTAR, tSLASH, tPERCENT, tLEFT, tRIGHT, tAMP, tCLR, tx1F,
	// AsnOps (do not reorder)
	tADDEQ, tSUBEQ, tOREQ, tXOREQ, tx24, tx25, tx26, tx27,
	tMULEQ, tDIVEQ, tMODEQ, tLSEQ, tRSEQ, tANDEQ, tCLREQ, t2F,
	// Various, UnaryNot, LogicalOps,
	tSEMI, tCOLON, tDOT, tCOMMA, tTILDE, tAND, tOR, tBANG,
	tASSIGN, tINC, tDEC,
	tAT, tDOLLAR, tQUERY, tHASH, tBACKTICK,
	// Keywords
	tNEW, tFN, tSTRUCT, tVAR, tENUM,
	tIF, tELSE, tWHILE,
	tBREAK, tCONTINUE, tRETURN,
	tFOR, tSWITCH, tCASE,
	tTRUE, tFALSE, tNIL,
	tIDN, tNUM, tUNUM, tSTR,
	// used internal to the lexer but never returned
	tSPC, tINV, tQUOTE, tTICK,
};

var tnames []str = {
	"<EOF>", "<EOL>", "{",  "}",  "[",    "]",   "(",   ")",
	"==",    "!=",    "<",  "<=", ">",    ">=",  "",    "",
	"+",     "-",     "|",  "^",  "",     "",    "",    "",
	"*",     "/",     "%",  "<<", ">>",   "&",   "&^",  "",
	"+=",    "-=",    "|=", "^=", "",     "",    "",    "",
	"*=",    "/=",    "%=", "<<=", ">>=", "&=",  "&^=", "",
	";",     ":",     ".",  ",",  "~",    "&&",  "||",  "!",
	"=",     "++",    "--",
	"@",     "$",     "?",  "#",  "`",
	"new", "fn", "struct", "var", "enum",
	"if", "else", "while",
	"break", "continue", "return",
	"for", "switch", "case",
	"true", "false", "nil",
	"<ID>", "<NUM>", "<UNUM>", "<STR>",
	"<SPC>", "<INV>", "<DQT>", "<SQT>", "<MSC>",
};


struct SourceFile {
	next *SourceFile,
	name str,
	id u32,
};

// ================================================================
// lexer / parser / compiler context

struct Context {
	filelist *SourceFile,	// list of all source files
	fileid u32,

	fd_in i32,		// current input file
	linenumber u32,		// line number of most recent line
	lineoffset u32,		// position of start of most recent line
	byteoffset u32,		// position of the most recent character
	cc u32,			// scanner: next character

	curfn str,		// current function name during codegen
	curfnloc u32,           // srcloc of current function during codegen

	srcloc u32,		// position at the start of the last token

	tok Token,		// most recent token
	num u32,		// for tNUM
	tmp [256]u8,		// for tIDN, tSTR
	ident *String,		// for tSTR

	stringlist *String,	// intern table
	typelist *Type,		// all types
	anontypelist *Type,     // anonymous types
	anonmap *AnonTypeUse,	// tracking current use of anonymous types

	scope *Scope,		// top of Scope stack
	global *Scope,		// the global scope
	cur_fn *Symbol,		// fn being parsed

	program *Ast,
	last *Ast,

	idn_if *String,		// identifier strings
	idn_fn *String,
	idn_for *String,
	idn_var *String,
	idn_nil *String,
	idn_new *String,
	idn_case *String,
	idn_else *String,
	idn_enum *String,
	idn_true *String,
	idn_break *String,
	idn_while *String,
	idn_false *String,
	idn_switch *String,
	idn_struct *String,
	idn_return *String,
	idn_continue *String,

	type_void *Type,
	type_bool *Type,
	type_str *Type,
	type_nil *Type,
	type_u32 *Type,
	type_i32 *Type,
	type_u16 *Type,
	type_i16 *Type,
	type_u8 *Type,
	type_i8 *Type,

	str_new_fn *String,
	str_underscore *String,
	str_type_unknown *String,
	str_type_pointer *String,
	str_type_array *String,

	// output options
	options u32,
	out_base str,
};

enum CtxOptions {
	OPT_WITH_IR0 = 1,
	OPT_WITH_IR1 = 2,
	OPT_PANIC_ON_ERROR = 4,
	OPT_ABI_1 = 8,
};

var ctx Context;
