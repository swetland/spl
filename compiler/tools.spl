// message tools

fn print_type(fd i32, type Type);

fn (os OutStream) t(type Type) OutStream {
	print_type(os.fd, type);
	os_advance(os);
	return os;
}

fn make_OutStream(msg str, fd i32, flags u32, tag str) OutStream {
	var os OutStream = new(OutStream);
	os.msg = msg;
	os.idx = 0;
	os.flags = flags;
	os.fd = fd;
	if tag != nil {
		if flags & OS_INTERRUPT {
			writes(fd, "\n");
		}
		print_srcloc(fd, ctx.linenumber);
		writes(fd, tag);
	}
	os_advance(os);
	return os;
}

fn Error(msg str) OutStream {
	return make_OutStream(msg, 2, OS_FATAL | OS_NEWLINE | OS_INTERRUPT, ": error: ");
}

fn Warn(msg str) OutStream {
	return make_OutStream(msg, 2, OS_NEWLINE, ": warning: ");
}

// tools for strings, symbols, and ASTs

var __alloc_string u32 = 0;
var __alloc_scope u32 = 0;
var __alloc_symbol u32 = 0;
var __alloc_type u32 = 0;
var __alloc_node u32 = 0;
var __lookup_string u32 = 0;
var __lookup_symbol u32 = 0;
var __lookup_global u32 = 0;

enum Config {
	WITH_STATS = 1,
};

fn string_make(text str, len u32) String {
	if WITH_STATS { __lookup_string++; }
	var s String = ctx.stringlist;
	while s != nil {
		if (s.len == len) && strneq(text, s.text, len) {
			return s;
		}
		s = s.next;
	}
	s = new(String);
	s.len = len;
	strcpyn(s.text, text, len + 1);
	s.next = ctx.stringlist;
	ctx.stringlist = s;
	if WITH_STATS { __alloc_string++; }
	return s;
}

fn scope_push(kind ScopeKind) Scope {
	var scope Scope = new(Scope);
	scope.first = nil;
	scope.last = nil;
	scope.parent = ctx.scope;
	scope.kind = kind;
	ctx.scope = scope;
	if WITH_STATS { __alloc_scope++; }
	return scope;
}

// returns symbol list for the popped scope
fn scope_pop() Symbol {
	var scope Scope = ctx.scope;
	ctx.scope = scope.parent;
	return scope.first;
}

fn scope_find(kind ScopeKind) Scope {
	var scope Scope = ctx.scope;
	while scope != nil {
		if scope.kind == kind {
			return scope;
		}
		scope = scope.parent;
	}
	return nil;
}

fn symbol_find_in(name String, scope Scope) Symbol {
	if WITH_STATS {
		if scope == ctx.global { __lookup_global++; }
		__lookup_symbol++;
	}
	var sym Symbol = scope.first;
	while sym != nil {
		if sym.name == name {
			return sym;
		}
		sym = sym.next;
	}
	return nil;
}

// find the first surrounding scope of a specified kind
fn symbol_find(name String) Symbol {
	var scope Scope = ctx.scope;
	while scope != nil {
		var sym Symbol = symbol_find_in(name, scope);
		if sym != nil {
			return sym;
		}
		scope = scope.parent;
	}
	return nil;
}

fn scope_add(scope Scope, sym Symbol) {
	if scope.first == nil {
		scope.first = sym;
	} else {
		scope.last.next = sym;
	}
	scope.last = sym;
}

fn symbol_make_in_scope(name String, type Type, kind SymbolKind, ival i32, scope Scope) Symbol {
	var sym Symbol = new(Symbol);
	sym.name = name;
	sym.type = type;
	sym.next = nil;
	sym.kind = kind;
	sym.ival = ival;
	if scope != nil {
		if (symbol_find_in(name, scope) != nil) && (!(kind & SYMBOL_ANON)) {
			Error("cannot redefine '@'").s(name.text);
		}
		scope_add(scope, sym);
	}
	if WITH_STATS { __alloc_symbol++; }
	return sym;
}

fn symbol_make_global(name String, type Type, kind SymbolKind, ival i32) Symbol {
	return symbol_make_in_scope(name, type, kind, ival, ctx.global);
}

fn symbol_make(name String, type Type, kind SymbolKind, ival i32) Symbol {
	return symbol_make_in_scope(name, type, kind, ival, ctx.scope);
}

fn type_make(name String, kind TypeKind, of Type, list Symbol, count u32) Type {
	var type Type = new(Type);
	type.name = name;
	type.of = of;
	type.list = list;
	type.kind = kind;
	type.count = count;
	if name != nil {
		type.next = ctx.typelist;
		ctx.typelist = type;
	} else {
		type.next = nil;
		if type.kind == TYPE_POINTER {
			type.name = ctx.str_type_pointer;
		} else if type.kind == TYPE_ARRAY {
			type.name = ctx.str_type_pointer;
		} else {
			type.name = ctx.str_type_unknown;
		}
	}
	if WITH_STATS { __alloc_type++; }
	return type;
}

fn type_make_ptr(type Type) Type {
	return type_make(nil, TYPE_POINTER, type, nil, 0);
}

fn type_find(name String) Type {
	var t Type = ctx.typelist;
	while t != nil {
		if t.name == name {
			return t;
		}
		t = t.next;
	}
	return nil;
}

fn type_anon(name String) Type {
	var t Type = ctx.anontypelist;
	while t != nil {
		if t.name == name {
			return t;
		}
		t = t.next;
	}
	// pass nil as name to type_make so we don't
	// get put on the global type list
	t = type_make(nil, TYPE_ANON, nil, nil, 0);
	t.name = name;
	t.of = type_make(nil, TYPE_POINTER, t, nil, 0);
	t.next = ctx.anontypelist;
	ctx.anontypelist = t;
	return t;
}

fn type_find_field(type Type, name String) Symbol {
	if type.kind != TYPE_STRUCT {
		Error("not a struct");
	}
	var s Symbol = type.list;
	while s != nil {
		if s.name == name {
			return s;
		}
		s = s.next;
	}
	Error("struct has no such field '@'").s(name.text);
	return nil;
}

fn types_match(a Type, b Type) bool {
	// simple case: same object
	if a == b { return true; }
	// not the same, but one is nil
	if (a == nil) || (b == nil) { return false; }
	// cannot match if of different kind
	if a.kind != b.kind { return false; }
	// cannot match if counts differ
	if a.count != b.count { return false; }
	// cannot match if -of types differ
	if !types_match(a.of, b.of) { return false; }
	// cannot match if field/param type lists differ
	var aa Symbol = a.list;
	var bb Symbol = b.list;
	while aa != nil {
		if !types_match(aa.type, bb.type) { return false; }
		aa = aa.next;
		bb = bb.next;
	}
	// match!
	return true;
}

fn ast_make(kind AstKind, ival u32, sval String, sym Symbol, type Type) Ast {
	if type == nil {
		type = ctx.type_void;
	}
	var node Ast = new(Ast);
	node.kind = kind;
	node.ival = ival;
	node.sval = sval;
	node.sym = sym;
	node.type = type;
	node.srcloc = ctx.srcloc;
	if WITH_STATS { __alloc_node++; }
	return node;
}

fn ast_make_lr(kind AstKind, left Ast, right Ast) Ast {
	var node Ast = ast_make(kind, 0, nil, nil, left.type);
	node.left = left;
	node.right = right;
	return node;
}

fn ast_make_l(kind AstKind, child Ast) Ast {
	var node Ast = ast_make(kind, 0, nil, nil, child.type);
	node.left = child;
	return node;
}

fn ast_make_simple(kind AstKind, x u32) Ast {
	return ast_make(kind, x, nil, nil, nil);
}

fn ast_make_const(value u32, type Type) Ast {
	return ast_make(AST_CONST, value, nil, nil, type);
}

fn ast_make_symbol(sym Symbol) Ast {
	return ast_make(AST_SYMBOL, 0, nil, sym, sym.type);
}

fn ast_posn(node Ast, srcloc u32) Ast {
	node.srcloc = srcloc;
	return node;
}

fn ctx_init() {
	ctx = new(Context);

	ctx.idn_if       = string_make("if", 2);
	ctx.idn_fn       = string_make("fn", 2);
	ctx.idn_for      = string_make("for", 3);
	ctx.idn_var      = string_make("var", 3);
	ctx.idn_nil      = string_make("nil", 3);
	ctx.idn_new      = string_make("new", 3);
	ctx.idn_case     = string_make("case", 4);
	ctx.idn_else     = string_make("else", 4);
	ctx.idn_enum     = string_make("enum", 4);
	ctx.idn_true     = string_make("true", 4);
	ctx.idn_break    = string_make("break", 5);
	ctx.idn_while    = string_make("while", 5);
	ctx.idn_false    = string_make("false", 5);
	ctx.idn_switch   = string_make("switch", 6);
	ctx.idn_struct   = string_make("struct", 6);
	ctx.idn_return   = string_make("return", 6);
	ctx.idn_continue = string_make("continue", 8);

	ctx.type_void    = type_make(string_make("void", 4), TYPE_VOID, nil, nil, 0);
	ctx.type_bool    = type_make(string_make("bool", 4), TYPE_BOOL, nil, nil, 0);
	ctx.type_nil     = type_make(string_make("nil", 3),  TYPE_NIL,  nil, nil, 0);
	ctx.type_u8      = type_make(string_make("u8", 2),   TYPE_U8,   nil, nil, 0);
	ctx.type_u32     = type_make(string_make("u32", 3),  TYPE_U32,  nil, nil, 0);
	ctx.type_i32     = type_make(string_make("i32", 3),  TYPE_I32,  nil, nil, 0);
	// treat str as an alias for *[]u8 for the time being
	ctx.type_str     = type_make(string_make("str", 3), TYPE_POINTER, type_make(nil, TYPE_ARRAY, ctx.type_u8, nil, 0), nil, 0);

	ctx.str_new_fn       = string_make("__new", 5);
	ctx.str_underscore   = string_make("_", 1);
	ctx.str_type_unknown = string_make("???", 3);
	ctx.str_type_pointer = string_make("*", 1);
	ctx.str_type_array   = string_make("[]", 2);

	scope_push(SCOPE_GLOBAL);
	ctx.global = ctx.scope;

	ctx.linenumber = 0;
	ctx.srcloc = 0;
	ctx.filelist = nil;
}

fn ctx_set_source_file(name str) {
	var sf SourceFile = new(SourceFile);
	sf.name = name;
	sf.id = ctx.fileid;
	sf.next = ctx.filelist;
	ctx.filelist = sf;
	ctx.fileid++;

	ctx.linenumber = (sf.id << 20) | 1;
}

fn ctx_find_source_file(id i32) str {
	var sf SourceFile = ctx.filelist;
	while sf != nil {
		if sf.id == id {
			return sf.name;
		}
		sf = sf.next;
	}
	return "???";
}

// Attempt to create an output file named <basename>-<name><ext>
// if name is provided, <basename><ext> otherwise.
// Returns nil if enable is false or creation fails.
fn ctx_make_outfile(enable bool, name str, ext str) OutStream {
	if (!enable) || (ctx.out_base == nil) {
		return nil;
	}
	if name {
		var fname str = strcat(ctx.out_base, "-");
		fname = strcat(fname, name);
		fname = strcat(fname, ext);
		return OutFd(fd_create(fname));
	} else {
		return OutFd(fd_create(strcat(ctx.out_base, ext)));
	}
}

fn type_size(type Type) i32 {
	var kind i32 = type.kind;
	if kind == TYPE_U8 { return 1; }
	if kind == TYPE_U32 { return 4; }
	if kind == TYPE_I32 { return 4; }
	if kind == TYPE_ENUM { return 4; }
	if kind == TYPE_NIL { return 4; }
	if kind == TYPE_BOOL { return 4; }
	if kind == TYPE_POINTER { return 4; }
	//if kind == TYPE_SLICE { return 24; }
	if kind == TYPE_ARRAY { return type_size(type.of) * type.count; }
	if kind == TYPE_STRUCT { return type.count; }
	if kind == TYPE_STR { return type.count; }
	// VOID, ENUM, FN, UNDEFINED, etc
	return 0;
}

fn _mangle(a str, b str) String {
	var alen i32 = strlen(a);
	var blen i32 = strlen(b);
	var s []u8 = new([alen + blen + 2]u8); // TODO: use static buffer
	var n i32 = 0;
	var i i32 = 0;
	while i < alen {
		s[n] = a[i];
		n++;
		i++;
	}
	s[n] = '$';
	n++;
	i = 0;
	while i < blen {
		s[n] = b[i];
		n++;
		i++;
	}
	s[n] = 0;
	return string_make(s, n);
}

fn mangle(a String, b String) String {
	return _mangle(a.text, b.text);
}

