// ================================================================
// parser

fn expected(what str) {
	Error("expected @, found @").s(what).s(tnames[ctx.tok]);
}

fn expect(tok Token) {
	if ctx.tok != tok {
		expected(tnames[tok]);
	}
}

fn require(tok Token) {
	expect(tok);
	next();
}

fn parse_expr() Ast;
fn parse_block() Ast;
fn parse_type(fwd_ref_ok bool, missing_ok bool) Type;

fn parse_name(what str) String {
	if ctx.tok != tIDN {
		expected(what);
	}
	var s String = ctx.ident;
	next();
	return s;
}

fn parse_symbol(what str) Ast {
	var name String = parse_name(what);
	var sym Symbol = symbol_find(name);
	if sym == nil {
		Error("unknown @ '@'").s(what).s(name.text);
	}
	return ast_make_symbol(sym);
}

fn parse_fcall(fnode Ast, self Ast) Ast {
	// function call for fname/mname node, optional self param self
	next();
	var node Ast = ast_make_l(AST_CALL, fnode);
	var last Ast = nil;

	if self != nil {
		node.right = self;
		last = self;
	}
	while ctx.tok != tCPAREN {
		var expr Ast = parse_expr();
		if last != nil {
			last.next = expr;
		} else {
			node.right = expr;
		}
		last = expr;

		if ctx.tok != tCPAREN {
			require(tCOMMA);
		}
	}
	next();
	// type is the fn's return type
	node.type = fnode.type.of;
	return node;
}

fn parse_field_ref(node Ast, name String) Ast {
	var type Type = node.type;
	if type == nil {
		Error("BOGUS NODE TYPE @").s(ast_kind[node.kind]);
	}
	if type.kind == TYPE_POINTER {
		type = type.of;
	}
	if type.kind != TYPE_STRUCT {
		Error("expected struct found @").t(type);
	}
	var sym Symbol = type.list;
	while sym != nil {
		if sym.name == name {
			node = ast_make_lr(AST_FIELD, node, ast_make_symbol(sym));
			node.type = sym.type;
			return node;
		}
		sym = sym.next;
	}
	Error("struct '@' has no field '@'").s(type.name.text).s(name.text);
	return nil;
}

fn find_method(type Type, name String) Symbol {
	if type.kind == TYPE_POINTER {
		type = type.of;
	}
	var sym Symbol = type.methods;
	while sym != nil {
		if name.text == sym.name.text {
			return sym;
		}
		sym = sym.next;
	}
	return nil;
}

fn parse_ident() Ast {
	var node Ast = parse_symbol("identifier");

	if (node.sym == nil) {
		Error("undefined identifier '@'").s(node.sym.name.text);
	}

	if ctx.tok == tOPAREN {
		node = parse_fcall(node, nil);
	}

	while true {
		if ctx.tok == tDOT {
			next();
			var name String = parse_name("field or method name");
			if ctx.tok == tOPAREN {
				var sym Symbol = find_method(node.type, name);
				if sym {
					// method call
					node = parse_fcall(ast_make_symbol(sym), node);
				} else {
					// fn ptr call?
					node = parse_fcall(parse_field_ref(node, name), nil);
				}
			} else {
				// field access
				node = parse_field_ref(node, name);
			}
		} else if ctx.tok == tOBRACK {
			// array access
			next();
			// check for array?
			var type Type = node.type;
			if type.kind == TYPE_POINTER {
				type = type.of;
			}
			if type.kind != TYPE_ARRAY {
				Error("indexing a non-array type @").t(type);
			}
			node = ast_make_lr(AST_INDEX, node, parse_expr());
			node.type = type.of;
			require(tCBRACK);
		} else {
			return node;
		}
	}

	return nil; // unreachable
}

fn parse_array_typeof() Type;

fn parse_primary_expr() Ast {
	var node Ast;
	if ctx.tok == tNUM {
		node = ast_make_const(ctx.num, ctx.type_i32);
		next();
	} else if ctx.tok == tSTR {
		node = ast_make_simple(AST_STRING, 0);
		node.sval = string_make(ctx.tmp, strlen(ctx.tmp));
		node.type = ctx.type_str;
		next();
	} else if ctx.tok == tTRUE {
		node = ast_make_const(1, ctx.type_bool);
		next();
	} else if ctx.tok == tFALSE {
		node = ast_make_const(0, ctx.type_bool);
		next();
	} else if ctx.tok == tNIL {
		node = ast_make_const(0, ctx.type_nil);
		next();
	} else if ctx.tok == tOPAREN {
		next();
		node = parse_expr();
		require(tCPAREN);
	} else if ctx.tok == tNEW {
		next();
		require(tOPAREN);
		var type Type;
		var szarg Ast;
		if ctx.tok == tOBRACK {
			next();
			szarg = parse_expr();
			require(tCBRACK);
			type = type_make(nil, TYPE_ARRAY, parse_array_typeof(), nil, 0);
			szarg = ast_make_lr(AST_MUL, szarg,
					ast_make_const(type_size(type.of), ctx.type_u32));
		} else {
			type = parse_type(false, false);
			szarg = ast_make_const(type_size(type), ctx.type_u32);
		}
		node = ast_make_symbol(symbol_find(ctx.str_new_fn));
		node = ast_make_lr(AST_CALL, node, szarg);
		if type.kind == TYPE_STRUCT {
			node.type = type.of;
		} else if type.kind == TYPE_ARRAY {
			node.type = type_make_ptr(type);
		} else {
			Error("cannot allocate '@' with new").s(type.name.text);
		}
		// TODO: do this instead and transform to call later on:
		//node = ast_make_simple(AST_NEW, 0);
		//node.type = parse_type(false);
		//node.type = node.type.of;
		require(tCPAREN);
	} else if ctx.tok == tIDN {
		node = parse_ident();
	} else {
		Error("invalid expression: unexpected @").s(tnames[ctx.tok]);
	}
	return node;
}

fn parse_unary_expr() Ast {
	var op u32 = ctx.tok;
	var posn u32 = ctx.srcloc;
	if op == tPLUS {
		next();
		return parse_unary_expr();
	} else if op == tMINUS {
		next();
		return ast_posn(ast_make_l(AST_NEG, parse_unary_expr()), posn);
	} else if op == tBANG {
		next();
		return ast_posn(ast_make_l(AST_BOOL_NOT, parse_unary_expr()), posn);
	} else if op == tNOT {
		next();
		return ast_posn(ast_make_l(AST_NOT, parse_unary_expr()), posn);
	} else if op == tAMP {
		Error("dereference not supported");
		//next();
		//parse_unary_expr();
	} else {
		return parse_primary_expr();
	}
	return nil; // unreachable
}

fn parse_mul_expr() Ast {
	var posn u32 = ctx.srcloc;
	var node Ast = parse_unary_expr();
	while ctx.tok & tcMASK == tcMULOP {
		var op u32 = (ctx.tok - tSTAR) + AST_MUL;
		next();
		node = ast_posn(ast_make_lr(op, node, parse_unary_expr()), posn);
	}
	return node;
}

fn parse_add_expr() Ast {
	var node Ast = parse_mul_expr();
	while ctx.tok & tcMASK == tcADDOP {
		var op u32 = (ctx.tok - tPLUS) + AST_ADD;
		next();
		node = ast_make_lr(op, node, parse_mul_expr());
	}
	return node;
}

fn parse_rel_expr() Ast {
	var posn u32 = ctx.srcloc;
	var node Ast = parse_add_expr();
	if ctx.tok & tcMASK == tcRELOP {
		var op u32 = (ctx.tok - tEQ) + AST_EQ;
		next();
		node = ast_posn(ast_make_lr(op, node, parse_add_expr()), posn);
	}
	return node;
}

fn parse_and_expr() Ast {
	var posn u32 = ctx.srcloc;
	var node Ast = parse_rel_expr();
	if ctx.tok == tAND {
		while ctx.tok == tAND {
			next();
			node = ast_posn(ast_make_lr(AST_BOOL_AND, node, parse_rel_expr()), posn);
		}
	}
	return node;
}

fn parse_expr() Ast {
	var posn u32 = ctx.srcloc;
	var node Ast = parse_and_expr();
	if ctx.tok == tOR {
		while ctx.tok == tOR {
			next();
			node = ast_posn(ast_make_lr(AST_BOOL_OR, node, parse_and_expr()), posn);
		}
	}
	return node;
}

fn parse_struct_type(name String) Type {
	var type Type = type_find(name);

	if type == nil {
		// pointer-to-struct is so commonly used, we always
		// create it alongside the struct and they reference
		// each other via their of fields
		type = type_make(name, TYPE_STRUCT, nil, nil, 0);
		type.of = type_make(nil, TYPE_POINTER, type, nil, 0);
	} else {
		if type.kind == TYPE_UNDEFINED {
			// resolve forward ref
			type.kind = TYPE_STRUCT;
		} else {
			Error("cannot redefine struct '@'").s(name.text);
		}
	};
	var off i32 = 0;
	var ptr bool = false;
	scope_push(SCOPE_STRUCT);
	require(tOBRACE);
	while true {
		if ctx.tok == tCBRACE {
			next();
			break;
		}
		var fname String = parse_name("field name");
		var kind SymbolKind = SYMBOL_FLD;
		if ctx.tok == tSTAR {
			next();
			ptr = true;
		} else {
			ptr = false;
		}
		var ftype Type = parse_type(true, false);
		if (ftype.kind == TYPE_ARRAY) && (ftype.count == 0) { ptr = true; }
		if ptr {
			if (ftype.kind == TYPE_STRUCT) || (ftype.kind == TYPE_UNDEFINED) {
				// use the pointer-to-struct
				ftype = ftype.of;
			} else if ftype.kind == TYPE_ARRAY {
				// TODO: can we cache these somewhere?
				ftype = type_make_ptr(ftype);
			} else {
				Error("pointer to '@' not allowed").s(ftype.name.text);
			}
		}
		symbol_make(fname, ftype, kind, off);
		if ctx.tok != tCBRACE {
			require(tCOMMA);
		}
		off += type_size(ftype);
	}
	type.list = scope_pop();
	type.count = off;
	return type;
}


// arrays may be of pointer-to-Struct similar to how
// structs may contain pointer-to-Struct members
fn parse_array_typeof() Type {
	if ctx.tok == tSTAR {
		next();
		var type Type = parse_type(false, false);
		if type.kind != TYPE_STRUCT {
			Error("pointer to non-struct");
		}
		return type.of;
	} else {
		return parse_type(false, false);
	}
}

fn parse_array_type() Type {
	var type Type;
	var nelem i32 = 0;
	if ctx.tok == tCBRACK {
		// TODO: slices
		next();
		type = type_make(nil, TYPE_ARRAY, parse_array_typeof(), nil, 0);
	} else {
		var node Ast = parse_expr();
		nelem = eval_const_expr(node);
		if nelem < 0 {
			Error("negative array size");
		}
		require(tCBRACK);
		type = type_make(nil, TYPE_ARRAY, parse_array_typeof(), nil, nelem);
	}
	// TODO: type.name?
	return type;
}

fn parse_fn_type() Type;

fn parse_named_type(name String, fwd_ref_ok bool) Type {
	var type Type = type_find(name);
	if type == nil {
		if fwd_ref_ok {
			// pointer-to-struct is so commonly used, we always
			// create it alongside the struct and they reference
			// each other via their of fields
			type = type_make(name, TYPE_UNDEFINED, nil, nil, 0);
			type.of = type_make(nil, TYPE_POINTER, type, nil, 0);
		} else {
			Error("undefined type '@' not usable here").s(name.text);
		}
	}
	return type;
}

fn parse_type(fwd_ref_ok bool, missing_ok bool) Type {
	if ctx.tok == tIDN {
		var name String = ctx.ident;
		next();
		return parse_named_type(name, fwd_ref_ok);
	} else if ctx.tok == tOBRACK { // array-of
		next();
		return parse_array_type();
	} else if ctx.tok == tFN {
		next();
		return parse_fn_type();
	} else if ctx.tok == tDOLLAR {
		next();
		return type_anon(parse_name("anonymous type"));
	} if ctx.tok == tSTAR { // pointer-to
		Error("pointer types not supported");
		//next();
		//return type_make(nil, TYPE_POINTER, parse_type(true), nil, 0);
	} else if ctx.tok == tSTRUCT {
		Error ("anonymous struct types not supported");
		//next();
		//return parse_struct_type(nil);
	} else {
		if !missing_ok {
			expected("type");
		}
	}
	return nil;
}

fn parse_while() Ast {
	// while expr { block }
	var posn u32 = ctx.srcloc;
	var expr Ast = parse_expr();
	require(tOBRACE);
	scope_push(SCOPE_LOOP);
	var block Ast = parse_block();
	block.sym = scope_pop();
	return ast_posn(ast_make_lr(AST_WHILE, expr, block), posn);
}

fn parse_if() Ast {
	// if expr { block }
	var posn u32 = ctx.srcloc;
	var expr Ast = parse_expr();
	require(tOBRACE);
	scope_push(SCOPE_BLOCK);
	var block Ast = parse_block();
	block.sym = scope_pop();

	var last Ast = ast_posn(ast_make_lr(AST_CASE, expr, block), posn);
	var stmt Ast = ast_posn(ast_make_l(AST_IF, last), posn);

	while ctx.tok == tELSE {
		// ... else ...
		next();
		if ctx.tok == tIF {
			// ... if expr { block }
			posn = ctx.srcloc;
			next();
			expr = parse_expr();
			require(tOBRACE);
			scope_push(SCOPE_BLOCK);
			block = parse_block();
			block.sym = scope_pop();
			last.next = ast_posn(ast_make_lr(AST_CASE, expr, block), posn);
			last = last.next;
		} else {
			// ... { block }
			posn = ctx.srcloc;
			require(tOBRACE);
			scope_push(SCOPE_BLOCK);
			block = parse_block();
			block.sym = scope_pop();
			last.next = ast_posn(ast_make_l(AST_ELSE, block), posn);
			break;
		}
	}
	return stmt;
}

fn parse_return() Ast {
	// TODO check for return required/type
	var node Ast = ast_make_simple(AST_RETURN, 0);
	if ctx.tok == tSEMI {
		next();
	} else {
		//	Error("return types do not match");
		node.left = parse_expr();
		require(tSEMI);
	}
	return node;
}

fn parse_break() Ast {
	// TODO: break-to-labeled-loop support
	var scope Scope = scope_find(SCOPE_LOOP);
	if scope == nil {
		Error("break must be used from inside a looping construct");
	}
	require(tSEMI);
	return ast_make_simple(AST_BREAK, 0);
}

fn parse_continue() Ast {
	// TODO: continue-to-labeled-loop support
	var scope Scope = scope_find(SCOPE_LOOP);
	if scope == nil {
		Error("continue must be used from inside a looping construct");
	}
	require(tSEMI);
	return ast_make_simple(AST_CONTINUE, 0);
}

fn ast_insert_by_ival(list Ast, node Ast) Ast {
	if list == nil {
		return node;
	}
	if list.ival > node.ival {
		node.next = list;
		return node;
	}
	var last Ast = list;
	while true {
		if last.next == nil {
			last.next = node;
			break;
		}
		if last.next.ival > node.ival {
			node.next = last.next;
			last.next = node;
			break;
		}
		last = last.next;
	}
	return list;
}

// sym type must be kind STRUCT or POINTER->STRUCT
fn parse_struct_init(sym Symbol) Ast {
	var list Ast = nil;
	var node Ast;

	var type Type = sym.type;
	if type.kind == TYPE_POINTER {
		type = type.of;
	}
	while true {
		if ctx.tok == tCBRACE {
			next();
			break;
		}
		var posn u32 = ctx.srcloc;
		var name String = parse_name("field name");
		var field Symbol = type.list;
		while true { // TODO: field_find
			if field == nil {
				Error("structure has no '@' field").s(name.text);
			}
			if field.name == name {
				break;
			}
			field = field.next;
		}
		require(tCOLON);
		if ctx.tok == tOBRACE {
			next();
			node = parse_struct_init(field);
		} else {
			node = parse_expr();
		}
		node = ast_posn(ast_make_lr(AST_ASSIGN, ast_make_symbol(field), node), posn);
		node.ival = field.ival;
		list = ast_insert_by_ival(list, node);
		if ctx.tok != tCBRACE {
			require(tCOMMA);
		}
	}
	return list;
}

fn parse_array_init(typeof Type, size i32) Ast {
	var list Ast = ast_make_simple(AST_ARRAY, size);
	var last Ast = nil;
	var count i32 = 0;
	while true {
		if ctx.tok == tCBRACE {
			next();
			break;
		}
		var node Ast = parse_expr();
		if last {
			last.next = node;
		} else {
			list.left = node;
		}
		last = node;
		if ctx.tok != tCBRACE {
			require(tCOMMA);
		}
		count++;
	}
	if count > size {
		if size == 0 {
			// unspecied in type, inherit from initializer
			list.ival = count;
		} else {
			Error("array initializer too large: @ > @").n(count).n(size);
		}
	}
	list.type = typeof;
	return list;
}

fn parse_var(kind SymbolKind) Ast {
	// TODO: correctly calculate ival (or assign later?)
	var node Ast = nil;
	var posn u32 = ctx.srcloc;
	var name String = parse_name("variable name");
	var type Type = parse_type(false, false);
	if (type.kind == TYPE_STRUCT) || (type.kind == TYPE_UNDEFINED) {
		type = type.of; // use the pointer-to-struct
	}
	if (type.kind == TYPE_ARRAY) {
		type = type_make_ptr(type);
	}
	var sym Symbol = symbol_make(name, type, SYMBOL_VAR | kind, 0);
	if type.kind == TYPE_POINTER {
		type = type.of;
	}
	if ctx.tok == tASSIGN {
		next();
		if ctx.tok == tOBRACE {
			next();
			if type.kind == TYPE_STRUCT {
				node = parse_struct_init(sym);
			} else if type.kind == TYPE_ARRAY {
				node = parse_array_init(type.of, type.count);
			} else {
				Error("type @ cannot be initialized with {} expr").t(type);
			}
		} else {
			node = parse_expr();
		}
	} else {
		// default init
		if (type.kind == TYPE_ARRAY) && (type.count > 0) {
			node = ast_make_simple(AST_ARRAY, type.count);
			node.type = type.of;
		} else {
			node = ast_make_simple(AST_CONST, 0);
		}
	}
	require(tSEMI);
	node = ast_posn(ast_make_lr(AST_ASSIGN, ast_make_symbol(sym), node), posn);
	return node;
}

fn _parse_expr_statement() Ast {
	var node Ast = parse_expr();
	var expr Ast = nil;
	var op u32;

	if ctx.tok == tASSIGN {
		// basic assignment
		next();
		var posn u32 = ctx.srcloc;
		return ast_posn(ast_make_lr(AST_ASSIGN, node, parse_expr()), posn);
	} else if (ctx.tok & tcMASK) == tcAEQOP {
		// +=, etc
		op = (ctx.tok - tADDEQ) + AST_ADD;
		next();
		expr = parse_expr();
	} else if (ctx.tok & tcMASK) == tcMEQOP {
		// *=, etc
		op = (ctx.tok - tMULEQ) + AST_MUL;
		next();
		expr = parse_expr();
	} else if (ctx.tok == tINC) {
		op = AST_ADD;
		next();
		expr = ast_make_const(1, ctx.type_i32);
	} else if (ctx.tok == tDEC) {
		op = AST_SUB;
		next();
		expr = ast_make_const(1, ctx.type_i32);
	} else {
		// simple expression
		return node;
	}

	// TODO duplicate node instead of sharing it
	expr = ast_make_lr(op, node, expr);
	return ast_make_lr(AST_ASSIGN, node, expr);
}

fn parse_expr_statement() Ast {
	var posn u32 = ctx.srcloc;
	var stmt Ast = ast_posn(_parse_expr_statement(), posn);
	require(tSEMI);
	return stmt;
}

fn maybe_const(node Ast) i32 {
	if node.kind == AST_CONST {
		if node.ival == 0 {
			return 0;
		} else {
			return 1;
		}
	}
	if node.kind == AST_SYMBOL {
		if node.sym.kind & SYMBOL_DEF {
			if node.sym.ival == 0 {
				return 0;
			} else {
				return 1;
			}
		}
	}
	return -1;
}

fn parse_block() Ast {
	var block Ast = ast_make_simple(AST_BLOCK, 0);
	var last Ast = nil;
	var node Ast;
	while true {
		if ctx.tok == tCBRACE {
			next();
			break;
		} else if ctx.tok == tRETURN {
			next();
			node = parse_return();
		} else if ctx.tok == tBREAK {
			next();
			node = parse_break();
		} else if ctx.tok == tCONTINUE {
			next();
			node = parse_continue();
		} else if ctx.tok == tWHILE {
			next();
			node = parse_while();
		} else if ctx.tok == tIF {
			next();
			node = parse_if();
			// simplify forms like: if <const> { ... }
			// by eliminating them entirely (for false)
			// or reducing them to the code block only (for true)
			if (node.left.next == nil) {
				var c i32 = maybe_const(node.left.left);
				if c == 0 {
					continue;
				}
				if c == 1 {
					node = node.left.right;
				}
			}
		} else if ctx.tok == tVAR {
			next();
			node = parse_var(SYMBOL_LOCAL);
			if node == nil {
				continue;
			}
		} else if ctx.tok == tSEMI {
			next();
			// empty statement
			continue;
		} else {
			node = parse_expr_statement();
		}
		if last == nil {
			block.left = node;
		} else {
			last.next = node;
		}
		last = node;
	}
	return block;
}

fn parse_param(ival i32, require_name bool) Symbol {
	var kind SymbolKind = SYMBOL_VAR | SYMBOL_PARAM;
	var name String;
	var type Type;
	if (ctx.tok != tIDN) && (ctx.tok != tDOLLAR) && (!require_name) {
		// A non-identifier can only (validly) be something
		// like an array type, and only if !require_name.
		type = parse_type(false, false);
		// and we'll use "_" for the anonymous name
		name = ctx.str_underscore;
		kind |= SYMBOL_ANON;
	} else {
		// otherwise consume the token, which may be the name...
		name = parse_name("parameter name");
		if require_name || (ctx.tok == tIDN) || (ctx.tok == tDOLLAR) {
			// if the next token is also an ident token,
			// or we are requiring names, parse it as the type
			type = parse_type(false, false);
		} else {
			// otherwise the name we have must be the name of
			// a named type (followed by a comma, cparen, etc)
			// so parse it thusly
			type = parse_named_type(name, false);
			// and we'll use "_" for the anonymous name
			name = ctx.str_underscore;
			kind |= SYMBOL_ANON;
		}
	}
	if (type.kind == TYPE_STRUCT) || (type.kind == TYPE_UNDEFINED) {
		type = type.of; // use the pointer-to-struct
	}
	if type.kind == TYPE_ARRAY {
		type = type_make_ptr(type);
	}
	if require_name {
		// check only in current scope to avoid errors
		// about pnames that mask globals (which is allowed)
		if symbol_find_in(name, ctx.scope) != nil {
			Error("duplicate parameter name '@'").s(name.text);
		}
	}
	return symbol_make(name, type, kind, ival);
}

fn parse_fn_body(sym Symbol) Ast {
	ctx.cur_fn = sym;
	require(tOBRACE);
	scope_push(SCOPE_BLOCK);
	var block Ast = parse_block();
	block.sym = scope_pop();
	ctx.cur_fn = nil;
	return block;
}

// shared between parse_fn() for top-level function declarations
// and definitions and parse_fn_type() for function types
fn parse_fn_core(fname String, method_of Type, node Ast, n i32) Type {
	var posn u32 = ctx.srcloc;
	var require_name bool = (node != nil);

	require(tOPAREN);
	if ctx.tok != tCPAREN {
		parse_param(4 * n, require_name);
		n++;
		while ctx.tok == tCOMMA {
			next();
			parse_param(4 * n, require_name);
			n++;
		}
	}
	require(tCPAREN);

	var rtype Type = parse_type(false, true);
	if rtype == nil {
		rtype = ctx.type_void;
	}
	if rtype.kind == TYPE_STRUCT {
		// struct return types are adjusted to pointer-to-struct
		rtype = rtype.of;
	}
	var type Type = type_make(fname, TYPE_FN, rtype, nil, n);

	if method_of != nil {
		var sym Symbol = symbol_make_in_scope(fname, type, SYMBOL_FN, 0, nil);
		sym.next = method_of.methods;
		method_of.methods = sym;
		fname = mangle(method_of.name, fname);
		type.name = fname;
	}

	if node == nil {
		// if we have not been provided with an AST node, we're
		// just parsing the type, not a full top-level declaration
		// or definition, so wrap things up here:
		type.list = scope_pop();
		return type;
	}

	var sym Symbol = symbol_make_in_scope(fname, type, SYMBOL_FN, 0, nil);
	sym.ival = posn;
	node.sym = sym;

	var prev Symbol = symbol_find_in(fname, ctx.global);
	if prev == nil {
		// if no previous definition, add to global before
		// parsing fn body so recursive calls resolve
		scope_add(ctx.global, sym);
	}

	if ctx.tok == tSEMI {
		// no function body: it's a declaration
		sym.kind |= SYMBOL_DECL;
		next();
	} else {
		node.left = parse_fn_body(sym);
	}

	// save parameters (must do this *after* fn body parsing)
	type.list = scope_pop();

	// if there is an existing global sharing the name...
	if prev != nil {
		// may not be redefined
		if ((prev.kind & SYMBOL_DECL) == 0) && ((sym.kind & SYMBOL_DECL) == 0) {
			Error("fn @ redefined").s(sym.name.text);
		}
		// signature must not change
		if types_match(prev.type, sym.type) == false {
			Error("fn @ differs from previous definition at @:@")
			.s(sym.name.text).s(srcloc_file(prev.ival)).n(srcloc_line(prev.ival));
		}
		// if this is a definition flag that we've been defined
		// in the symbol that's in the global symbol table
		if !(sym.kind & SYMBOL_DECL) {
			prev.kind &= (~SYMBOL_DECL);
		}
	}

	// TODO: if previously declared, the symbol in the global table
	// is *not* the one referenced by the fn definition, though their
	// names are identical so linkage works out, but this is still a
	// little weird.  Ideally should fuse them.
	return nil;
}

fn parse_fn_type() Type {
	scope_push(SCOPE_FUNC);
	return parse_fn_core(nil, nil, nil, 0);
}

fn parse_fn() Ast {
	scope_push(SCOPE_FUNC);
	var posn u32 = ctx.srcloc;
	var n u32 = 0;
	var method_of Type = nil;

	if ctx.tok == tOPAREN {
		next();
		// (self SelfType) ...
		var sym Symbol = parse_param(0, true);
		method_of = sym.type.of;
		require(tCPAREN);
		n = 1;
	}

	var fname String = parse_name("function name");

	var node Ast = ast_posn(ast_make_simple(AST_FUNC, 0), posn);
	parse_fn_core(fname, method_of, node, n);

	return node;
}

fn parse_enum_def() {
	if ctx.tok == tIDN {
		var name String = parse_name("enum name");
		type_make(name, TYPE_ENUM, nil, nil, 0);
	}

	require(tOBRACE);
	var val u32 = 0;
	while ctx.tok != tCBRACE {
		var name String = parse_name("enum tag name");
		var sym Symbol = symbol_find(name);
		if sym != nil {
			Error("cannot redfine '@' as enum tag").s(name.text);
		}
		sym = symbol_make_global(name, ctx.type_u32, SYMBOL_DEF, 0);
		if ctx.tok == tASSIGN {
			next();
			sym.ival = eval_const_expr(parse_expr());
			val = sym.ival + 1;
			// TODO: store subtree for later eval instead?
		} else {
			sym.ival = val;
			val++;
		}
		require(tCOMMA);
	}
	require(tCBRACE);
	require(tSEMI);
}

fn parse_init() {
	ctx.program = ast_make_simple(AST_PROGRAM, 0);
	ctx.last = nil;
}

fn parse_program() Ast {
	var node Ast = nil;
	while true {
		// anonymous types only have scope for the
		// currently being parsed top-level entity
		ctx.anontypelist = nil;

		if ctx.tok == tEOF {
			break;
		} else if ctx.tok == tENUM {
			next();
			parse_enum_def();
			continue;
		} else if ctx.tok == tSTRUCT {
			next();
			var name String = parse_name("struct name");
			parse_struct_type(name);
			require(tSEMI);
			continue;
		} else if ctx.tok == tFN {
			next();
			node = parse_fn();
		} else if ctx.tok == tVAR {
			next();
			node = parse_var(SYMBOL_GLOBAL);
			if node == nil {
				continue;
			}
		} else {
			expected("function, variable, or type definition");
		}
		if ctx.last == nil {
			ctx.program.left = node;
		} else {
			ctx.last.next = node;
		}
		ctx.last = node;
	}
	return ctx.program;
}

