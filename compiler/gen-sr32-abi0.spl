// This is a bootstrapping code-generator for softrisc32 "abi0",
// which uses most registers (8..31) as caller-save temporaries
// and does all parameter passing via the stack

// There is absolutely no optimization of any kind here, the
// goal being correct sr32 code sufficient to compile the full
// compiler so it can then compile itself (with the real backend).

// Language features not present in the bootstrap transpiler are
// avoided.

enum CodeGenConfig {
	MaxTmpRegs = 8,
	FirstTmpReg = 8,
};

var os OutStream;

fn emit(msg str) OutStream {
	os.msg = msg;
	os.idx = 0;
	os_advance(os);
	return os;
}

var local_max u32 = 0;
var tmp_mask u32 = 0;

fn find_bit(set u32) u32 {
	var n u32 = 0;
	while n < 32 {
		if (set & (1u << n)) == 0 {
			break;
		}
		n++;
	}
	return n;
}

fn get_reg() u32 {
	var n u32 = find_bit(tmp_mask);
	if n > MaxTmpRegs {
		Error("out of temporary registers");
	}
	tmp_mask |= (1u << n);
	return n + FirstTmpReg;
}

fn put_reg(n u32) {
	if n != 0 {
		n = 1u << (n - FirstTmpReg);
		if (tmp_mask & n) == 0 {
			Error("freeing unallocated temporary register @").u(n);
		}
		tmp_mask &^= n;
	}
}

var nextlabel u32 = 0;

fn make_label() u32 {
	var n u32 = nextlabel;
	nextlabel++;
	return n;
}
fn emit_target(id u32) {
	emit("L$@:\n").u(id);
}
fn emit_branch(x str, a u32, b u32, tgt u32) {
	emit("    b@ x@, x@, L$@\n").s(x).u(a).u(b).u(tgt);
}
fn emit_jump(tgt u32) {
	emit("    j L$@\n").u(tgt);
}
fn emit_binop(op str, t u32, a u32, b u32) {
	emit("    @ x@, x@, x@\n").s(op).u(t).u(a).u(b);
}
fn emit_li(t u32, v u32) {
	emit("    li x@, @\n").u(t).u(v);
}

fn gen_expr(node Ast) u32;
fn gen_block(node Ast);

fn gen_relop(node Ast, op str, opu str) u32 {
	var ttrue u32 = make_label();
	var tdone u32 = make_label();
	var a u32 = gen_expr(node.left);
	var b u32 = gen_expr(node.right);
	if !(node.left.type.kind & TYPE_IS_SIGNED) {
		op = opu;
	}
	emit_branch(op, a, b, ttrue);
	emit_li(a, 0);
	emit_jump(tdone);
	emit_target(ttrue);
	emit_li(a, 1);
	emit_target(tdone);
	put_reg(b);
	return a;
}

fn gen_binop(node Ast, op str) u32 {
	var a u32 = gen_expr(node.left);
	var b u32 = gen_expr(node.right);
	emit_binop(op, a, a, b);
	put_reg(b);
	return a;
}

fn gen_clrop(node Ast) u32 {
	var a u32 = gen_expr(node.left);
	var b u32 = gen_expr(node.right);
	emit("    not x@, x@\n").u(b).u(b);
	emit_binop("and", a, a, b);
	put_reg(b);
	return a;
}

fn gen_unop(node Ast, op str) u32 {
	var x u32 = gen_expr(node.left);
	emit("    @ x@, x@\n").s(op).u(x).u(x);
	return x;
}

fn emit_load_tmp() {
	var n u32 = 0;
	while n < MaxTmpRegs {
		if tmp_mask & (1u << n) {
			emit("    ldw x@, -@(fp) //RT\n")
			.u(FirstTmpReg + n).u(local_max + 4*n);
		}
		n++;
	}
}
fn emit_save_tmp() {
	var n u32 = 0;
	while n < MaxTmpRegs {
		if tmp_mask & (1u << n) {
			emit("    stw x@, -@(fp) //ST\n")
			.u(FirstTmpReg + n).u(local_max + 4*n);
		}
		n++;
	}
}

fn gen_string_const(s str) u32 {
	var id u32 = make_string_chunk(s);
	var r u32 = get_reg();
	emit("    la x@, G$@\n").u(r).u(id);
	return r;
}

fn gen_call(fcall Ast) u32 {
	var type Type = fcall.left.type;
	if type.kind == TYPE_POINTER {
		type = type.of;
	}
	if type.count > 0 {
		emit("    subi sp, sp, @\n").u(type.count * 4);
	}
	var n u32 = 0;
	var node Ast = fcall.right;
	while node != nil {
		var x u32 = gen_expr(node);
		emit("    stw x@, @(sp)\n").u(x).u(n * 4);
		put_reg(x);
		n++;
		node = node.next;
	}
	emit_save_tmp();
	if fcall.left.kind == AST_FNNAME {
		// TODO: possibly better way to get the (mangled) canonical
		// function name from a method than indirecting through the type?
		var sym Symbol = fcall.left.sym;
		if sym == nil { ErrorAt(fcall, "illegal nil fncall"); }
		emit("    call @\n").s(sym.type.name.text);
	} else {
		// fn pointer
		var fptr u32 = gen_expr(fcall.left);
		emit("    jalr ra, x@\n").u(fptr);
	}
	if type.count > 0 {
		emit("    addi sp, sp, @\n").u(type.count * 4);
	}
	emit_load_tmp();

	if type.of == ctx.type_void {
		return 0;
	} else {
		var t u32 = get_reg();
		emit("    mv x@, rv\n").u(t);
		return t;
	}
}

fn gen_load_ptr(node Ast) u32 {
	var ar u32 = gen_expr(node.left);
	var sz u32 = type_size(node.type);
	if sz > 4 { ErrorAt(node, "illegal sz @ load").u(sz); }
	if node.type.kind & TYPE_IS_SIGNED {
		if sz == 1 { emit("    ldb x@, (x@)\n").u(ar).u(ar); }
		if sz == 2 { emit("    ldh x@, (x@)\n").u(ar).u(ar); }
		if sz == 4 { emit("    ldw x@, (x@)\n").u(ar).u(ar); }
	} else {
		if sz == 1 { emit("    ldbu x@, (x@)\n").u(ar).u(ar); }
		if sz == 2 { emit("    ldhu x@, (x@)\n").u(ar).u(ar); }
		if sz == 4 { emit("    ldw x@, (x@)\n").u(ar).u(ar); }
	}
	return ar;
}

fn gen_store_ptr(node Ast) u32 {
	var ar u32 = gen_expr(node.left);
	var vr u32 = gen_expr(node.right);
	var sz u32 = type_size(node.type);
	if sz > 4 { ErrorAt(node, "illegal sz @ store").u(sz); }
	if sz == 1 { emit("    stb x@, (x@)\n").u(vr).u(ar); }
	if sz == 2 { emit("    sth x@, (x@)\n").u(vr).u(ar); }
	if sz == 4 { emit("    stw x@, (x@)\n").u(vr).u(ar); }
	put_reg(ar);
	return vr;
}

fn gen_addrof_elem(node Ast) u32 {
	var ar u32 = gen_expr(node.left);
	var ir u32 = gen_expr(node.right);
	// left must be a pointer-to-array
	var sz u32 = type_size(node.left.type.of.of);
	if sz == 2 {
		emit("    slli x@, x@, 1\n").u(ir).u(ir);
	} else if sz == 4 {
		emit("    slli x@, x@, 2\n").u(ir).u(ir);
	} else if sz != 1 {
		emit("    muli x@, x@, @\n").u(ir).u(ir).u(sz);
	}
	emit("    add x@, x@, x@\n").u(ar).u(ar).u(ir);
	put_reg(ir);
	return ar;
}

fn gen_addrof_field(node Ast) u32 {
	var ar u32 = gen_expr(node.left);
	emit("    addi x@, x@, @\n").u(ar).u(ar).u(node.sym.ival);
	return ar;
}

fn gen_load_fnaddr(node Ast) u32 {
	var t u32 = get_reg();
	emit("    la x@, @\n").u(t).s(node.sym.type.name.text);
	return t;
}

fn gen_load_local(node Ast) u32 {
	var t u32 = get_reg();
	emit("    ldw x@, -@(fp)\n").u(t).u(node.sym.ival);
	return t;
}

fn gen_load_param(node Ast) u32 {
	var t u32 = get_reg();
	emit("    ldw x@, @(fp)\n").u(t).u(node.sym.ival);
	return t;
}

fn gen_load_global(node Ast) u32 {
	var t u32 = get_reg();
	emit("    ldw x@, @(gp)\n").u(t).u(node.sym.ival);
	return t;
}

fn gen_store_local(node Ast) u32 {
	var t u32 = gen_expr(node.left);
	emit("    stw x@, -@(fp)\n").u(t).u(node.sym.ival);
	return t;
}

fn gen_store_param(node Ast) u32 {
	var t u32 = gen_expr(node.left);
	emit("    stw x@, @(fp)\n").u(t).u(node.sym.ival);
	return t;
}

fn gen_store_global(node Ast) u32 {
	var t u32 = gen_expr(node.left);
	emit("    stw x@, @(gp)\n").u(t).u(node.sym.ival);
	return t;
}

fn gen_load_const(node Ast) u32 {
	var t u32 = get_reg();
	emit_li(t, node.ival);
	return t;
}

fn gen_bool_and(node Ast) u32 {
	var t u32 = get_reg();
	emit_li(t, 0);
	var res0 u32 = make_label();
	var x u32 = gen_expr(node.left);
	emit_branch("eq", x, 0, res0);
	put_reg(x);
	x = gen_expr(node.right);
	emit_branch("eq", x, 0, res0);
	put_reg(x);
	emit_li(t, 1);
	emit_target(res0);
	return t;
}

fn gen_bool_or(node Ast) u32 {
	var t u32 = get_reg();
	emit_li(t, 1);
	var res1 u32 = make_label();
	var x u32 = gen_expr(node.left);
	emit_branch("ne", x, 0, res1);
	put_reg(x);
	x = gen_expr(node.right);
	emit_branch("ne", x, 0, res1);
	put_reg(x);
	emit_li(t, 0);
	emit_target(res1);
	return t;
}

fn gen_expr(node Ast) u32 {
	var kind AstKind = node.kind;
	if kind == AST_CONST    { return gen_load_const(node); }
	if kind == AST_FNADDR   { return gen_load_fnaddr(node); }
	if kind == AST_EQ       { return gen_relop(node, "eq", "eq"); }
	if kind == AST_NE       { return gen_relop(node, "ne", "ne"); }
	if kind == AST_LT       { return gen_relop(node, "lt", "ltu"); }
	if kind == AST_LE       { return gen_relop(node, "le", "leu"); }
	if kind == AST_GT       { return gen_relop(node, "gt", "gtu"); }
	if kind == AST_GE       { return gen_relop(node, "ge", "geu"); }
	if kind == AST_ADD      { return gen_binop(node, "add"); }
	if kind == AST_SUB      { return gen_binop(node, "sub"); }
	if kind == AST_OR       { return gen_binop(node, "or"); }
	if kind == AST_XOR      { return gen_binop(node, "xor"); }
	if kind == AST_MUL      { return gen_binop(node, "mul"); }
	if kind == AST_DIV      { return gen_binop(node, "div"); }
	if kind == AST_MOD      { return gen_binop(node, "rem"); }
	if kind == AST_AND      { return gen_binop(node, "and"); }
	if kind == AST_CLR      { return gen_clrop(node); }
	if kind == AST_LSL      { return gen_binop(node, "sll"); }
	if kind == AST_LSR      { return gen_binop(node, "srl"); }
	if kind == AST_NOT      { return gen_unop(node, "not"); }
	if kind == AST_NEG      { return gen_unop(node, "neg"); }
	if kind == AST_BOOL_NOT { return gen_unop(node, "seqz"); }
	if kind == AST_BOOL_AND { return gen_bool_and(node); }
	if kind == AST_BOOL_OR  { return gen_bool_or(node); }
	if kind == AST_STRING   { return gen_string_const(node.sval.text); }
	if kind == AST_CALL          { return gen_call(node); }
	if kind == AST_LOAD_LOCAL    { return gen_load_local(node); }
	if kind == AST_STORE_LOCAL   { return gen_store_local(node); }
	if kind == AST_LOAD_PARAM    { return gen_load_param(node); }
	if kind == AST_STORE_PARAM   { return gen_store_param(node); }
	if kind == AST_LOAD_GLOBAL   { return gen_load_global(node); }
	if kind == AST_STORE_GLOBAL  { return gen_store_global(node); }
	if kind == AST_ADDROF_ELEM   { return gen_addrof_elem(node); }
	if kind == AST_ADDROF_FIELD  { return gen_addrof_field(node); }
	if kind == AST_LOAD_PTR      { return gen_load_ptr(node); }
	if kind == AST_STORE_PTR     { return gen_store_ptr(node); }
	if kind == AST_CAST          { return gen_expr(node.left); }
	ErrorAt(node, "illegal @ in expr").s(ast_kind[kind]);
	return 0;
}

enum {
	INVALID_TARGET = 0xffffffff,
};

var return_target u32 = INVALID_TARGET;
var continue_target u32 = INVALID_TARGET;
var break_target u32 = INVALID_TARGET;
var return_type Type = nil;

fn gen_while(node Ast) {
	var save_ct u32 = continue_target;
	var save_bt u32 = break_target;

	var loop u32 = make_label();
	var exit u32 = make_label();
	continue_target = loop;
	break_target = exit;

	emit_target(loop);
	var a u32 = gen_expr(node.left);
	emit_branch("eq", a, 0, exit);
	put_reg(a);
	gen_block(node.right);
	emit_jump(loop);
	emit_target(exit);

	continue_target = save_ct;
	break_target = save_bt;
}

fn gen_break(node Ast) {
	emit_jump(break_target);
}

fn gen_continue(node Ast) {
	emit_jump(continue_target);
}

fn gen_if(node Ast) {
	var done u32 = make_label();
	node = node.left;
	while node != nil {
		if node.kind == AST_ELSE {
			gen_block(node.left);
		} else {
			var skip u32 = make_label();
			var x u32 = gen_expr(node.left);
			emit_branch("eq", x, 0, skip);
			put_reg(x);
			gen_block(node.right);
			if node.next != nil {
				emit_jump(done);
			}
			emit_target(skip);
		}
		node = node.next;
	}
	emit_target(done);
}

fn gen_return(node Ast) {
	if node.left {
		var x u32 = gen_expr(node.left);
		if node.type != ctx.type_void {
			emit("    mv rv, x@\n").u(x);
		}
		put_reg(x);
	}
	emit_jump(return_target);
}

fn gen_block(node Ast) {
	node = node.left;
	while node != nil {
		var kind AstKind = node.kind;
		if kind == AST_WHILE {
			gen_while(node);
		} else if kind == AST_BREAK {
			gen_break(node);
		} else if kind == AST_CONTINUE {
			gen_continue(node);
		} else if kind == AST_RETURN {
			gen_return(node);
		} else if kind == AST_IF {
			gen_if(node);
		} else if kind == AST_BLOCK {
			gen_block(node);
		} else if ast_is_expr(kind) {
			put_reg(gen_expr(node));
		} else {
			ErrorAt(node, "unsupported @ in block").s(ast_kind[kind]);
		}
		node = node.next;
	}
}

fn setup_locals(node Ast, n u32) {
	if node.kind == AST_BLOCK {
		var sym Symbol = node.sym;
		while sym != nil {
			emit("// local @ @\n").u(n).s(sym.name.text);
			sym.ival = n;
			n += 4;
			sym = sym.next;
		}
	}
	var node2 Ast = node.left;
	while node2 != nil {
		setup_locals(node2, n);
		node2 = node2.next;
	}
	node2 = node.right;
	while node2 != nil {
		setup_locals(node2, n);
		node2 = node2.next;
	}
	if n > local_max {
		local_max = n;
	}
}

fn emit_data_chunk(fd i32, dc DataChunk) {
	emit("G$@:\n").u(dc.id);
	var n u32 = 0;
	while n < dc.count {
		var v u32 = dc.data[n];
		if (dc.kind == DATA_PTR) && v {
			emit("    .word G$@\n").u(v);
		} else {
			emit("    .word @\n").x(v);
		}
		n++;
	}
}

//  p3         p3     1
//  p2         p2     1
//  p1 <- sp   p1 <-  0(fp)
//             ra    -4
//             fp'   -8
//             l1   -12
//             l2   -16
//             ..
//             t8 <-  0(sp)

fn gen_fn(node Ast) {
	if node.left == nil {
		return;
	}
	return_type = node.sym.type.of;
	return_target = make_label();
	ctx.curfn = node.sym.name.text;
	ctx.curfnloc = node.srcloc;
	emit("\n@:\n").s(node.sym.name.text);
	// first two slots go to ra, fp
	local_max = 0;
	setup_locals(node.left, 12);
	// prologue
	emit("    stw ra, -4(sp)\n");
	emit("    stw fp, -8(sp)\n");
	emit("    mv fp, sp\n");
	emit("    subi sp, sp, @\n").u(local_max + MaxTmpRegs * 4);
	gen_block(node.left);
	//TODO: check for no return on non-void functions
	emit("    li rv, 0\n");
	emit_target(return_target);
	// epilogue
	emit("    ldw ra, -4(fp)\n");
	emit("    ldw fp, -8(fp)\n");
	emit("    addi sp, sp, @\n").u(local_max + MaxTmpRegs * 4);
	emit("    ret\n");
	emit_data_chunks(-1);
}

fn gen_functions(node Ast) {
	while node != nil {
		if node.kind == AST_FUNC {
			gen_fn(node);
		}
		node = node.next;
	}
}

fn gen_global_inits(node Ast) {
	emit("__global_segment:\n");
	while node != nil {
		if node.kind == AST_ASSIGN {
			var sym Symbol = node.left.sym;
			if node.right.kind == AST_STRING {
				var id u32 = make_string_chunk(node.right.sval.text);
				emit("    .word G$@ // @\n").u(id).s(sym.name.text);
			} else if node.right.kind == AST_ARRAY {
				var id u32 = gen_global_array_init(node.right);
				emit("    .word G$@ // @\n").u(id).s(sym.name.text);
			} else if node.right.kind == AST_ASSIGN {
				ErrorAt(node, "global struct init unsupported");
			} else {
				var val u32 = eval_const_expr(node.right);
				emit("    .word @ // @\n").u(val).s(sym.name.text);
			}
		}
		node = node.next;
	}
	emit_data_chunks(-1);
}

fn gen(outfd i32, xirfd i32, node Ast) {
	os = OutFd(outfd);
	if os == nil {
		Error("no output file specified");
	}
	emit("// gen-sr32-abi0\n\n");
	gen_global_addrs(node);
	gen_functions(node);
	gen_global_inits(node);
}
