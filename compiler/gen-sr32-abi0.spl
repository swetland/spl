// This is a bootstrapping code-generator for softrisc32 "abi0",
// which uses most registers (8..31) as caller-save temporaries
// and does all parameter passing via the stack

// There is absolutely no optimization of any kind here, the
// goal being correct sr32 code sufficient to compile the full
// compiler so it can then compile itself (with the real backend).

// Language features not present in the bootstrap transpiler are
// avoided.

enum CodeGenConfig {
	MaxTmpRegs = 8,
	FirstTmpReg = 8,
};

fn GenError(node Ast, msg str) ErrorStream {
	var s ErrorStream = new(ErrorStream);
	s.msg = msg;
	s.idx = 0;
	writes(2, "\n");
	print_srcloc(2, node.srcloc);
	writes(2, ": error: ");
	es_advance(s);
	return s;
}

var os OutStream;

fn emit(msg str) OutStream {
	os.msg = msg;
	os.idx = 0;
	os_advance(os);
	return os;
}

var local_max i32 = 0;
var tmp_mask i32 = 0;

fn find_bit(set i32) i32 {
	var n i32 = 0;
	while n < 32 {
		if (set & (1 << n)) == 0 {
			break;
		}
		n++;
	}
	return n;
}

fn get_reg() i32 {
	var n i32 = find_bit(tmp_mask);
	if n > MaxTmpRegs {
		Error("out of temporary registers");
	}
	tmp_mask |= (1 << n);
	return n + FirstTmpReg;
}

fn put_reg(n i32) {
	if n != 0 {
		n = 1 << (n - FirstTmpReg);
		if (tmp_mask & n) == 0 {
			Error("freeing unallocated temporary register @").n(n);
		}
		tmp_mask &= (~n);
	}
}

var nextlabel i32 = 0;

fn make_label() i32 {
	var n i32 = nextlabel;
	nextlabel++;
	return n;
}
fn emit_target(id i32) {
	emit("_L@:\n").n(id);
}
fn emit_branch(x str, a i32, b i32, tgt i32) {
	emit("    b@ x@, x@, _L@\n").s(x).n(a).n(b).n(tgt);
}
fn emit_jump(tgt i32) {
	emit("    j _L@\n").n(tgt);
}
fn emit_binop(op str, t i32, a i32, b i32) {
	emit("    @ x@, x@, x@\n").s(op).n(t).n(a).n(b);
}
fn emit_li(t i32, v i32) {
	emit("    li x@, @\n").n(t).n(v);
}

fn gen_expr(node Ast) i32;
fn gen_block(node Ast);

fn gen_relop(node Ast, op str) i32 {
	var ttrue i32 = make_label();
	var tdone i32 = make_label();
	var a i32 = gen_expr(node.left);
	var b i32 = gen_expr(node.right);
	emit_branch(op, a, b, ttrue);
	emit_li(a, 0);
	emit_jump(tdone);
	emit_target(ttrue);
	emit_li(a, 1);
	emit_target(tdone);
	put_reg(b);
	return a;
}

fn gen_binop(node Ast, op str) i32 {
	var a i32 = gen_expr(node.left);
	var b i32 = gen_expr(node.right);
	emit_binop(op, a, a, b);
	put_reg(b);
	return a;
}

fn gen_unop(node Ast, op str) i32 {
	var x i32 = gen_expr(node.left);
	emit("    @ x@, x@\n").s(op).n(x).n(x);
	return x;
}

fn emit_load_tmp() {
	var n i32 = 0;
	while n < MaxTmpRegs {
		if tmp_mask & (1 << n) {
			emit("    ldw x@, -@(fp) //RT\n").n(FirstTmpReg + n).n(local_max + 4*n);
		}
		n++;
	}
}
fn emit_save_tmp() {
	var n i32 = 0;
	while n < MaxTmpRegs {
		if tmp_mask & (1 << n) {
			emit("    stw x@, -@(fp) //ST\n").n(FirstTmpReg + n).n(local_max + 4*n);
		}
		n++;
	}
}

enum DataChunkKind {
	DATA_U8,
	DATA_U32,
	DATA_PTR,
};

struct DataChunk {
	next *DataChunk,
	data *[]u32,
	kind u32,
	count u32,
	id u32,
};

var data_id u32 = 0;
var data_list DataChunk;

fn make_data_chunk(kind u32, n u32) DataChunk {
	var dc DataChunk = new(DataChunk);
	if kind == DATA_U8 {
		// bytecount to wordcount, rounding up
		n = (n + 3) >> 2;
	}
	dc.next = data_list;
	dc.data = __new(n * 4);
	dc.kind = kind;
	dc.count = n;
	dc.id = data_id;
	data_list = dc;
	data_id++;
	return dc;
}

fn write_data_chunk(dc DataChunk, idx u32, val u32) {
	if dc.kind == DATA_U8 {
		val = (val & 0xFF) << ((idx & 3) * 8);
		dc.data[idx >> 2] |= val;
	} else {
		dc.data[idx] = val;
	}
}

fn emit_data_chunk(dc DataChunk) {
	emit("_D@:\n").n(dc.id);
	var n u32 = 0;
	while n < dc.count {
		var v i32 = dc.data[n];
		if (dc.kind == DATA_PTR) && v {
			emit("    .word _D@\n").n(v);
		} else {
			emit("    .word @\n").x(v);
		}
		n++;
	}
}

fn emit_data_chunks() {
	var dc DataChunk = data_list;
	while dc != nil {
		emit_data_chunk(dc);
		dc = dc.next;
	}
	data_list = nil;
}

fn make_string_chunk(s str) u32 {
	var len i32 = strlen(s);
	// include terminator \0
	var dc DataChunk = make_data_chunk(DATA_U8, len + 1);
	var n i32 = 0;
	while n < len {
		write_data_chunk(dc, n, s[n]);
		n++;
	}
	return dc.id;
}

fn gen_string_const(s str) i32 {
	var id u32 = make_string_chunk(s);
	var r i32 = get_reg();
	emit("    la x@, _D@\n").n(r).n(id);
	return r;
}

fn gen_call(fcall Ast) i32 {
	var sym Symbol = fcall.left.sym;
	if sym == nil {
		GenError(fcall, "calling undefined function '@'").s(fcall.left.name.text);
	}
	emit("    subi sp, sp, @\n").n(sym.type.count * 4);
	var node Ast = fcall.right;
	var n i32 = 0;
	while node != nil {
		var x i32 = gen_expr(node);
		emit("    stw x@, @(sp)\n").n(x).n(n * 4);
		put_reg(x);
		n++;
		node = node.next;
	}
	if n != sym.type.count {
		GenError(fcall, "parameter count mismatch for '@': expected @, found @").s(fcall.left.name.text).n(sym.type.count).n(n);
	}
	emit_save_tmp();
	// TODO: possibly better way to get the (mangled) canonical
	// function name from a method than indirecting through the type?
	emit("    call @\n").s(sym.type.name.text);
	emit("    addi sp, sp, @\n").n(sym.type.count * 4);
	emit_load_tmp();

	if sym.type.of == ctx.type_void {
		return 0;
	} else {
		var t i32 = get_reg();
		emit("    mv x@, rv\n").n(t);
		return t;
	}
}

fn gen_addr(node Ast) i32;

fn gen_field_addr(node Ast) i32 {
	var left Ast = node.left;
	var right Ast = node.right;
	var type Type = left.type;
	var ptr bool = false;
	if type.kind == TYPE_POINTER {
		ptr = true;
		type = type.of;
	}
	if type.kind != TYPE_STRUCT {
		GenError(node, "invalid FIELD reference");
	}
	var ar i32 = gen_addr(left);
	if ptr {
		emit("    ldw x@, (x@)\n").n(ar).n(ar);
	}
	emit("    addi x@, x@, @\n").n(ar).n(ar).n(right.sym.ival);
	return ar;
}

fn gen_field_load(node Ast) i32 {
	var ar i32 = gen_field_addr(node);
	emit("    ldw x@, (x@)\n").n(ar).n(ar);
	return ar;
}

// load:  vr < 0  (returns an allocated vr)
// store: vr >= 0 (returns vr, vr not consumed)
fn gen_array_access(node Ast, vr i32) i32 {
	var type Type = node.left.type;
	var ptr bool = false;
	if type.kind == TYPE_POINTER {
		type = type.of;
		ptr = true;
	}
	if type.kind != TYPE_ARRAY {
		GenError(node, "index of non-array type");
	}
	var sz i32 = type_size(type.of);
	// HACK: workaround for array-of-strings access
	// TODO: sort this out in a more regular way
	if type.of.kind == TYPE_ARRAY {
		sz = 4;
	}
	var ar i32 = gen_addr(node.left);
	if ptr {
		emit("    ldw x@, (x@) // array ptr deref\n").n(ar).n(ar);
	}
	var ir i32 = gen_expr(node.right);
	if sz == 2 { emit("    slli x@, x@, 1\n").n(ir).n(ir); }
	if sz == 4 { emit("    slli x@, x@, 2\n").n(ir).n(ir); }
	emit("    add x@, x@, x@\n").n(ar).n(ar).n(ir);
	put_reg(ir);
	if vr < 0 {
		if sz == 1 { emit("    ldbu x@, (x@)\n").n(ar).n(ar); }
		if sz == 2 { emit("    ldhu x@, (x@)\n").n(ar).n(ar); }
		if sz == 4 { emit("    ldw x@, (x@)\n").n(ar).n(ar); }
		return ar;
	} else {
		if sz == 1 { emit("    stb x@, (x@)\n").n(vr).n(ar); }
		if sz == 2 { emit("    sth x@, (x@)\n").n(vr).n(ar); }
		if sz == 4 { emit("    stw x@, (x@)\n").n(vr).n(ar); }
		put_reg(ar);
		return vr;
	}
}

fn gen_addr(node Ast) i32 {
	var kind i32 = node.kind;

	if kind == AST_SYMBOL {
		var t i32 = get_reg();
		var sym Symbol = node.sym;
		if sym.kind & SYMBOL_PARAM {
			emit("    addi x@, fp, @\n").n(t).n(sym.ival);
		} else if sym.kind & SYMBOL_LOCAL {
			emit("    addi x@, fp, -@\n").n(t).n(sym.ival);
		} else if sym.kind & SYMBOL_GLOBAL {
			emit("    addi x@, gp, @\n").n(t).n(sym.ival);
		} else {
			GenError(node, "unsupported store for '@' @").s(sym.name.text).x(sym.kind);
		}
		return t;
	}
	if kind == AST_FIELD {
		return gen_field_addr(node);
	}
	if kind == AST_CALL {
		if node.type.kind == TYPE_POINTER {
			return gen_call(node);
		}
	}
	GenError(node, "sorry... @ in addr expr").s(ast_kind[kind]);
	return 0;
}

fn gen_load(node Ast) i32 {
	var t i32 = get_reg();
	var sym Symbol = node.sym;
	if sym.kind & SYMBOL_DEF {
		emit_li(t, sym.ival);
	} else if sym.kind & SYMBOL_PARAM {
		emit("    ldw x@, @(fp)\n").n(t).n(sym.ival);
	} else if sym.kind & SYMBOL_LOCAL {
		emit("    ldw x@, -@(fp)\n").n(t).n(sym.ival);
	} else if sym.kind & SYMBOL_GLOBAL{
		emit("    ldw x@, @(gp)\n").n(t).n(sym.ival);
	} else {
		GenError(node, "unsupported symbol for load '@' @").s(sym.name.text).x(sym.kind);
	}
	return t;
}

fn gen_assign(node Ast) i32 {
	if (node.left.kind == AST_INDEX) {
		return gen_array_access(node.left, gen_expr(node.right));
	}
	var ar i32 = gen_addr(node.left);
	var vr i32 = gen_expr(node.right);
	emit("    stw x@, (x@)\n").n(vr).n(ar);
	put_reg(ar);
	return vr;
}

fn gen_bool_and(node Ast) i32 {
	var t i32 = get_reg();
	emit_li(t, 0);
	var res0 i32 = make_label();
	var x i32 = gen_expr(node.left);
	emit_branch("eq", x, 0, res0);
	put_reg(x);
	x = gen_expr(node.right);
	emit_branch("eq", x, 0, res0);
	put_reg(x);
	emit_li(t, 1);
	emit_target(res0);
	return t;
}

fn gen_bool_or(node Ast) i32 {
	var t i32 = get_reg();
	emit_li(t, 1);
	var res1 i32 = make_label();
	var x i32 = gen_expr(node.left);
	emit_branch("ne", x, 0, res1);
	put_reg(x);
	x = gen_expr(node.right);
	emit_branch("ne", x, 0, res1);
	put_reg(x);
	emit_li(t, 0);
	emit_target(res1);
	return t;
}

fn gen_expr(node Ast) i32 {
	var kind i32 = node.kind;

	if kind == AST_CONST {
		var t i32 = get_reg();
		emit_li(t, node.ival);
		return t;
	}
	if kind == AST_SYMBOL {
		return gen_load(node);
	}
	if kind == AST_EQ  { return gen_relop(node, "eq"); }
	if kind == AST_NE  { return gen_relop(node, "ne"); }
	if kind == AST_LT  { return gen_relop(node, "lt"); }
	if kind == AST_LE  { return gen_relop(node, "le"); }
	if kind == AST_GT  { return gen_relop(node, "gt"); }
	if kind == AST_GE  { return gen_relop(node, "ge"); }
	if kind == AST_ADD { return gen_binop(node, "add"); }
	if kind == AST_SUB { return gen_binop(node, "sub"); }
	if kind == AST_OR  { return gen_binop(node, "or"); }
	if kind == AST_XOR { return gen_binop(node, "xor"); }
	if kind == AST_MUL { return gen_binop(node, "mul"); }
	if kind == AST_DIV { return gen_binop(node, "div"); }
	if kind == AST_MOD { return gen_binop(node, "rem"); }
	if kind == AST_AND { return gen_binop(node, "and"); }
	if kind == AST_LSL { return gen_binop(node, "sll"); }
	if kind == AST_LSR { return gen_binop(node, "srl"); }
	if kind == AST_NOT { return gen_unop(node, "not"); }
	if kind == AST_NEG { return gen_unop(node, "neg"); }
	if kind == AST_BOOL_NOT { return gen_unop(node, "not"); }
	if kind == AST_BOOL_AND { return gen_bool_and(node); }
	if kind == AST_BOOL_OR { return gen_bool_or(node); }
	if kind == AST_STRING { return gen_string_const(node.name.text); }
	if kind == AST_DEREF { }
	if kind == AST_INDEX { return gen_array_access(node, -1); }
	if kind == AST_FIELD { return gen_field_load(node); }
	if kind == AST_CALL { return gen_call(node); }
	if kind == AST_ASSIGN { return gen_assign(node); }
	if kind == AST_NEW { }
	GenError(node, "unsupported @ in expr").s(ast_kind[kind]);
	return 0;
}

var return_target i32 = -1;
var continue_target i32 = -1;
var break_target i32 = -1;
var return_type Type = nil;

fn gen_while(node Ast) {
	var save_ct i32 = continue_target;
	var save_bt i32 = break_target;

	var loop i32 = make_label();
	var exit i32 = make_label();
	continue_target = loop;
	break_target = exit;

	emit_target(loop);
	var a i32 = gen_expr(node.left);
	emit_branch("eq", a, 0, exit);
	put_reg(a);
	gen_block(node.right);
	emit_jump(loop);
	emit_target(exit);

	continue_target = save_ct;
	break_target = save_bt;
}

fn gen_break(node Ast) {
	if break_target < 0 {
		GenError(node, "break used outside of loop");
	}
	emit_jump(break_target);
}

fn gen_continue(node Ast) {
	if continue_target < 0 {
		GenError(node, "continue used outside of loop");
	}
	emit_jump(continue_target);
}

fn gen_if(node Ast) {
	var done i32 = make_label();
	node = node.left;
	while node != nil {
		if node.kind == AST_ELSE {
			gen_block(node.left);
		} else {
			var skip i32 = make_label();
			var x i32 = gen_expr(node.left);
			emit_branch("eq", x, 0, skip);
			put_reg(x);
			gen_block(node.right);
			if node.next != nil {
				emit_jump(done);
			}
			emit_target(skip);
		}
		node = node.next;
	}
	emit_target(done);
}

fn gen_return(node Ast) {
	if node.left == nil {
		if return_type != ctx.type_void {
			GenError(node, "return value required");
		}
	} else {
		if return_type == ctx.type_void {
			GenError(node, "void function must not return a value");
		}
		var x i32 = gen_expr(node.left);
		emit("    mv rv, x@\n").n(x);
		put_reg(x);
	}
	emit_jump(return_target);
}

fn gen_block(node Ast) {
	node = node.left;
	while node != nil {
		var kind i32 = node.kind;
		if kind == AST_WHILE {
			gen_while(node);
		} else if kind == AST_BREAK {
			gen_break(node);
		} else if kind == AST_CONTINUE {
			gen_continue(node);
		} else if kind == AST_RETURN {
			gen_return(node);
		} else if kind == AST_IF {
			gen_if(node);
		} else if ast_is_expr(kind) {
			put_reg(gen_expr(node));
		} else {
			GenError(node, "unsupported @ in block").s(ast_kind[kind]);
		}
		node = node.next;
	}
}

fn setup_locals(node Ast, n i32) {
	if node.kind == AST_BLOCK {
		var sym Symbol = node.sym;
		while sym != nil {
			emit("// local @ @\n").n(n).s(sym.name.text);
			sym.ival = n;
			n += 4;
			sym = sym.next;
		}
	}
	var node2 Ast = node.left;
	while node2 != nil {
		setup_locals(node2, n);
		node2 = node2.next;
	}
	node2 = node.right;
	while node2 != nil {
		setup_locals(node2, n);
		node2 = node2.next;
	}
	if n > local_max {
		local_max = n;
	}
}


//  p3         p3     1
//  p2         p2     1
//  p1 <- sp   p1 <-  0(fp)
//             ra    -4
//             fp'   -8
//             l1   -12
//             l2   -16
//             ..
//             t8 <-  0(sp)

fn gen_fn(node Ast) {
	if node.left == nil {
		return;
	}
	return_type = node.sym.type.of;
	return_target = make_label();
	emit("\n@:\n").s(node.sym.name.text);
	// first two slots go to ra, fp
	local_max = 0;
	setup_locals(node.left, 12);
	// prologue
	emit("    stw ra, -4(sp)\n");
	emit("    stw fp, -8(sp)\n");
	emit("    mv fp, sp\n");
	emit("    subi sp, sp, @\n").n(local_max + MaxTmpRegs * 4);
	gen_block(node.left);
	//TODO: check for no return on non-void functions
	emit("    li rv, 0\n");
	emit_target(return_target);
	// epilogue
	emit("    ldw ra, -4(fp)\n");
	emit("    ldw fp, -8(fp)\n");
	emit("    addi sp, sp, @\n").n(local_max + MaxTmpRegs * 4);
	emit("    ret\n");
	emit_data_chunks();
}

fn gen_functions(node Ast) {
	while node != nil {
		if node.kind == AST_FUNC {
			gen_fn(node);
		}
		node = node.next;
	}
}

fn gen_global_addrs(node Ast) {
	var n i32 = 0;
	while node != nil {
		if node.kind == AST_ASSIGN {
			var sym Symbol = node.left.sym;
			sym.ival = n;
			n += 4;
		}
		node = node.next;
	}
}

fn gen_global_array_init(node Ast) u32 {
	var kind i32 = DATA_U32;
	if node.kind == AST_STRING {
		return make_string_chunk(node.name.text);
	} else if node.kind == AST_ARRAY {
		if type_size(node.type) == 1 {
			kind = DATA_U8;
		} else if !type_is_scalar(node.type) {
			kind = DATA_PTR;
		}
	} else {
		GenError(node, "illegal array init");
	}
	var dc DataChunk = make_data_chunk(kind, node.ival);
	node = node.left;
	var n i32 = 0;
	while node != nil {
		var v u32;
		if kind == DATA_PTR {
			v = gen_global_array_init(node);
		} else {
			v = eval_const_expr(node);
		}
		write_data_chunk(dc, n, v);
		node = node.next;
		n++;
	}
	return dc.id;
}

fn gen_global_inits(node Ast) {
	emit("__global_segment:\n");
	while node != nil {
		if node.kind == AST_ASSIGN {
			var sym Symbol = node.left.sym;
			if node.right.kind == AST_STRING {
				var id u32 = make_string_chunk(node.right.name.text);
				emit("    .word _D@ // @\n").n(id).s(sym.name.text);
			} else if node.right.kind == AST_ARRAY {
				var id u32 = gen_global_array_init(node.right);
				emit("    .word _D@ // @\n").n(id).s(sym.name.text);
			} else if node.right.kind == AST_ASSIGN {
				GenError(node, "global struct init unsupported");
			} else {
				var val i32 = eval_const_expr(node.right);
				emit("    .word @ // @\n").n(val).s(sym.name.text);
			}
		}
		node = node.next;
	}
	emit_data_chunks();
}

fn gen(outfd i32, node Ast) {
	os = OutFd(outfd);
	emit("// gen-sr32-abi0\n\n");
	gen_global_addrs(node);
	gen_functions(node);
	gen_global_inits(node);
}
