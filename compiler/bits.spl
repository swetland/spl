// https://graphics.stanford.edu/~seander/bithacks.html#CountBitsSetParallel
fn countbits(n u32) u32 {
	n = n - ((n >> 1) & 0x55555555);
	n = (n & 0x33333333) + ((n >> 2) & 0x33333333);
	return (((n + (n >> 4)) & 0xF0F0F0F) * 0x1010101) >> 24;
}

// https://graphics.stanford.edu/~seander/bithacks.html#ZerosOnRightMultLookup
var MultiplyDeBruijnBitPosition [32]u32 = {
	0, 1, 28, 2, 29, 14, 24, 3, 30, 22, 20, 15, 25, 17, 4, 8,
	31, 27, 13, 23, 21, 19, 16, 7, 26, 12, 18, 6, 11, 5, 10, 9,
};

fn ctz(n u32) u32 {
	return MultiplyDeBruijnBitPosition[((n & -n) * 0x077CB531) >> 27];
}

struct BitSet {
	size u32,
	iter u32,
	data [1]u32,
};

fn BitSet_make(size_in_bits u32) BitSet {
	var size u32 = (size_in_bits + 31) >> 5;
	var bs BitSet = new(BitSet, size * 4);
	bs.size = size;
	return bs;
}

fn (bs BitSet) set(n u32) {
	bs.data[n >> 5] |= (1u << (n & 31));
}

fn (bs BitSet) clear(n u32) {
	bs.data[n >> 5] &^= (1u << (n & 31));
}

fn (bs BitSet) isset(n u32) u32 {
	return bs.data[n >> 5] & (1u << (n & 31));
}

fn (bs BitSet) set2(n u32) u32 {
	var bit u32 = 1 << (n & 31);
	n >>= 5;
	var r u32 = bs.data[n] & bit;
	bs.data[n] |= bit;
	return !r;
}

fn (bs BitSet) count() u32 {
	var c u32 = 0;
	var n u32 = 0;
	while n < bs.size {
		c += countbits(bs.data[n]);
		n++;
	}
	return c;
}

fn (bs BitSet) union(src BitSet) {
	var n u32 = 0;
	while n < bs.size {
		bs.data[n] |= src.data[n];
		n++;
	}
}

fn (bs BitSet) intersection(src BitSet) {
	var n u32 = 0;
	while n < bs.size {
		bs.data[n] &= src.data[n];
		n++;
	}
}

fn (bs BitSet) rewind() {
	bs.iter = 0;
}

fn (bs BitSet) next() i32 {
	var w u32 = bs.iter >> 5;
	var n u32 = bs.iter & 31;
	while w < bs.size {
		var x u32 = bs.data[w] >> n;
		if x {
			n = bs.iter + ctz(x);
			bs.iter = n + 1;
			return n;
		}
		w++;
		n = 0;
		bs.iter = w << 5;
	}
	return -1;
}

