fn print_srcloc(fd i32, loc u32);

enum OutStreamFlags {
	// exit when done formatting:
	OS_FATAL = 1,
	// emit a newline when done formatting:
	OS_NEWLINE = 2,
	// emit a newline when done formatting (once):
	OS_NEWLINE_ONCE = 4,
	// crash when done formatting (useful to get a stack trace)
	OS_PANIC = 8,
};

struct OutStream {
	msg str,
	idx u32,
	fd i32,
	flags u32,
};

fn os_advance(os OutStream) {
	var n u32 = os.idx;
	while (os.msg[n] != 0) && (os.msg[n] != '@') {
		n++;
	}
	if n - os.idx != 0 {
		write(os.fd, os.msg, os.idx, n - os.idx);
	}
	if os.msg[n] == '@' {
		os.idx = n + 1;
		return;
	}
	os.idx = n;
	if os.msg[n] == 0 {
		if os.flags & (OS_NEWLINE | OS_NEWLINE_ONCE) {
			writec(os.fd, '\n');
			os.flags &^= OS_NEWLINE_ONCE;
		}
		if os.flags & OS_PANIC {
			sys_panic();
		}
		if os.flags & OS_FATAL {
			os_exit(1);
		}
	}
}

fn (os OutStream) s(x str) OutStream {
	writes(os.fd, x);
	os_advance(os);
	return os;
}

fn (os OutStream) n(n i32) OutStream {
	writei(os.fd, n);
	os_advance(os);
	return os;
}

fn (os OutStream) u(n u32) OutStream {
	writeu(os.fd, n);
	os_advance(os);
	return os;
}

fn (os OutStream) x(n u32) OutStream {
	writex(os.fd, n);
	os_advance(os);
	return os;
}

fn OutFd(fd i32) OutStream {
	if fd < 0 {
		return nil;
	}
	var os OutStream = new(OutStream);
	os.msg = "";
	os.idx = 0;
	os.flags = 0;
	os.fd = fd;
	return os;
}

fn (os OutStream) fmt(msg str) OutStream {
	os.msg = msg;
	os.idx = 0;
	os_advance(os);
	return os;
}

fn Fmt(os OutStream, msg str) OutStream {
	os.msg = msg;
	os.idx = 0;
	os_advance(os);
	return os;
}

fn FmtLn(os OutStream, msg str) OutStream {
	os.flags |= OS_NEWLINE_ONCE;
	return Fmt(os, msg);
}

fn (os OutStream) close() {
	if os.fd >= 0 {
		fd_close(os.fd);
		os.fd = -1;
	}
}
