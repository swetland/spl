fn print_srcloc(fd i32, loc u32);

enum OutStreamFlags {
	// exit when done formatting:
	OS_FATAL = 1,
	// emit a newline when done formatting:
	OS_NEWLINE = 2,
	// emit a newline ahead of the error tag:
	OS_INTERRUPT = 4,
	// emit a newline when done formatting (once):
	OS_NEWLINE_ONCE = 8,
};

struct OutStream {
	msg str,
	idx u32,
	fd i32,
	flags u32,
};

fn os_advance(os OutStream) {
	var n u32 = os.idx;
	while (os.msg[n] != 0) && (os.msg[n] != '@') {
		n++;
	}
	if n - os.idx != 0 {
		write(os.fd, os.msg, os.idx, n - os.idx);
	}
	if os.msg[n] == '@' {
		os.idx = n + 1;
		return;
	}
	os.idx = n;
	if os.msg[n] == 0 {
		if os.flags & (OS_NEWLINE | OS_NEWLINE_ONCE) {
			writec(os.fd, '\n');
			os.flags &= (~OS_NEWLINE_ONCE);
		}
		if os.flags & OS_FATAL {
			os_exit(1);
		}
	}
}

fn (os OutStream) s(x str) OutStream {
	writes(os.fd, x);
	os_advance(os);
	return os;
}

fn (os OutStream) n(n i32) OutStream {
	writei(os.fd, n);
	os_advance(os);
	return os;
}

fn (os OutStream) x(n u32) OutStream {
	writex(os.fd, n);
	os_advance(os);
	return os;
}

fn print_type(fd i32, type Type);

fn (os OutStream) t(type Type) OutStream {
	print_type(os.fd, type);
	os_advance(os);
	return os;
}

fn make_OutStream(msg str, fd i32, flags u32, tag str) OutStream {
	var os OutStream = new(OutStream);
	os.msg = msg;
	os.idx = 0;
	os.flags = flags;
	os.fd = fd;
	if tag != nil {
		if flags & OS_INTERRUPT {
			writes(fd, "\n");
		}
		print_srcloc(fd, ctx.linenumber);
		writes(fd, tag);
	}
	os_advance(os);
	return os;
}

fn Error(msg str) OutStream {
	return make_OutStream(msg, 2, OS_FATAL | OS_NEWLINE | OS_INTERRUPT, ": error: ");
}

fn Warn(msg str) OutStream {
	return make_OutStream(msg, 2, OS_NEWLINE, ": warning: ");
}

fn OutFd(fd i32) OutStream {
	if fd >= 0 {
		return make_OutStream("", fd, 0, nil);
	} else {
		return nil;
	}
}

fn (os OutStream) fmt(msg str) OutStream {
	os.msg = msg;
	os.idx = 0;
	os_advance(os);
	return os;
}

fn Fmt(os OutStream, msg str) OutStream {
	os.msg = msg;
	os.idx = 0;
	os_advance(os);
	return os;
}

fn FmtLn(os OutStream, msg str) OutStream {
	os.flags |= OS_NEWLINE_ONCE;
	return Fmt(os, msg);
}

