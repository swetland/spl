fn print_srcloc(fd i32, loc i32);

struct ErrorStream {
	msg str,
	idx u32,
};

fn es_prologue() {
	writes(2, "\n");
	print_srcloc(2, ctx.linenumber);
	writes(2, ": error: ");
}

fn es_advance(s ErrorStream) {
	var n u32 = s.idx;
	while (s.msg[n] != 0) && (s.msg[n] != '@') {
		n++;
	}
	if n - s.idx != 0 {
		write(2, s.msg, s.idx, n - s.idx);
		if s.msg[n] == '@' {
			s.idx = n + 1;
			return;
		}
		s.idx = n;
	}
	if s.msg[n] == 0 {
		writec(2, '\n');
		os_exit(1);
	}
}

fn (self ErrorStream) s(x str) ErrorStream {
	writes(2, x);
	es_advance(self);
	return self;
}

fn (self ErrorStream) n(n i32) ErrorStream {
	writei(2, n);
	es_advance(self);
	return self;
}

fn (self ErrorStream) x(n u32) ErrorStream {
	writex(2, n);
	es_advance(self);
	return self;
}

fn Error(msg str) ErrorStream {
	var s ErrorStream = new(ErrorStream);
	s.msg = msg;
	s.idx = 0;
	es_prologue();
	es_advance(s);
	return s;
}

struct OutStream {
	msg str,
	idx u32,
	fd i32,
};

fn os_advance(s OutStream) {
	var n u32 = s.idx;
	while (s.msg[n] != 0) && (s.msg[n] != '@') {
		n++;
	}
	if n - s.idx != 0 {
		write(s.fd, s.msg, s.idx, n - s.idx);
		if s.msg[n] == '@' {
			s.idx = n + 1;
			return;
		}
		s.idx = n;
	}
}

fn (self OutStream) s(x str) OutStream {
	writes(self.fd, x);
	os_advance(self);
	return self;
}

fn (self OutStream) n(n i32) OutStream {
	writei(self.fd, n);
	os_advance(self);
	return self;
}

fn (self OutStream) x(n u32) OutStream {
	writex(self.fd, n);
	os_advance(self);
	return self;
}

fn (self OutStream) fmt(msg str) OutStream {
	self.msg = msg;
	self.idx = 0;
	os_advance(self);
	return self;
}

fn OutFd(fd i32) OutStream {
	var s OutStream = new(OutStream);
	s.msg = "";
	s.idx = 0;
	s.fd = fd;
	return s;
}

