fn validate_expr(node Ast);
fn validate_block(node Ast);

var wsl u32;

fn make_u32(node Ast) bool {
	// positive i32s can become u32s safely:
	if node.kind != AST_CONST { return false; }
	if node.ival >= 0x80000000 { return false; }
	node.type = ctx.type_u32;
	return true;
}
fn make_i32(node Ast) bool {
	// u32s with the high bit clear can become i32s safely:
	if node.kind != AST_CONST { return false; }
	if node.ival >= 0x80000000 { return false; }
	node.type = ctx.type_i32;
	return true;
}
fn make_u8(node Ast) bool {
	// u32s with the high bit clear can become i32s safely:
	if node.kind != AST_CONST { return false; }
	if node.ival >= 0xFF { return false; }
	node.type = ctx.type_i32;
	return true;
}

//TODO: should bool convert to 0/1 value?
fn is_assignable(src Type, dst Type, snode Ast, fcall bool) bool {
	if types_match(src, dst, fcall) { return true; }
	var dk TypeKind = dst.kind;
	var sk TypeKind = src.kind;
	if dk == TYPE_U32 {
		if sk == TYPE_U8   { return true; }
		if sk == TYPE_I32  { if make_u32(snode) { return true; } }
		if sk == TYPE_ENUM { return true; }
		if sk == TYPE_BOOL { return true; }
	}
	if dk == TYPE_I32 {
		if sk == TYPE_U8   { return true; }
		if sk == TYPE_U32  { if make_i32(snode) { return true; } }
		if sk == TYPE_ENUM { return true; }
		if sk == TYPE_BOOL { return true; }
	}
	if dk == TYPE_U8 {
		if sk == TYPE_I32  { if make_u8(snode) { return true; } }
		if sk == TYPE_U32  { if make_u8(snode) { return true; } }
		if sk == TYPE_ENUM { return true; }
	}
	if dk == TYPE_ENUM {
		if sk == TYPE_I32 { return true; }
		if sk == TYPE_U32 { return true; }
		if sk == TYPE_U8  { return true; }
	}
	if dk == TYPE_BOOL {
		if sk == TYPE_I32 { return true; }
		if sk == TYPE_U32 { return true; }
		if sk == TYPE_U8  { return true; }
	}
	if dk == TYPE_POINTER {
		if src == ctx.type_nil { return true; }
	}
	if dst == ctx.type_str {
		// str and various []u8 types are compatible
		if (sk == TYPE_ARRAY) && (src.of == ctx.type_u8) { return true; }
	}
	if (sk == TYPE_POINTER) && (dk == TYPE_POINTER) {
		// arrays of differing (or 0) sizes are compatible (for now)
		src = src.of;
		dst = dst.of;
		if (src.kind != TYPE_ARRAY) || (dst.kind != TYPE_ARRAY) {
			return false;
		}
		if types_match(src.of, dst.of, fcall) {
			return true;
		}
	}
	return false;
}

fn fn_check_args(node Ast, type Type, arg Ast) {
	var n u32 = 0;
	var param Symbol = type.list;
	ctx.anonmap = nil;
	while arg != nil {
		if param == nil {
			ErrorAt(node, "too many arguments in fncall (@/@)")
				.u(n + 1).u(type.count);
		}
		validate_expr(arg);
		wsl = arg.srcloc;
		if !is_assignable(arg.type, param.type, arg, true) {
			ErrorAtLoc(arg.srcloc, "arg @: cannot assign @ to @")
				.u(n).t(arg.type).t(param.type);
		}
		arg = arg.next;
		param = param.next;
		n++;
	}
	if param != nil {
		ErrorAt(node, "too few arguments in fncall (@/@)")
			.u(n).u(type.count);
	}
}


fn validate_call(fcall Ast) {
	var type Type = fcall.left.type;
	if type.kind != TYPE_FN {
		ErrorAt(fcall, "calling a non-function");
	}
	fn_check_args(fcall, type, fcall.right);
}

fn validate_lhs(node Ast) {
	var kind AstKind = node.kind;
	if kind == AST_SYMBOL {
		if !(node.sym.kind & SYMBOL_VAR) {
			WarnAt(node, "invalid lhs symbol '@'").s(node.sym.name.text);
		}
		return;
	}
	if kind == AST_FIELD {
		validate_lhs(node.left);
		return;
	}
	if kind == AST_INDEX {
		validate_lhs(node.left);
		validate_expr(node.right);
		return;
	}
	ErrorAt(node, "unknown lhs @").s(ast_kind[kind]);
}

fn validate_assign(node Ast) {
	var left Ast = node.left;
	var right Ast = node.right;
	validate_lhs(left);
	validate_expr(right);

	wsl = node.srcloc;
	if !is_assignable(right.type, left.type, right, false) {
		if (right.type.kind == TYPE_ARRAY)
			&& (left.type.kind == TYPE_POINTER)
			&& is_assignable(right.type, left.type.of, right, false) {
			// can assign arrays to array pointers, they convert
		} else {
			ErrorAt(node, "cannot assign @ to @").t(right.type).t(left.type);
		}
	}
}

fn validate_field_load(node Ast) {
}

fn validate_array_load(node Ast) {
}

fn validate_load(node Ast) {
}

fn validate_new(node Ast) {
	// node type must be a pointer
	var type Type = node.type;
	if type.kind != TYPE_POINTER {
		ErrorAt(node, "new must return a pointer type, not @").t(type);
	}
	// which we then dereference
	type = type.of;

	var szarg Ast;
	if type.kind == TYPE_ARRAY {
		szarg = ast_make_lr(AST_MUL, node.left, ast_make_const(
				type_size(type.of), ctx.type_u32));
	} else if type.kind == TYPE_STRUCT {
		szarg = ast_make_const(type_size(type), ctx.type_u32);
		if node.left != nil {
			szarg = ast_make_lr(AST_ADD, szarg, node.left);
		}
	} else {
		ErrorAt(node, "cannot allocate '@' with new").t(type);
	}
	// and convert to __new(size) fncall
	node.kind = AST_CALL;
	node.left = ast_make_symbol(symbol_find(ctx.str_new_fn));
	node.right = szarg;
	// patch a reasonable source location into the new nodes
	szarg.srcloc = node.srcloc;
	node.left.srcloc = node.srcloc;
	// validate the transformed node as a fn call
	return validate_call(node);
}

fn flip_signedness(node Ast) bool {
	if (node.type == ctx.type_u32) && (node.ival < 0x80000001u) {
		node.type = ctx.type_i32;
		return true;
	}
	if (node.type == ctx.type_i32) && (node.ival < 0x80000000u) {
		node.type = ctx.type_u32;
		return true;
	}
	return false;
}

fn validate_intop(node Ast) {
	var ltype Type = node.left.type;
	var rtype Type = node.right.type;
	if !(ltype.kind & TYPE_IS_INTEGER) {
		WarnAt(node, "@ on non-integer").s(ast_kind[node.kind]);
	}
	if !(rtype.kind & TYPE_IS_INTEGER) {
		WarnAt(node, "@ on non-integer").s(ast_kind[node.kind]);
	}
	if (ltype.kind & TYPE_IS_SIGNED) == (rtype.kind & TYPE_IS_SIGNED) {
		return;
	}
	if (node.left.kind == AST_CONST) && flip_signedness(node.left) {
		node.type = node.left.type;
		return;
	}
	if (node.right.kind == AST_CONST) && flip_signedness(node.right) {
		node.type = node.right.type;
		return;
	}
	WarnAt(node, "@ on differing signedness").s(ast_kind[node.kind]);
	//TODO: differing size ints
}

fn validate_relop(node Ast) {
	validate_expr(node.left);
	validate_expr(node.right);
	if (node.left.type.kind & TYPE_POINTER) && (node.right.type.kind & TYPE_POINTER) {
		if (node.kind == AST_EQ) || (node.kind == AST_NE) {
			// equality tests between pointers are valid
			return;
		}
	}
	if (node.kind == AST_EQ) || (node.kind == AST_NE) {
		//TODO: revisit when pointer types are fully sorted
		return;
	}
	validate_intop(node);
}

fn validate_binop(node Ast) {
	validate_expr(node.left);
	validate_expr(node.right);
	validate_intop(node);
}

fn validate_shiftop(node Ast) {
	validate_expr(node.left);
	validate_expr(node.right);
	if !(node.left.type.kind & TYPE_IS_INTEGER) {
		WarnAt(node, "@ on non-integer").s(ast_kind[node.kind]);
	}
	if !(node.right.type.kind & TYPE_IS_INTEGER) {
		WarnAt(node, "@ by non-integer").s(ast_kind[node.kind]);
	}
}

fn validate_unop(node Ast) {
	validate_expr(node.left);
}

fn validate_bool_binop(node Ast) {
	//TODO: ensure bool-ish?
	validate_expr(node.left);
	validate_expr(node.right);
}

fn validate_bool_unop(node Ast) {
	//TODO: ensure bool-ish?
	validate_expr(node.left);
}

fn validate_cast(node Ast) {
	var kind TypeKind = node.type.kind;

	// TODO: more extensive rules
	// TODO: sign extension, bool conversion, etc
	if kind == TYPE_U32 { return; }
	if kind == TYPE_I32 { return; }
	if kind == TYPE_U8  { return; }

	ErrorAt(node, "cannot cast @ to @").t(node.left.type).t(node.type);
}

fn validate_expr(node Ast) {
	var kind AstKind = node.kind;
	if kind == AST_CONST    { return; }
	if kind == AST_SYMBOL   { return; }
	if kind == AST_EQ       { return validate_relop(node); }
	if kind == AST_NE       { return validate_relop(node); }
	if kind == AST_LT       { return validate_relop(node); }
	if kind == AST_LE       { return validate_relop(node); }
	if kind == AST_GT       { return validate_relop(node); }
	if kind == AST_GE       { return validate_relop(node); }
	if kind == AST_ADD      { return validate_binop(node); }
	if kind == AST_SUB      { return validate_binop(node); }
	if kind == AST_OR       { return validate_binop(node); }
	if kind == AST_XOR      { return validate_binop(node); }
	if kind == AST_MUL      { return validate_binop(node); }
	if kind == AST_DIV      { return validate_binop(node); }
	if kind == AST_MOD      { return validate_binop(node); }
	if kind == AST_AND      { return validate_binop(node); }
	if kind == AST_CLR      { return validate_binop(node); }
	if kind == AST_LSL      { return validate_shiftop(node); }
	if kind == AST_LSR      { return validate_shiftop(node); }
	if kind == AST_NOT      { return validate_unop(node); }
	if kind == AST_NEG      { return validate_unop(node); }
	if kind == AST_BOOL_NOT { return validate_bool_unop(node); }
	if kind == AST_BOOL_AND { return validate_bool_binop(node); }
	if kind == AST_BOOL_OR  { return validate_bool_binop(node); }
	if kind == AST_STRING   { return; }
	if kind == AST_INDEX    { return validate_array_load(node); }
	if kind == AST_FIELD    { return validate_field_load(node); }
	if kind == AST_CALL     { return validate_call(node); }
	if kind == AST_ASSIGN   { return validate_assign(node); }
	if kind == AST_DEREF    { }
	if kind == AST_CAST     { return validate_cast(node); }
	if kind == AST_NEW      { return validate_new(node); }
	ErrorAt(node, "unsupported @ in expr").s(ast_kind[kind]);
}

fn validate_if(node Ast) {
	node = node.left;
	while node != nil {
		if node.kind == AST_ELSE {
			validate_block(node.left);
		} else {
			validate_expr(node.left);
			validate_block(node.right);
		}
		node = node.next;
	}
}

fn validate_while(node Ast) {
	validate_expr(node.left);
	validate_block(node.right);
}

var v_return_type Type;

fn validate_return(node Ast) {
	node.type = v_return_type;
	if node.left {
		validate_expr(node.left);
		if (v_return_type == ctx.type_void) && (node.left.type != ctx.type_void) {
			ErrorAt(node, "void function must not return a value");
		}
	} else {
		if v_return_type != ctx.type_void {
			ErrorAt(node, "return value required");
		}
	}
}

fn validate_block(node Ast) {
	node = node.left;
	while node != nil {
		var kind i32 = node.kind;
		if kind == AST_WHILE {
			validate_while(node);
		} else if kind == AST_BREAK {
			// validated by parser
		} else if kind == AST_CONTINUE {
			// validated by parser
		} else if kind == AST_RETURN {
			validate_return(node);
		} else if kind == AST_IF {
			validate_if(node);
		} else if kind == AST_BLOCK {
			validate_block(node);
		} else if ast_is_expr(kind) {
			validate_expr(node);
		} else {
			ErrorAt(node, "unsupported @ in block").s(ast_kind[kind]);
		}
		node = node.next;
	}
}

fn validate_fn(node Ast) {
	v_return_type = node.sym.type.of;
	//TODO: stash as context for errors
	//Warn("validate_fn '@'").s(node.sym.name.text);
	validate_block(node.left);
}

