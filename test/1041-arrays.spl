
var numbers [8]u8 = { 1, 2, 4, 8, 16, 32, 64, 128 };

var data [8]u8 = { 0x10, 0x20, 0x30, 0x40,
                     0x50, 0x60, 0x70, 0x80 };

fn dump(x [8]u8) {
	var n i32 = 0;
	while (n < 8) {
		_hexout_u(x[n]);
		n++;
	}
}

fn start() i32 {
	var n u32 = 0;
	var m u32 = 0;
	while (n < 8) {
		_hexout_u(numbers[n]);
		m = m + u32(numbers[n]);
		n++;
	}
	_hexout_u(m);
	dump(data);
	return n;
}
