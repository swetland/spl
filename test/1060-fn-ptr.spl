
fn add(a i32, b i32) i32 {
	return a + b;
}

struct Foo {
	i i32,
	f fn(a i32, b i32) i32,
};

fn call(f fn(a i32, b i32) i32, a i32, b i32) i32 {
	return f(a, b);
}

fn start() i32 {
	_hexout_(add(1, 2));

	var f fn(a i32, b i32) i32 = add;
	_hexout_(f(77, 33));

	var foo Foo = new(Foo);
	foo.i = 123;
	foo.f = add;
	_hexout_(foo.f(17, 23));

	_hexout_(call(add, 123, 456));
	return 1;
}
