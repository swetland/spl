
fn add(a i32, b i32) i32 {
	return a + b;
}

struct Foo {
	i i32,
	f fn(a i32, b i32) i32,
};

fn call(f fn(i32, i32) i32, a i32, b i32) i32 {
	return f(a, b);
}

fn nth(a []i32, n i32) i32 {
	return a[n];
}

fn start() i32 {
	var z fn([]i32, i32) i32 = nth;

	_hexout_i(add(1, 2));

	var f fn(a i32, b i32) i32 = add;
	_hexout_i(f(77, 33));

	var foo Foo = new(Foo);
	foo.i = 123;
	foo.f = add;
	_hexout_i(foo.f(17, 23));

	_hexout_i(call(add, 123, 456));
	return 1;
}
