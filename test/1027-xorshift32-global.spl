
// todo: u32 and LSR support

var state u32 = 0xd3f56332;

fn xorshift32() u32 {
	state = state ^ (state << 13);
	state = state ^ ((state >> 17) & 0x7FFF);
	state = state ^ (state << 5);
	return state;
}

fn start() i32 {
	var n i32 = 0;
	while (n < 64) {
		_hexout_u(xorshift32());
		n++;
	}
	return 64;
}
