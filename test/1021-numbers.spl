
fn start() i32 {
	_hexout_u(4294967295); // maxu32
	_hexout_u(2147483648); // highbit
	_hexout_u(0xffffffff); // maxu32
	_hexout_u(0x80000000); // highbit
	_hexout_u(0b11111111111111111111111111111111); // maxu32
	_hexout_u(0b10000000000000000000000000000000); // highbit
        _hexout_i(-1);
	_hexout_i(-2);
	_hexout_i(-2147483648); // minint32
	_hexout_i(2147483647); // maxint32
	_hexout_u(0b10001000101010101100110001010101);
	_hexout_u(2292894805);
	_hexout_u(0x88aacc55);
	_hexout_u('a'); // char consts
	_hexout_u('\t');
	_hexout_u('\n');
	_hexout_u('\r');
	_hexout_u('\\');
	_hexout_u('\'');
	_hexout_u('"');
	_hexout_u('\x42');
	_hexout_u('\xFF');
	_hexout_u('\x80');
	return 0;
}
