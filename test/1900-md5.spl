
struct MD5 {
	icount u32,
	bcount u32,
	hash [4]u32,
	ibuf [64]u8,
	data [16]u32,
	tmp [8]u8,
};

var md5_s [64]u8 = {
	7, 12, 17, 22,  7, 12, 17, 22,  7, 12, 17, 22,  7, 12, 17, 22,
	5,  9, 14, 20,  5,  9, 14, 20,  5,  9, 14, 20,  5,  9, 14, 20,
	4, 11, 16, 23,  4, 11, 16, 23,  4, 11, 16, 23,  4, 11, 16, 23,
	6, 10, 15, 21,  6, 10, 15, 21,  6, 10, 15, 21,  6, 10, 15, 21,
};

var md5_K [64]u32 = {
	0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee,
	0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
	0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be,
	0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
	0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa,
	0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
	0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed,
	0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
	0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c,
	0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
	0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05,
	0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
	0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039,
	0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
	0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1,
	0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391,
};

var md5_pad [120]u8 = { 0x80, };

fn md5_step(m MD5) {
	var A u32 = m.hash[0];
	var B u32 = m.hash[1];
	var C u32 = m.hash[2];
	var D u32 = m.hash[3];
	var M [16]u32 = m.data;
	var K [64]u32 = md5_K;
	var s [64]u8 = md5_s;
	var F u32;
	var g u32;

	var i u32 = 0;
	while i < 64 {
		if i < 16 {
			F = (B & C) | ((^B) & D);
			g = i;
		} else if i < 32 {
			F = (D & B) | ((^D) & C);
			g = 5 * i + 1;
		} else if i < 48 {
			F = B ^ C ^ D;
			g = 3 * i + 5;
		} else {
			F = C ^ (B | (^D));
			g = 7 * i;
		}
		F = F + A + K[i] + M[g & 15];
		A = D;
		D = C;
		C = B;
		B = B + ((F << s[i]) | (F >> (32 - s[i]))); // B + LeftRotate(F, s[i]);
		i++;
	}
	m.hash[0] += A;
	m.hash[1] += B;
	m.hash[2] += C;
	m.hash[3] += D;
	m.bcount += 64;
}

fn md5_init(m MD5) {
	m.icount = 0;
	m.bcount = 0;
	m.hash[0] = 0x67452301;
	m.hash[1] = 0xefcdab89;
	m.hash[2] = 0x98badcfe;
	m.hash[3] = 0x10325476;
}

fn md5_sum(m MD5, idata []u8, len u32) {
	// pick up from current state
	var i u32 = m.icount;
	var ibuf [64]u8 = m.ibuf;
	var data [16]u32 = m.data;

	// accumulate data into 64 byte chunks
	var j u32 = 0;
	while j < len {
		ibuf[i] = idata[j];
		if i == 63 {
			var k u32 = 0;
			while k < 16 {
				data[k] =
				(ibuf[k << 2 + 0]) |
				(ibuf[k << 2 + 1] << 8) |
				(ibuf[k << 2 + 2] << 16) |
				(ibuf[k << 2 + 3] << 24);
				k++;
			}
			md5_step(m);
			i = 0;
		} else {
			i++;
		}
		j++;
	}

	m.icount = i;
}

fn md5_fini(m MD5) {
	// message size in bits
	var bits u32 = (m.bcount + m.icount) * 8;

	// pad message up to a length mod 56
	if m.icount < 56 {
		md5_sum(m, md5_pad, 56 - m.icount);
	} else {
		md5_sum(m, md5_pad, (64u + 56u) - m.icount);
	}

	// conclude padding with the count
	m.tmp[0] = bits;
	m.tmp[1] = bits >> 8;
	m.tmp[2] = bits >> 16;
	m.tmp[3] = bits >> 24;
	m.tmp[4] = 0;
	m.tmp[5] = 0;
	m.tmp[6] = 0;
	m.tmp[7] = 0;

	var tmp [8]u8 = m.tmp; // TODO: handle deref in args
	md5_sum(m, tmp, 8);
}

var ptn str = "XXXXXXXXYYYYYYYYZZZZZZZZWWWWWWWWXXXXXXXXYYYYYYYYZZZZZZZZWWWWWWWW";

fn md5_pattern(m MD5, i u32) {
	md5_init(m);
	while i > 64 {
		md5_sum(m, ptn, 64);
		i -= 64;
	}
	md5_sum(m, ptn, i);
	md5_fini(m);
	_hexout_(m.hash[0]);
	_hexout_(m.hash[1]);
	_hexout_(m.hash[2]);
	_hexout_(m.hash[3]);
}

fn start() i32 {
	var m MD5 = new(MD5);

	md5_init(m);
	md5_sum(m, "The quick brown fox jumps over the lazy dog", 43);
	md5_fini(m);
	_hexout_(m.hash[0]);
	_hexout_(m.hash[1]);
	_hexout_(m.hash[2]);
	_hexout_(m.hash[3]);

	md5_pattern(m, 64);
	md5_pattern(m, 128);
	md5_pattern(m, 225);

	return 0;
}
