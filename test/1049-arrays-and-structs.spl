

struct Stuff {
	a u32,
	b u32,
};

var z [5]Stuff;

fn start() i32 {
	var w [5]Stuff = new([5]Stuff);
	z[0].a = 0x42;
	z[0].b = 0x23;
	z[2].a = 1;
	z[2].b = 2;
	z[4].b = 7;
	var i u32 = 0;
	while i < 5 {
		w[i].a = z[i].a;
		w[i].b = z[i].b;
		i++;
	}

	var q [3]*Stuff = new([3]*Stuff);
	i = 0;
	while i < 3 {
		q[i] = new(Stuff);
		q[i].a = 1u << i;
		q[i].b = 3 - i;
		i++;
	}
	return 0;
}
