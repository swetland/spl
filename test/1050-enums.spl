
var i i32 = 3;

enum E1 i32 { ZERO, ONE, TWO, };

enum E2 i32 { A = 5, B = 6, C = 0x10000000, D = 0x10000001, E = 50 + 50, F = ONE * TWO, };

fn start() i32 {
	_hexout_i(ZERO);
	_hexout_i(ONE);
	_hexout_i(TWO);
	_hexout_i(A);
	_hexout_i(B);
	_hexout_i(C);
	_hexout_i(D);
	_hexout_i(E);
	_hexout_i(F);
        return 0;
}

