
fn is_three(n i32) i32 {
	_hexout_i(0x333);
	return n == 3;
}
fn is_six(n i32) i32 {
	_hexout_i(0x666);
	return n == 6;
}
fn is_nine(n i32) i32 {
	_hexout_i(0x999);
	return n == 9;
}

fn or_test2(n i32) {
	if (is_three(n) || is_six(n) || is_nine(n)) {
		_hexout_i(n | 0x1100);
	} else {
		_hexout_i(n | 0x2200);
	}
}

fn or_test(n i32) {
	if (n == 3 || n == 6 || n == 9) {
		_hexout_i(n | 0x100);
	} else {
		_hexout_i(n | 0x200);
	}
}
fn and_test(n i32) {
	if ((n & 1 == 1) && (n & 2 == 2) && (n < 8)) {
		_hexout_i(n | 0x300);
	} else {
		_hexout_i(n | 0x400);
	}
}

fn start() i32 {
	var n i32 = 0;
	while n < 10 {
		or_test(n);
		n = n + 1;
	}
	n = 0;
	while n < 10 {
		or_test2(n);
		n = n + 1;
	}
	n = 0;
	while n < 16 {
		and_test(n);
		n = n + 1;
	}
	_hexout_i(i32(!true));
	_hexout_i(i32(!false));
	_hexout_i(i32(!42));
	return 0x42;
}

