
// todo: u32 and LSR support

fn xorshift32(state u32) u32 {
	state = state ^ (state << 13);
	state = state ^ ((state >> 17) & 0x7FFF);
	state = state ^ (state << 5);
	return state;
}

fn start() i32 {
	var state u32 = 0xd3f56332;
	var n i32 = 0;
	while (n < 64) {
		state = xorshift32(state);
		_hexout_(state);
		n++;
	}
	return 64;
}
